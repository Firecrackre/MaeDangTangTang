@Logic
script FinanceManager extends Logic
    -- 뒷골목 대장장이 — 재정 관리(대출 서비스 센터) 페이지(클라 전용 표시/입력).
    -- 진입: HUD 대출 유도 팝업 클릭 또는 로비 '재정 관리' 버튼 → Open(). 종료: X 버튼/대출 성공 → Close().
    --   화면 상태 SSOT는 LobbyManager.ActiveScreen. 여기서 "finance"로 바꿔 페이지를 노출하고, 복귀 시 이전 화면으로 되돌린다.
    --   모든 재화/대출 연산은 서버 권위(_GameManager:RequestLoan). 여기서는 표시·입력·연출만 담당한다.
    -- @Logic 이유: _FinanceManager로 전역 접근(Hud/Lobby가 Open 호출) + FinanceGroup엔 in-group @Component가 없어
    --   루트 Enable 게이팅이 안전(HudManager/LobbyManager와 동일 패턴).

    property string TargetMapName = "InGameMap"
    -- 진입 직전 화면(복귀용). 상점/스크래치 어디서 왔든 그 화면으로 되돌린다.
    property string prevScreen = "lobby"

    -- UI 참조(UUID는 UIBuilder write({bind})로 주입).
    property Entity financeRoot = "9ae6a597-bb1e-4f09-b9dc-81ee1531d44f"    -- FinanceGroup 루트(맵/화면 게이팅)
    property Entity board = "50d6e2d0-f8f6-4f15-b85a-203d6c947cc7"          -- 대출 서비스 센터 보드(잠금 클릭 시 흔들림 대상)
    property ButtonComponent btnClose = "d10ff8fe-e782-432c-87c0-27beb1d8356e" -- 우상단 X 닫기
    property ButtonComponent btnLoan = "4b2e44ea-5576-4dae-8275-7771b838b65e"  -- 대출하기(경고 팝업 오픈)
    property Entity lockOverlay = "2c956851-a98d-4ad7-ae01-ab606876f919"     -- 대출하기 위 잠금 덮개(횟수 소진 시)
    property ButtonComponent lockBtn = "1608ef13-44ed-4e37-8696-c41fcb9d6bbe"  -- 잠금 덮개 클릭 수신(흔들림+에러음)
    property Entity confirmGroup = "79e2e076-acd3-41ee-bcc8-074fdf588023"    -- 경고 확인 팝업(대출받기/취소)
    property ButtonComponent btnLoanA = "57d0e4df-849b-4018-abff-7b03d5f0b3fa" -- 대출받기(확정)
    property ButtonComponent btnLoanB = "52622a91-a1b2-4e20-b5b0-056b3ce76dfc" -- 취소(팝업만 닫음)
    property TextComponent infoPayoutText = "3d757be8-295b-48f5-a6ee-0c449b949033" -- 대출 지급액
    property TextComponent infoDebtText = "93153732-1340-4470-8fcd-b0e5c7377d67"   -- 갚아야 할 빚
    property TextComponent infoUsesText = "ba11fc43-a502-4bb8-9337-d40e89beb842"   -- 남은 대출 횟수
    property SpriteGUIRendererComponent npcSprite = "35fccbeb-5531-4120-9b5f-546fe3ae3342" -- 노인 NPC(런타임 thumbnail:// 설정)

    -- 사운드(docs/specs/soundlist.md).
    property string clickSoundRUID = "b2b0b752bf914fb5abd885470c84c8fc"   -- UI_Click_Default: 대출하기(팝업 열기)
    property string lightSoundRUID = "0868b0f43f1949c1ace06ae4fa33ee55"   -- UI_Click_Light: 닫기/취소
    property string confirmSoundRUID = "69f85d65004541db82615459032e1d4a" -- UI_Click_Confirm: 대출 실행 확정
    property string errorSoundRUID = "174d501eccd04eadbd6c6411d4ade7e7"   -- 잠금(대출 소진) 오류음(msw-search)
    property number sfxVolume = 1.0

    -- 내부 상태.
    property Vector2 boardBasePos = Vector2(0, 0)
    property number shakeTime = 0
    property integer lastLoanCount = 0
    property string lastInfoKey = ""
    property any closeHandler = nil
    property any loanHandler = nil
    property any lockHandler = nil
    property any confirmAHandler = nil
    property any confirmBHandler = nil

    @ExecSpace("ClientOnly")
    method void OnBeginPlay()
        -- 게이팅 초기화 + 정적 텍스트 세팅 + 버튼 연결.
        self.prevScreen = "lobby"
        self.shakeTime = 0
        self.lastLoanCount = _GameManager.LoanUseCount
        if isvalid(self.board) and isvalid(self.board.UITransformComponent) then
            self.boardBasePos = self.board.UITransformComponent.anchoredPosition
        end
        if isvalid(self.financeRoot) then self.financeRoot.Enable = false end
        if isvalid(self.confirmGroup) then self.confirmGroup.Enable = false end
        if isvalid(self.lockOverlay) then self.lockOverlay.Enable = false end

        -- 대출 지급액/빚은 현재 상환 필요 메소에 동적 연동 → 정적 텍스트 대신 RefreshInfo가 매 프레임 갱신.

        -- 노인 NPC 썸네일: animationclip을 정적 이미지로 표시(런타임 thumbnail:// 설정 — WeaponShopManager 관례).
        if isvalid(self.npcSprite) then
            self.npcSprite.ImageRUID = "thumbnail://a2144125efd64414be83bac6ad84e5ab"
        end

        if isvalid(self.btnClose) then
            self.closeHandler = self.btnClose.Entity:ConnectEvent(ButtonClickEvent, self.OnCloseClicked)
        end
        if isvalid(self.btnLoan) then
            self.loanHandler = self.btnLoan.Entity:ConnectEvent(ButtonClickEvent, self.OnLoanClicked)
        end
        if isvalid(self.lockBtn) then
            self.lockHandler = self.lockBtn.Entity:ConnectEvent(ButtonClickEvent, self.OnLockClicked)
        end
        if isvalid(self.btnLoanA) then
            self.confirmAHandler = self.btnLoanA.Entity:ConnectEvent(ButtonClickEvent, self.OnConfirmLoan)
        end
        if isvalid(self.btnLoanB) then
            -- btnLoanB = '취소' 버튼: 대출 확정이 아니라 확인 팝업만 닫는다.
            self.confirmBHandler = self.btnLoanB.Entity:ConnectEvent(ButtonClickEvent, self.OnCancelConfirm)
        end
        log("[FinanceManager] ready")
    end

    @ExecSpace("ClientOnly")
    method void OnEndPlay()
        -- 연결한 이벤트 해제(필수).
        if self.closeHandler ~= nil and isvalid(self.btnClose) then
            self.btnClose.Entity:DisconnectEvent(ButtonClickEvent, self.closeHandler)
        end
        if self.loanHandler ~= nil and isvalid(self.btnLoan) then
            self.btnLoan.Entity:DisconnectEvent(ButtonClickEvent, self.loanHandler)
        end
        if self.lockHandler ~= nil and isvalid(self.lockBtn) then
            self.lockBtn.Entity:DisconnectEvent(ButtonClickEvent, self.lockHandler)
        end
        if self.confirmAHandler ~= nil and isvalid(self.btnLoanA) then
            self.btnLoanA.Entity:DisconnectEvent(ButtonClickEvent, self.confirmAHandler)
        end
        if self.confirmBHandler ~= nil and isvalid(self.btnLoanB) then
            self.btnLoanB.Entity:DisconnectEvent(ButtonClickEvent, self.confirmBHandler)
        end
    end

    @ExecSpace("ClientOnly")
    method void Open()
        -- 재정 관리 페이지 진입: 이전 화면 저장 → ActiveScreen="finance"로 전환(서버 상태도 정합).
        if _GameManager.IsGameOver then return end
        local screen = isvalid(_LobbyManager) and _LobbyManager.ActiveScreen or "lobby"
        if screen ~= "finance" then self.prevScreen = screen end
        if isvalid(_LobbyManager) then _LobbyManager.ActiveScreen = "finance" end
        _GameManager:EnterActivity("finance")
        self.lastLoanCount = _GameManager.LoanUseCount
        self.shakeTime = 0
        if isvalid(self.confirmGroup) then self.confirmGroup.Enable = false end
        log("[FinanceManager] open (prevScreen=" .. self.prevScreen .. ")")
    end

    @ExecSpace("ClientOnly")
    method void Close()
        -- 페이지 종료: 이전 화면으로 복귀 + 서버 로비 복귀. 확인 팝업/흔들림 정리.
        if isvalid(_LobbyManager) then _LobbyManager.ActiveScreen = self.prevScreen end
        _GameManager:ReturnToLobby()
        if isvalid(self.confirmGroup) then self.confirmGroup.Enable = false end
        self.shakeTime = 0
        if isvalid(self.board) and isvalid(self.board.UITransformComponent) then
            self.board.UITransformComponent.anchoredPosition = self.boardBasePos
        end
        log("[FinanceManager] close -> " .. self.prevScreen)
    end

    @ExecSpace("ClientOnly")
    method void OnUpdate(number delta)
        -- 화면 게이팅: InGameMap + ActiveScreen=="finance"일 때만 페이지 표시.
        local lp = _UserService.LocalPlayer
        local onMap = isvalid(lp) and lp.CurrentMapName == self.TargetMapName
        local screen = isvalid(_LobbyManager) and _LobbyManager.ActiveScreen or "lobby"
        local show = onMap and (screen == "finance")
        if isvalid(self.financeRoot) then self.financeRoot.Enable = show end
        if not show then return end

        -- 대출 성공 감지(LoanUseCount 증가) → 자동 닫기(지급 후 복귀). (finance §4-8)
        if _GameManager.LoanUseCount > self.lastLoanCount then
            self.lastLoanCount = _GameManager.LoanUseCount
            self:Close()
            return
        end

        self:RefreshInfo()

        -- 잠금 클릭 시 보드 부들부들(0.5초).
        if self.shakeTime > 0 then
            self.shakeTime = self.shakeTime - delta
            if isvalid(self.board) and isvalid(self.board.UITransformComponent) then
                if self.shakeTime > 0 then
                    local jx = (_UtilLogic:RandomDouble() - 0.5) * 20
                    local jy = (_UtilLogic:RandomDouble() - 0.5) * 10
                    self.board.UITransformComponent.anchoredPosition =
                        Vector2(self.boardBasePos.x + jx, self.boardBasePos.y + jy)
                else
                    self.board.UITransformComponent.anchoredPosition = self.boardBasePos
                end
            end
        end
    end

    @ExecSpace("ClientOnly")
    method void RefreshInfo()
        -- 대출 정보(지급액·늘어나는 빚·남은 횟수) 갱신 + 잠금 오버레이 게이팅. 값 변화 시에만 텍스트 갱신.
        --   지급액·빚은 현재 상환 필요 메소에 동적 연동(GetCurrentRepayment): 받는 만큼 빚도 늘어난다.
        local loan = _BlacksmithConfig:GetLoanConfig()
        local remaining = loan.maxUses - _GameManager.LoanUseCount
        if remaining < 0 then remaining = 0 end
        local amount = _GameManager:GetCurrentRepayment()
        local key = tostring(remaining) .. "|" .. tostring(amount)
        if key ~= self.lastInfoKey then
            self.lastInfoKey = key
            if isvalid(self.infoPayoutText) then
                self.infoPayoutText.Text = "대출 지급액: " .. self:Comma(amount) .. " Meso"
            end
            if isvalid(self.infoDebtText) then
                self.infoDebtText.Text = "늘어나는 빚: " .. self:Comma(amount) .. " Meso"
            end
            if isvalid(self.infoUsesText) then
                self.infoUsesText.Text = "남은 대출 횟수: " .. tostring(remaining) .. "회"
            end
        end
        -- 대출 횟수 소진 시 대출하기 버튼 위를 잠금 덮개로 가린다(글자는 반투명 아래로 비침).
        if isvalid(self.lockOverlay) then
            self.lockOverlay.Enable = _GameManager.LoanUseCount >= loan.maxUses
        end
    end

    @ExecSpace("ClientOnly")
    method void OnCloseClicked()
        -- X 버튼 → 페이지 닫기.
        _SoundService:PlaySound(self.lightSoundRUID, self.sfxVolume)
        self:Close()
    end

    @ExecSpace("ClientOnly")
    method void OnLoanClicked()
        -- 대출하기 → 경고 확인 팝업 표시(대출받기 x2). (finance §5)
        _SoundService:PlaySound(self.clickSoundRUID, self.sfxVolume)
        if isvalid(self.confirmGroup) then self.confirmGroup.Enable = true end
    end

    @ExecSpace("ClientOnly")
    method void OnConfirmLoan()
        -- 대출받기(A/B 공통) → 서버 대출 요청. 성공(LoanUseCount 증가)은 OnUpdate가 감지해 자동으로 닫는다.
        _SoundService:PlaySound(self.confirmSoundRUID, self.sfxVolume)
        if isvalid(self.confirmGroup) then self.confirmGroup.Enable = false end
        _GameManager:RequestLoan()
    end

    @ExecSpace("ClientOnly")
    method void OnCancelConfirm()
        -- 취소 → 확인 팝업만 닫는다(대출 실행 안 함). 재정 페이지는 그대로 유지.
        _SoundService:PlaySound(self.lightSoundRUID, self.sfxVolume)
        if isvalid(self.confirmGroup) then self.confirmGroup.Enable = false end
    end

    @ExecSpace("ClientOnly")
    method void OnLockClicked()
        -- 잠금(대출 횟수 소진) 클릭: 에러음 + 보드 흔들림만. 대출은 실행되지 않는다.
        --   (큐브 스크래치 화면에서 여기까지 오면 아무것도 못 하는 soft lock → 추후 게임오버 연결.)
        _SoundService:PlaySound(self.errorSoundRUID, self.sfxVolume)
        self.shakeTime = 0.5
        log("[FinanceManager] loan LOCKED (uses exhausted) - shake + error sfx")
    end

    method string Comma(integer n)
        -- 천 단위 콤마 문자열.
        local s = tostring(n)
        local out = ""
        local cnt = 0
        for i = #s, 1, -1 do
            out = string.sub(s, i, i) .. out
            cnt = cnt + 1
            if cnt % 3 == 0 and i > 1 then out = "," .. out end
        end
        return out
    end
end
