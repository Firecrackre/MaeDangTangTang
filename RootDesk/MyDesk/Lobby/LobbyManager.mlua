@Logic
script LobbyManager extends Logic
    -- 뒷골목 대장장이 — InGameMap 로비 허브(클라 전용 표시/입력).
    -- 역할: InGameMap에서 "지금 어떤 화면인가"(ActiveScreen)를 소유하는 SSOT + 3버튼 허브 표시/입력.
    --   좌/우상단 HUD(라디얼 시계·메소 박스)는 WeaponShopManager의 RoundTimer/Hud를 로비·상점 공용으로 재사용한다(여기서 안 그림).
    --   ActiveScreen: "lobby"(허브) / "shop"(무기 상점). WeaponShopManager가 이 값을 읽어 상점 노출을 게이팅한다.
    -- @Logic인 이유: _LobbyManager로 전역 접근 가능해야 WeaponShopManager(@Component)가 상태를 읽을 수 있기 때문.
    --   (ClickOnlyController 선례처럼, @Logic이 UI 엔티티 참조를 들고 버튼을 ConnectEvent한다.)
    -- 결과 연산(메소/상환 등)은 전부 서버 권위(_GameManager). 여기서는 표시와 화면 전환 입력만 담당한다.

    property string TargetMapName = "InGameMap"

    -- 화면 상태(클라 로컬). WeaponShopManager가 읽는다.
    property string ActiveScreen = "lobby"

    -- UI 참조(UUID는 UIBuilder write({bind})로 주입).
    property Entity lobbyRoot = "aff6b600-be5d-45a0-ba7f-ebeedba71cdb"          -- 로비 허브 그룹 루트(맵 게이팅 시 Enable 토글 대상)
    -- ⚠ WeaponShopGroup / ScratchTicketGroup 루트는 여기서 게이팅하지 않는다.
    --   그 그룹들은 안에 @Component(WeaponShopManager/ScratchTicketManager)를 품고 있어서,
    --   그룹 루트를 끄면 해당 컴포넌트의 OnBeginPlay/OnUpdate 라이프사이클이 (경합적으로) 영구 정지된다
    --   → 슬롯 렌더가 아예 안 돎(빈 상점) 실측 확인. 그래서 그 그룹들은 항상 켜 두고,
    --   각 매니저가 자기 "자식"만 게이팅한다(board/hud/timer 등). LobbyGroup은 in-group 컴포넌트가 없어 안전.
    property ButtonComponent btnSkill = "ec5e2de3-801a-490a-8820-9d37674ceb75"   -- 대장 기술 업그레이드(준비 중)
    property ButtonComponent btnCube = "42ab2378-46ed-4abd-8ab1-c2a2653a6cd3"    -- 큐브 스크래치 → 상점 열기
    property ButtonComponent btnFinance = "6072d905-8310-4e23-8f6e-522bcf4fb0c6" -- 재정 관리(준비 중)
    -- 상단 HUD(좌 라디얼 시계·우 메소 박스)는 전용 HudGroup + HudManager가 전담(로비 고유 HUD 박스는 제거됨).
    property Entity toast = "63c0291c-87d6-4663-945b-643c5f71243d"                -- "준비 중" 토스트 루트
    property TextComponent toastText = "d31e443b-2f47-493e-a4ef-e2e0130706d3"     -- 토스트 텍스트

    -- 아이콘 부유 연출(메이플 드랍 아이템풍 둥실둥실) — 버튼 자식 Icon* 3개의 UITransform
    property UITransformComponent iconSkillTf = "9c98e9af-38ad-40f3-a2fd-3aa080494906"   -- BtnSkill/IconSkill
    property UITransformComponent iconCubeTf = "b0009824-c26c-4ec1-bb5a-9799e43212a8"    -- BtnCube/IconCube
    property UITransformComponent iconFinanceTf = "34ee119a-9a6e-4e13-a6d6-7c209b94bc26" -- BtnFinance/IconFinance

    -- 부유 튜닝값(인스펙터 SSOT)
    property number bobAmplitude = 8      -- 위아래 진폭(px, 1920 기준)
    property number bobPeriod = 2.8       -- 1회 왕복 주기(초)
    property number bobPhaseGap = 2.094   -- 아이콘 간 위상차(rad, ≈2π/3) — 셋이 엇박으로 움직이게
    property number bobEase = 0.65        -- 극점 체류 곡선(1=순수 사인, 작을수록 최고/최저점에서 더 오래 머묾)

    -- 내부 상태.
    property boolean isActive = false      -- 허브(lobbyRoot) 표시 여부 변화감지
    property number toastTimer = 0
    property any skillHandler = nil
    property any cubeHandler = nil
    property any financeHandler = nil
    property number bobTime = 0            -- 부유 연출 경과 시간
    property boolean bobLogged = false     -- 부유 첫 적용 1회 로그(검증용)
    property any iconTfs = nil             -- 부유 대상 UITransform 배열
    property any iconBaseX = nil           -- 아이콘별 기준 anchoredPosition.x (IconCube는 x=63 — 보존 필수)
    property any iconBaseY = nil           -- 아이콘별 기준 anchoredPosition.y

    -- 버튼 단계 공개(1주차 BtnCube만 → 2주차 BtnSkill 등장 → 대출 팝업 뜨면 BtnFinance 등장).
    -- 등장 연출 튜닝값(인스펙터 SSOT): 원위치보다 introOffsetY만큼 아래에서 시작해 introDuration 동안 올라오며 alpha 0→1.
    property number introOffsetY = 40      -- 원위치 아래 시작 오프셋(px, 버튼 높이 대비 살짝)
    property number introDuration = 0.3    -- 슬라이드+페이드 지속(초, 빠르게)

    -- 공개 상태: "hidden"(숨김) / "intro"(등장 연출 중) / "shown"(상시 표시).
    property string skillReveal = "hidden"
    property string financeReveal = "hidden"
    property number skillIntroTime = 0     -- BtnSkill intro 경과 시간
    property number financeIntroTime = 0   -- BtnFinance intro 경과 시간
    property boolean skillIntroPending = false    -- DebtStage 0→1 에지 관측 → 정산 연출 종료(IsBusy=false) 대기
    property boolean financeIntroPending = false  -- 대출 필요 관측 → 로비 복귀(showHub) 대기
    property boolean financeLatch = false         -- 재정 버튼 세션 내 유지 래치(WantLoanPopup 한 번 true면 계속)

    -- 에지 감지용 이전값.
    property integer prevDebtStage = -1    -- -1 = 미관측 센티널(첫 관측은 무연출 스냅)
    property boolean prevGameOver = false

    -- 버튼 본체(Btn*) 기준 anchoredPosition — OnBeginPlay 캡처(아이콘 base와 별개).
    property number btnSkillBaseX = 0
    property number btnSkillBaseY = 0
    property number btnFinanceBaseX = 0
    property number btnFinanceBaseY = 0

    @ExecSpace("ClientOnly")
    method void OnBeginPlay()
        -- 게이팅 초기화: 시작 시 로비 루트를 명시적으로 끈다(변화감지 가드가 초기 상태를 못 잡는 gotcha 회피).
        self.ActiveScreen = "lobby"
        self.isActive = false
        self.toastTimer = 0
        if isvalid(self.lobbyRoot) then
            self.lobbyRoot.Enable = false   -- LobbyGroup엔 in-group @Component가 없어 OnBeginPlay에서 꺼도 안전
        end
        if isvalid(self.toast) then
            self.toast.Enable = false
        end

        -- 3버튼 클릭 연결(ConnectEvent는 Entity에서 호출한다 — Component 아님).
        if isvalid(self.btnCube) then
            self.cubeHandler = self.btnCube.Entity:ConnectEvent(ButtonClickEvent, self.OnCubeClicked)
        end
        if isvalid(self.btnSkill) then
            self.skillHandler = self.btnSkill.Entity:ConnectEvent(ButtonClickEvent, self.OnSkillClicked)
        end
        if isvalid(self.btnFinance) then
            self.financeHandler = self.btnFinance.Entity:ConnectEvent(ButtonClickEvent, self.OnFinanceClicked)
        end

        -- 아이콘 부유 기준 좌표 캡처(.ui 저작 위치가 기준점 — 이후 사인파는 이 기준에서만 흔든다).
        self.bobTime = 0
        self.iconTfs = { self.iconSkillTf, self.iconCubeTf, self.iconFinanceTf }
        self.iconBaseX = {}
        self.iconBaseY = {}
        local captured = 0
        for i, tf in ipairs(self.iconTfs) do
            if isvalid(tf) then
                self.iconBaseX[i] = tf.anchoredPosition.x
                self.iconBaseY[i] = tf.anchoredPosition.y
                captured = captured + 1
            end
        end
        log("[LobbyManager] icon bob ready. base captured=" .. tostring(captured))

        -- 버튼 단계 공개 초기화: 1주차는 큐브만 보이고, 스킬/재정 버튼은 숨긴 상태에서 시작.
        --   버튼 본체(Btn*)의 저작 위치를 등장 연출의 기준점으로 캡처한다.
        if isvalid(self.btnSkill) and isvalid(self.btnSkill.Entity.UITransformComponent) then
            local ap = self.btnSkill.Entity.UITransformComponent.anchoredPosition
            self.btnSkillBaseX = ap.x
            self.btnSkillBaseY = ap.y
            self.btnSkill.Entity.Enable = false
        end
        if isvalid(self.btnFinance) and isvalid(self.btnFinance.Entity.UITransformComponent) then
            local ap = self.btnFinance.Entity.UITransformComponent.anchoredPosition
            self.btnFinanceBaseX = ap.x
            self.btnFinanceBaseY = ap.y
            self.btnFinance.Entity.Enable = false
        end
        self.skillReveal = "hidden"
        self.financeReveal = "hidden"
        self.skillIntroTime = 0
        self.financeIntroTime = 0
        self.skillIntroPending = false
        self.financeIntroPending = false
        self.financeLatch = false
        self.prevDebtStage = -1
        self.prevGameOver = false

        log("[LobbyManager] ready. screen=" .. self.ActiveScreen)
    end

    @ExecSpace("ClientOnly")
    method void OnEndPlay()
        -- 연결한 이벤트 해제(필수).
        if self.cubeHandler ~= nil and isvalid(self.btnCube) then
            self.btnCube.Entity:DisconnectEvent(ButtonClickEvent, self.cubeHandler)
        end
        if self.skillHandler ~= nil and isvalid(self.btnSkill) then
            self.btnSkill.Entity:DisconnectEvent(ButtonClickEvent, self.skillHandler)
        end
        if self.financeHandler ~= nil and isvalid(self.btnFinance) then
            self.btnFinance.Entity:DisconnectEvent(ButtonClickEvent, self.financeHandler)
        end
    end

    @ExecSpace("ClientOnly")
    method void OnUpdate(number delta)
        -- 로비 허브(lobbyRoot)만 게이팅한다. 상점/스크래치는 각 매니저가 자기 자식을 게이팅한다(위 프로퍼티 주석 참조).
        -- 허브 표시 조건: InGameMap이면서, 화면 상태가 로비이고, 아이템 미보유(큐브 진행중이 아님)일 때.
        --   큐브 스크래치를 누르면 ActiveScreen="shop"이 되어 허브가 숨고 WeaponShopManager가 상점을 노출한다.
        local lp = _UserService.LocalPlayer
        local onMap = isvalid(lp) and lp.CurrentMapName == self.TargetMapName
        local showHub = onMap and self.ActiveScreen == "lobby" and (_GameManager.CurrentItemId == "")

        -- 매 프레임 idempotent 적용(변화감지 가드 없음 — 초기 프레임/경합 안전).
        self.isActive = showHub
        if isvalid(self.lobbyRoot) then self.lobbyRoot.Enable = showHub end

        -- 버튼 단계 공개: 상점/스크래치 화면에서도 에지·래치를 놓치지 않도록 early return 앞에서 매 프레임 실행.
        self:UpdateButtonReveal(delta, showHub)

        -- 아래는 허브 전용(토스트) — 허브가 아닐 땐 건너뛴다.
        -- (상단 HUD는 WeaponShopManager의 공용 RoundTimer/Hud가 담당 — 여기선 더 이상 그리지 않는다.)
        if not showHub then return end

        -- 아이콘 둥실 연출(메이플 드랍 아이템풍): y = baseY + A·sin(2π t/T + i·위상차).
        -- 히트 판정은 부모 Btn*의 ButtonComponent 기준이라 아이콘 이동이 클릭에 영향 없음.
        self.bobTime = self.bobTime + delta
        local w = 2 * math.pi / self.bobPeriod
        for i, tf in ipairs(self.iconTfs) do
            if isvalid(tf) and self.iconBaseY[i] ~= nil then
                -- |s|^ease 셰이핑: ease<1이면 중간 구간은 빠르게 지나고 최고/최저점에서 더 오래 머묾.
                local s = math.sin(self.bobTime * w + (i - 1) * self.bobPhaseGap)
                local shaped = 0
                if s >= 0 then
                    shaped = s ^ self.bobEase
                else
                    shaped = -((-s) ^ self.bobEase)
                end
                tf.anchoredPosition = Vector2(self.iconBaseX[i], self.iconBaseY[i] + self.bobAmplitude * shaped)
                if not self.bobLogged then
                    self.bobLogged = true
                    log("[LobbyManager] icon bob active. amp=" .. tostring(self.bobAmplitude) .. " period=" .. tostring(self.bobPeriod))
                end
            end
        end

        -- 토스트 타이머(준비 중 안내).
        if self.toastTimer > 0 then
            self.toastTimer = self.toastTimer - delta
            if self.toastTimer <= 0 and isvalid(self.toast) then
                self.toast.Enable = false
            end
        end
    end

    @ExecSpace("ClientOnly")
    method void UpdateButtonReveal(number delta, boolean showHub)
        -- 버튼 단계 공개의 감지/래치/트리거/적용을 한곳에서 처리(OnUpdate 폴링·멱등).
        -- [A] 감지·래치 (화면과 무관하게 매 프레임):
        local stage = _GameManager.DebtStage
        local gameOver = _GameManager.IsGameOver

        -- 1) 재시작 감지 → 전체 리셋.
        --    DebtStage 하강(정산 단계 되돌림) 또는 게임오버 해제 하강 에지 = RequestRestart로 새 판 시작.
        --    (1주차 게임오버는 DebtStage 0→0이라 하강 에지가 없으므로 IsGameOver 하강 에지가 그 구멍을 막는다.)
        local didReset = false
        if (self.prevDebtStage >= 0 and stage < self.prevDebtStage) or (self.prevGameOver and not gameOver) then
            self:ResetButtonReveal()
            didReset = true
        end
        self.prevGameOver = gameOver

        -- 2) 주차 에지 → BtnSkill 등장 예약.
        if self.prevDebtStage == -1 then
            -- 첫 관측: 이미 2주차 이상(재접속/중간 관측)이면 무연출로 바로 표시.
            if stage >= 1 and self.skillReveal == "hidden" then
                self.skillReveal = "shown"
            end
        elseif self.prevDebtStage == 0 and stage >= 1 and self.skillReveal == "hidden" then
            -- 1→2주차 전환 에지: 정산 연출 종료 후 등장 연출.
            self.skillIntroPending = true
        elseif stage >= 1 and self.skillReveal == "hidden" and not self.skillIntroPending then
            -- 안전망: 어떤 경로로든 에지를 놓쳐도 2주차 이상이면 버튼이 영영 안 나오지 않게 표시.
            self.skillReveal = "shown"
        end
        self.prevDebtStage = stage

        -- 3) 재정 래치: 대출이 실제로 필요한 상황(WantLoanPopup)이 상점/스크래치에서 한 번이라도 발생하면 세션 유지.
        --    ⚠ loanPopupActive(슬라이드 애니 상태)는 게임오버 후 팝업이 퇴장 슬라이드하는 동안에도 true라,
        --      재시작 리셋 직후 이를 보고 즉시 재무장돼 재정 버튼이 안 사라지는 버그가 있었다.
        --      → 의미 상태 WantLoanPopup(지금 대출이 필요한가)로 판정한다. 재시작 프레임엔 ActiveScreen=="lobby"라 false.
        --      didReset: 리셋한 바로 그 프레임엔 검사 스킵(파셜 sync 등 이례적 순서 보험). not IsGameOver: 죽는 연출 중 무장 금지.
        if not self.financeLatch and not didReset and not gameOver
           and isvalid(_HudManager) and _HudManager:WantLoanPopup() then
            self.financeLatch = true
            self.financeIntroPending = true
            log("[LobbyManager] finance latch set (loan needed)")
        end

        -- [B] 연출 트리거: 정산 팝업이 닫혀(IsBusy=false) 로비가 보이는 프레임에만 등장 시작.
        --    not gameOver: 게임오버 중엔 등장 금지 — 재시작 순간(화면=lobby지만 IsGameOver가 아직 true·pending 잔존)에
        --    리셋 직전 1프레임 인트로가 튀는 것을 막는다(리셋이 pending을 정리한 뒤엔 로비라 WantLoanPopup=false로 재무장도 없음).
        local nwBusy = isvalid(_NextWeekManager) and _NextWeekManager:IsBusy()
        if showHub and not nwBusy and not gameOver then
            if self.skillIntroPending then
                self.skillIntroPending = false
                self.skillReveal = "intro"
                self.skillIntroTime = 0
                log("[LobbyManager] skill intro start (day=" .. tostring(stage + 1) .. ")")
            end
            if self.financeIntroPending then
                self.financeIntroPending = false
                self.financeReveal = "intro"
                self.financeIntroTime = 0
                log("[LobbyManager] finance intro start")
            end
        end

        -- 매 프레임 멱등 적용(Enable은 화면과 무관하게 기록, intro 타이머는 showHub일 때만 진행).
        self:ApplyReveal("skill", delta, showHub)
        self:ApplyReveal("finance", delta, showHub)
    end

    @ExecSpace("ClientOnly")
    method void ApplyReveal(string which, number delta, boolean showHub)
        -- which("skill"/"finance") 버튼의 공개 상태(hidden/intro/shown)를 실제 UI에 반영.
        local btn = nil
        local reveal = ""
        local introTime = 0
        local baseX = 0
        local baseY = 0
        if which == "skill" then
            btn = self.btnSkill
            reveal = self.skillReveal
            introTime = self.skillIntroTime
            baseX = self.btnSkillBaseX
            baseY = self.btnSkillBaseY
        else
            btn = self.btnFinance
            reveal = self.financeReveal
            introTime = self.financeIntroTime
            baseX = self.btnFinanceBaseX
            baseY = self.btnFinanceBaseY
        end
        if not isvalid(btn) then return end
        local ent = btn.Entity
        local tf = ent.UITransformComponent
        local cg = ent.CanvasGroupComponent

        if reveal == "hidden" then
            ent.Enable = false
        elseif reveal == "intro" then
            ent.Enable = true
            if showHub then
                introTime = introTime + delta
            end
            local t = introTime / self.introDuration
            if t > 1 then t = 1 end
            local eased = 1 - (1 - t) * (1 - t) * (1 - t)   -- ease-out cubic
            if isvalid(tf) then
                tf.anchoredPosition = Vector2(baseX, baseY - self.introOffsetY * (1 - eased))
            end
            if isvalid(cg) then
                cg.GroupAlpha = eased
                cg.Interactable = false
            end
            if t >= 1 then
                reveal = "shown"
                log("[LobbyManager] " .. which .. " intro done")
            end
        else -- "shown"
            ent.Enable = true
            if isvalid(tf) then
                tf.anchoredPosition = Vector2(baseX, baseY)
            end
            if isvalid(cg) then
                cg.GroupAlpha = 1
                cg.Interactable = true
            end
        end

        -- 변경된 상태/타이머 저장(property 세트 선택).
        if which == "skill" then
            self.skillReveal = reveal
            self.skillIntroTime = introTime
        else
            self.financeReveal = reveal
            self.financeIntroTime = introTime
        end
    end

    @ExecSpace("ClientOnly")
    method void ResetButtonReveal()
        -- 게임오버 후 재시작 시 버튼 공개 상태를 1주차 초기 상태로 되돌린다(큐브만 표시).
        self.skillReveal = "hidden"
        self.financeReveal = "hidden"
        self.skillIntroTime = 0
        self.financeIntroTime = 0
        self.skillIntroPending = false
        self.financeIntroPending = false
        self.financeLatch = false
        if isvalid(self.btnSkill) then
            self.btnSkill.Entity.Enable = false
            if isvalid(self.btnSkill.Entity.UITransformComponent) then
                self.btnSkill.Entity.UITransformComponent.anchoredPosition = Vector2(self.btnSkillBaseX, self.btnSkillBaseY)
            end
            if isvalid(self.btnSkill.Entity.CanvasGroupComponent) then
                self.btnSkill.Entity.CanvasGroupComponent.GroupAlpha = 1
            end
        end
        if isvalid(self.btnFinance) then
            self.btnFinance.Entity.Enable = false
            if isvalid(self.btnFinance.Entity.UITransformComponent) then
                self.btnFinance.Entity.UITransformComponent.anchoredPosition = Vector2(self.btnFinanceBaseX, self.btnFinanceBaseY)
            end
            if isvalid(self.btnFinance.Entity.CanvasGroupComponent) then
                self.btnFinance.Entity.CanvasGroupComponent.GroupAlpha = 1
            end
        end
        log("[LobbyManager] button reveal reset (restart)")
    end

    @ExecSpace("ClientOnly")
    method void OnCubeClicked()
        -- 큐브 스크래치 진입: 화면 상태를 shop으로 → WeaponShopManager가 상점 board를 노출한다.
        self.ActiveScreen = "shop"
        log("[LobbyManager] enter shop (cube scratch)")
    end

    @ExecSpace("ClientOnly")
    method void OnSkillClicked()
        -- 대장 기술 업그레이드 페이지 진입(AugmentManager가 화면 전환·표시·구매 담당).
        -- 아직 공개되지 않은(등장 연출 중이거나 숨김) 버튼은 무시(Interactable=false의 이중 안전망).
        if self.skillReveal ~= "shown" then return end
        if isvalid(_AugmentManager) then
            _AugmentManager:Open()
        else
            self:ShowToast("대장 기술 업그레이드를 열 수 없습니다")
        end
    end

    @ExecSpace("ClientOnly")
    method void OnFinanceClicked()
        -- 재정 관리 페이지 진입(FinanceManager가 화면 전환·표시 담당).
        -- 아직 공개되지 않은 버튼은 무시(Interactable=false의 이중 안전망).
        if self.financeReveal ~= "shown" then return end
        if isvalid(_FinanceManager) then
            _FinanceManager:Open()
        else
            self:ShowToast("재정 관리를 열 수 없습니다")
        end
    end

    @ExecSpace("ClientOnly")
    method void ShowToast(string msg)
        -- 화면 하단 토스트로 짧게 안내(2초).
        if isvalid(self.toastText) then
            self.toastText.Text = msg
        end
        if isvalid(self.toast) then
            self.toast.Enable = true
        end
        self.toastTimer = 2.0
    end
end
