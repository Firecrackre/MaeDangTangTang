@Logic
script LobbyManager extends Logic
    -- 뒷골목 대장장이 — InGameMap 로비 허브(클라 전용 표시/입력).
    -- 역할: InGameMap에서 "지금 어떤 화면인가"(ActiveScreen)를 소유하는 SSOT + 3버튼 허브 표시/입력.
    --   좌/우상단 HUD(라디얼 시계·메소 박스)는 WeaponShopManager의 RoundTimer/Hud를 로비·상점 공용으로 재사용한다(여기서 안 그림).
    --   ActiveScreen: "lobby"(허브) / "shop"(무기 상점). WeaponShopManager가 이 값을 읽어 상점 노출을 게이팅한다.
    -- @Logic인 이유: _LobbyManager로 전역 접근 가능해야 WeaponShopManager(@Component)가 상태를 읽을 수 있기 때문.
    --   (ClickOnlyController 선례처럼, @Logic이 UI 엔티티 참조를 들고 버튼을 ConnectEvent한다.)
    -- 결과 연산(메소/상환 등)은 전부 서버 권위(_GameManager). 여기서는 표시와 화면 전환 입력만 담당한다.

    property string TargetMapName = "InGameMap"

    -- 화면 상태(클라 로컬). WeaponShopManager가 읽는다.
    property string ActiveScreen = "lobby"

    -- UI 참조(UUID는 UIBuilder write({bind})로 주입).
    property Entity lobbyRoot = "aff6b600-be5d-45a0-ba7f-ebeedba71cdb"          -- 로비 허브 그룹 루트(맵 게이팅 시 Enable 토글 대상)
    -- ⚠ WeaponShopGroup / ScratchTicketGroup 루트는 여기서 게이팅하지 않는다.
    --   그 그룹들은 안에 @Component(WeaponShopManager/ScratchTicketManager)를 품고 있어서,
    --   그룹 루트를 끄면 해당 컴포넌트의 OnBeginPlay/OnUpdate 라이프사이클이 (경합적으로) 영구 정지된다
    --   → 슬롯 렌더가 아예 안 돎(빈 상점) 실측 확인. 그래서 그 그룹들은 항상 켜 두고,
    --   각 매니저가 자기 "자식"만 게이팅한다(board/hud/timer 등). LobbyGroup은 in-group 컴포넌트가 없어 안전.
    property ButtonComponent btnSkill = "ec5e2de3-801a-490a-8820-9d37674ceb75"   -- 대장 기술 업그레이드(준비 중)
    property ButtonComponent btnCube = "42ab2378-46ed-4abd-8ab1-c2a2653a6cd3"    -- 큐브 스크래치 → 상점 열기
    property ButtonComponent btnFinance = "6072d905-8310-4e23-8f6e-522bcf4fb0c6" -- 재정 관리(준비 중)
    -- 상단 HUD(좌 라디얼 시계·우 메소 박스)는 전용 HudGroup + HudManager가 전담(로비 고유 HUD 박스는 제거됨).
    property Entity toast = "63c0291c-87d6-4663-945b-643c5f71243d"                -- "준비 중" 토스트 루트
    property TextComponent toastText = "d31e443b-2f47-493e-a4ef-e2e0130706d3"     -- 토스트 텍스트

    -- 내부 상태.
    property boolean isActive = false      -- 허브(lobbyRoot) 표시 여부 변화감지
    property number toastTimer = 0
    property any skillHandler = nil
    property any cubeHandler = nil
    property any financeHandler = nil

    @ExecSpace("ClientOnly")
    method void OnBeginPlay()
        -- 게이팅 초기화: 시작 시 로비 루트를 명시적으로 끈다(변화감지 가드가 초기 상태를 못 잡는 gotcha 회피).
        self.ActiveScreen = "lobby"
        self.isActive = false
        self.toastTimer = 0
        if isvalid(self.lobbyRoot) then
            self.lobbyRoot.Enable = false   -- LobbyGroup엔 in-group @Component가 없어 OnBeginPlay에서 꺼도 안전
        end
        if isvalid(self.toast) then
            self.toast.Enable = false
        end

        -- 3버튼 클릭 연결(ConnectEvent는 Entity에서 호출한다 — Component 아님).
        if isvalid(self.btnCube) then
            self.cubeHandler = self.btnCube.Entity:ConnectEvent(ButtonClickEvent, self.OnCubeClicked)
        end
        if isvalid(self.btnSkill) then
            self.skillHandler = self.btnSkill.Entity:ConnectEvent(ButtonClickEvent, self.OnSkillClicked)
        end
        if isvalid(self.btnFinance) then
            self.financeHandler = self.btnFinance.Entity:ConnectEvent(ButtonClickEvent, self.OnFinanceClicked)
        end
        log("[LobbyManager] ready. screen=" .. self.ActiveScreen)
    end

    @ExecSpace("ClientOnly")
    method void OnEndPlay()
        -- 연결한 이벤트 해제(필수).
        if self.cubeHandler ~= nil and isvalid(self.btnCube) then
            self.btnCube.Entity:DisconnectEvent(ButtonClickEvent, self.cubeHandler)
        end
        if self.skillHandler ~= nil and isvalid(self.btnSkill) then
            self.btnSkill.Entity:DisconnectEvent(ButtonClickEvent, self.skillHandler)
        end
        if self.financeHandler ~= nil and isvalid(self.btnFinance) then
            self.btnFinance.Entity:DisconnectEvent(ButtonClickEvent, self.financeHandler)
        end
    end

    @ExecSpace("ClientOnly")
    method void OnUpdate(number delta)
        -- 로비 허브(lobbyRoot)만 게이팅한다. 상점/스크래치는 각 매니저가 자기 자식을 게이팅한다(위 프로퍼티 주석 참조).
        -- 허브 표시 조건: InGameMap이면서, 화면 상태가 로비이고, 아이템 미보유(큐브 진행중이 아님)일 때.
        --   큐브 스크래치를 누르면 ActiveScreen="shop"이 되어 허브가 숨고 WeaponShopManager가 상점을 노출한다.
        local lp = _UserService.LocalPlayer
        local onMap = isvalid(lp) and lp.CurrentMapName == self.TargetMapName
        local showHub = onMap and self.ActiveScreen == "lobby" and (_GameManager.CurrentItemId == "")

        -- 매 프레임 idempotent 적용(변화감지 가드 없음 — 초기 프레임/경합 안전).
        self.isActive = showHub
        if isvalid(self.lobbyRoot) then self.lobbyRoot.Enable = showHub end

        -- 아래는 허브 전용(토스트) — 허브가 아닐 땐 건너뛴다.
        -- (상단 HUD는 WeaponShopManager의 공용 RoundTimer/Hud가 담당 — 여기선 더 이상 그리지 않는다.)
        if not showHub then return end

        -- 토스트 타이머(준비 중 안내).
        if self.toastTimer > 0 then
            self.toastTimer = self.toastTimer - delta
            if self.toastTimer <= 0 and isvalid(self.toast) then
                self.toast.Enable = false
            end
        end
    end

    @ExecSpace("ClientOnly")
    method void OnCubeClicked()
        -- 큐브 스크래치 진입: 화면 상태를 shop으로 → WeaponShopManager가 상점 board를 노출한다.
        self.ActiveScreen = "shop"
        log("[LobbyManager] enter shop (cube scratch)")
    end

    @ExecSpace("ClientOnly")
    method void OnSkillClicked()
        -- 대장 기술 업그레이드: 이번 버전 미구현(준비 중 안내).
        self:ShowToast("대장 기술 업그레이드는 준비 중입니다")
    end

    @ExecSpace("ClientOnly")
    method void OnFinanceClicked()
        -- 재정 관리: 이번 버전 미구현(준비 중 안내).
        self:ShowToast("재정 관리는 준비 중입니다")
    end

    @ExecSpace("ClientOnly")
    method void ShowToast(string msg)
        -- 화면 하단 토스트로 짧게 안내(2초).
        if isvalid(self.toastText) then
            self.toastText.Text = msg
        end
        if isvalid(self.toast) then
            self.toast.Enable = true
        end
        self.toastTimer = 2.0
    end
end
