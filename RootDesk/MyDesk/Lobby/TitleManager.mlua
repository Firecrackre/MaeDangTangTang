@Logic
script TitleManager extends Logic
    -- 뒷골목 대장장이 — TitleMap 로고 로비(클라 전용).
    -- 역할: TitleMap에서 로고 화면을 표시하고, 화면을 한 번 클릭하면 InGameMap으로 이동한다.
    -- @Logic인 이유: LobbyManager/ClickOnlyController와 동일하게, UI 엔티티 참조를 들고 버튼을 ConnectEvent한다.
    -- 맵 이동은 PlayerComponent:MoveToMapPosition(@ExecSpace("Server"))로 서버에 요청한다(클라→서버 RPC).

    property string TargetMapName = "TitleMap"
    property string NextMapName = "InGameMap"

    -- UI 참조(UUID는 UIBuilder write({bind})로 주입).
    property Entity titleRoot = "3945432a-ca05-4c0b-83ad-3192a69c7f4d"         -- 그룹 루트(맵 게이팅 시 Enable 토글 대상)
    property ButtonComponent startButton = "201cd016-ee20-4b72-ad21-81f7f2e81e2e" -- 전체화면 시작 버튼
    property TextComponent startText = "6e90ab37-f4bc-4a37-9d15-ce186a3e19e0"      -- "화면을 클릭하여 시작"(깜빡임)
    property UITransformComponent logoTransform = "7f5f6b50-c9e8-4781-ac95-3117e97cbd6f" -- Logo(둥실둥실 부유 연출)

    -- 로고 부유 연출 튜닝값(인스펙터에서 조정).
    property number LogoFloatAmplitude = 6   -- 위아래 진폭(px)
    property number LogoFloatPeriod = 3.0    -- 한 사이클 주기(초)

    property boolean isActive = false
    property boolean moving = false
    property number blinkTime = 0
    property number logoFloatTime = 0
    property Vector2 logoBasePos = Vector2(0, 0)
    property boolean logoBaseCaptured = false
    property any startHandler = nil

    @ExecSpace("ClientOnly")
    method void OnBeginPlay()
        -- 게이팅 초기화: 시작 시 로고 루트를 명시적으로 끈다(변화감지 가드가 초기 상태를 못 잡는 gotcha 회피).
        self.isActive = false
        self.moving = false
        self.blinkTime = 0
        self.logoFloatTime = 0
        if isvalid(self.titleRoot) then
            self.titleRoot.Enable = false
        end
        -- 로고 기준 위치 캡처(부유 오프셋은 매 프레임 이 값 기준으로 계산 → 누적 드리프트 없음).
        if isvalid(self.logoTransform) then
            self.logoBasePos = self.logoTransform.anchoredPosition
            self.logoBaseCaptured = true
        end
        if isvalid(self.startButton) then
            self.startHandler = self.startButton.Entity:ConnectEvent(ButtonClickEvent, self.OnStartClicked)
        end
        log("[TitleManager] ready.")
    end

    @ExecSpace("ClientOnly")
    method void OnEndPlay()
        -- 연결한 이벤트 해제(필수).
        if self.startHandler ~= nil and isvalid(self.startButton) then
            self.startButton.Entity:DisconnectEvent(ButtonClickEvent, self.startHandler)
        end
    end

    @ExecSpace("ClientOnly")
    method void OnUpdate(number delta)
        -- 맵 게이팅: TitleMap일 때만 로고 화면 표시.
        local lp = _UserService.LocalPlayer
        local onMap = isvalid(lp) and lp.CurrentMapName == self.TargetMapName
        if onMap ~= self.isActive then
            self.isActive = onMap
            if isvalid(self.titleRoot) then
                self.titleRoot.Enable = onMap
            end
            if onMap then self.moving = false end  -- 맵 재진입 시 이동 가드 해제
        end
        if not onMap then return end

        -- "화면을 클릭하여 시작" 깜빡임.
        self.blinkTime = self.blinkTime + delta
        if isvalid(self.startText) then
            local a = (math.sin(self.blinkTime * 3.0) + 1) * 0.5  -- 0~1
            self.startText.FontColor = Color(1, 0.905, 0.69, 0.35 + a * 0.65)
        end

        -- 로고 둥실둥실 부유(사인 곡선, 기준 위치 + 오프셋).
        if self.logoBaseCaptured and isvalid(self.logoTransform) and self.LogoFloatPeriod > 0 then
            self.logoFloatTime = self.logoFloatTime + delta
            local offsetY = math.sin(self.logoFloatTime * 2 * math.pi / self.LogoFloatPeriod) * self.LogoFloatAmplitude
            self.logoTransform.anchoredPosition = Vector2(self.logoBasePos.x, self.logoBasePos.y + offsetY)
            if self._T.floatLogged ~= true then
                self._T.floatLogged = true
                log("[TitleManager] logo float active. base=(" .. tostring(self.logoBasePos.x) .. "," .. tostring(self.logoBasePos.y) .. ") amp=" .. tostring(self.LogoFloatAmplitude) .. " period=" .. tostring(self.LogoFloatPeriod))
            end
        end
    end

    @ExecSpace("ClientOnly")
    method void OnStartClicked()
        -- 화면 클릭 → InGameMap으로 이동(서버 RPC). 중복 클릭 가드.
        if self.moving then return end
        local lp = _UserService.LocalPlayer
        if not isvalid(lp) then return end
        local pc = lp.PlayerComponent
        if not isvalid(pc) then return end
        self.moving = true
        log("[TitleManager] start clicked -> move to " .. self.NextMapName)
        pc:MoveToMapPosition(self.NextMapName, Vector2(0, 0))
    end
end
