@Logic
script HudManager extends Logic
    -- 뒷골목 대장장이 — 로비/상점/스크래치 공용 상단 HUD(클라 전용 표시).
    -- 좌상단 라디얼 시계("현재 시간" + n/5) / 우상단 메소 박스("현재 소유 메소" · "상환 필요 메소").
    -- 이전엔 WeaponShopManager/ScratchTicketManager에 HUD 갱신 로직이 중복 존재했으나, 이 매니저로 일원화하고
    --   UI 엔티티도 전용 HudGroup.ui 하나로 통합했다(단일 출처).
    -- @Logic 이유: 전역 단일 표시 매니저 + HudGroup엔 in-group @Component가 없어 루트 Enable 게이팅이 안전.
    -- 값은 전부 서버 권위 @Sync(_GameManager). 여기서는 표시만 담당한다.

    property string TargetMapName = "InGameMap"

    -- UI 참조(HudGroup.ui). UUID는 HudGroup 생성 시 확정.
    property Entity hudRoot = "c33fb761-361b-4fbe-80ca-14d3dc76e420"                    -- HudGroup 루트(맵 게이팅 대상)
    property Entity timerRoot = "579e17d5-436d-4891-83ec-1b0680a220e7"                  -- 좌상단 라디얼 시계 루트(흔들림 대상)
    property SpriteGUIRendererComponent timerFill = "f98da801-6b53-4fc8-b737-6a25ec2867f7"  -- 라디얼 채움(FillAmount)
    property UITransformComponent timerHandle = "21bf008a-ba5d-4780-8625-db461d74dc86"      -- 라디얼 시계 분침(ZRotation 회전)
    property TextComponent timerLabel = "02268e21-ec76-4f41-bd49-bb19c7c53018"          -- 중앙 "n/5" 라벨
    property CanvasGroupComponent timerLabelCanvas = "02268e21-ec76-4f41-bd49-bb19c7c53018" -- 위와 같은 엔티티(깜빡 알파용)
    property TextComponent mesoText = "02481a8c-1e99-4a11-9c52-16c10bd14652"            -- 우상단 현재 소유 메소
    property TextComponent repayText = "11dd3c0d-7633-49af-bb75-5ef36085be80"           -- 우상단 상환 필요 메소
    property TextComponent weekText = "c3d97066-c15a-46cd-9da4-a220ca6b28cf"            -- 라디얼 시계 "N주차" 라벨(TimerCurrentWeek)

    -- 재정 관리: 대출 빚 표시 박스 + 대출 유도 슬라이드 팝업(UUID는 UIBuilder write({bind})로 주입).
    property Entity debtBox = "1a39278a-8f91-428c-9e34-29c2e3d894d7"          -- '현재 빚' 박스 루트(Debt>0일 때만 Enable)
    property TextComponent debtText = "995dab86-fb01-4934-944e-e9097a5ec5cd" -- '현재 빚' 텍스트
    property Entity loanPopup = "682736f8-1354-45f4-af4b-07f011f9a94d"        -- '대출하러 가기!' 슬라이드 팝업(버튼+CanvasGroup)
    property Entity dim = "f783a592-c225-4516-986c-ecc3ff1e32b4"                              -- 전면 딤(모달 배경). CTA 활성 시만 Enable. UUID는 UIBuilder write({bind}) 주입.

    -- 내부 상태.
    property integer maxCubes = 5
    property number warnTime = 0
    property Vector2 timerBasePos = Vector2(0, 0)
    property string lastClockKey = ""
    property string lastHudKey = ""
    property string lastWeekKey = ""

    -- 라디얼 시계 분침(TimerHandle) 회전 상태.
    --   used=0(12시 기준) → handleBaseZ. 1/5칸마다 시계방향으로 handleTurnDeg/maxCubes 만큼 회전.
    --   Rotate()가 반시계 양수 규약이므로 시계방향 = ZRotation 감소(handleClockwiseSign=-1).
    property number handleBaseZ = 180         -- used=0일 때 ZRotation(12시). OnBeginPlay에서 .ui 저작값으로 재캡처.
    property number handleTurnDeg = 360        -- 한 바퀴(=maxCubes칸) 총 회전각
    property number handleClockwiseSign = -1   -- 시계방향(-1) / 반시계(1)

    -- 대출 유도 팝업 슬라이드 상태.
    --   박스 슬롯 규약(Hud 패널 기준, anchoredPosition.y): MesoBox 0 / RepayBox -84 / DebtBox -168.
    --   팝업 목표 y: 빚 없으면 RepayBox 아래(-168), 빚 있으면 DebtBox 아래(-252).
    --   숨김 y = 목표 y + 84 → 바로 위 박스 뒤에 겹쳐 숨었다가 스르륵 내려온다.
    property number popupSlotH = 84         -- 박스 한 칸 높이(74) + 간격(10)
    property number popupSpeed = 400        -- 슬라이드 속도(px/s)
    property number popupY = -84            -- 현재 팝업 y(초기 = 빚 없을 때 숨김 위치)
    property boolean loanPopupActive = false -- 등장/체류/퇴장 애니메이션 진행 중 여부
    property any loanPopupHandler = nil
    -- 게임오버(weapon/cube) 사슬 연출 동안 팝업 강제 표시(GameOverManager:SetForceLoanPopup).
    property boolean forceLoanPopup = false
    -- 딤(모달) 상태: CTA 활성 동안 화면을 어둡게 한다.
    --   HudGroup은 .ui에서 GroupOrder=4 정적 고정(상점3/스크래치1/로비2 위, 재정5 아래) — 런타임 변경은
    --   MSW에서 렌더 재정렬이 안 되므로 쓰지 않는다. 여기서는 전면 딤의 Enable만 토글한다.
    --   dimActive는 변화 시에만 Enable을 쓰기 위한 캐시(매 프레임 write 방지).
    property boolean dimActive = false

    @ExecSpace("ClientOnly")
    method void OnBeginPlay()
        -- 최대 칸 수(상환 주기)는 config의 debtCycle = SSOT.
        self.maxCubes = _BlacksmithConfig:GetData().debtCycle
        self.warnTime = 0
        if isvalid(self.timerRoot) and isvalid(self.timerRoot.UITransformComponent) then
            self.timerBasePos = self.timerRoot.UITransformComponent.anchoredPosition
        end
        -- 분침의 저작된 현재 각도를 used=0(12시) 기준점으로 캡처(아트가 올려둔 포즈를 그대로 12시로 삼음).
        if isvalid(self.timerHandle) then
            self.handleBaseZ = self.timerHandle.ZRotation
        end
        -- 게이팅 초기화: 시작 시 HUD를 명시적으로 끈다(변화감지 가드가 초기 상태를 못 잡는 gotcha 회피).
        if isvalid(self.hudRoot) then self.hudRoot.Enable = false end

        -- 대출 유도 팝업 초기화: 숨김 위치로 스냅 + 비활성. 클릭 시 재정 관리 진입.
        self.loanPopupActive = false
        self.popupY = -self.popupSlotH  -- 빚 없을 때 숨김 y(= -84)
        if isvalid(self.loanPopup) then
            self.loanPopup.Enable = false
            self.loanPopupHandler = self.loanPopup:ConnectEvent(ButtonClickEvent, self.OnLoanPopupClicked)
            -- 팝업을 상단 박스(MesoBox/RepayBox/DebtBox)보다 뒤에 렌더 → 박스 뒤에서 스르륵 내려오는 연출.
            --   (형제 렌더 순서는 배열 순서. 인덱스 1 = 맨 뒤.)
            if isvalid(self.loanPopup.UITransformComponent) then
                _UILogic:SetSiblingIndex(self.loanPopup.UITransformComponent, 1)
            end
        end
        if isvalid(self.debtBox) then self.debtBox.Enable = false end

        -- 딤 초기화: 숨김 + 루트 최하단 형제로 밀어 Hud/RoundTimer 아래에 렌더(HUD는 밝게 유지).
        --   HudGroup 자체는 .ui에서 GroupOrder=4 정적 → 딤이 켜지면 상점/스크래치/로비를 덮는다.
        self.dimActive = false
        if isvalid(self.dim) then
            self.dim.Enable = false
            if isvalid(self.dim.UITransformComponent) then
                _UILogic:SetSiblingIndex(self.dim.UITransformComponent, 0)
            end
        end
        log("[HudManager] ready. maxCubes=" .. tostring(self.maxCubes))
    end

    @ExecSpace("ClientOnly")
    method void OnEndPlay()
        -- 연결한 팝업 클릭 이벤트 해제(필수).
        if self.loanPopupHandler ~= nil and isvalid(self.loanPopup) then
            self.loanPopup:DisconnectEvent(ButtonClickEvent, self.loanPopupHandler)
        end
        self.loanPopupHandler = nil
    end

    @ExecSpace("ClientOnly")
    method void OnUpdate(number delta)
        -- InGameMap이면 로비/상점/스크래치 어느 화면이든 HUD 상시 표시(아이템 유무 무관).
        -- 각 화면 그룹은 HudGroup(GroupOrder=0) 위에 얹혀 렌더된다.
        local lp = _UserService.LocalPlayer
        local onInGame = isvalid(lp) and lp.CurrentMapName == self.TargetMapName

        -- 매 프레임 멱등 적용(초기 프레임/경합 안전).
        if isvalid(self.hudRoot) then self.hudRoot.Enable = onInGame end
        if not onInGame then return end

        self:UpdateClock()
        self:UpdateWeek()
        self:UpdateHud()
        self:UpdateDebt()
        self:UpdateWarningFX(delta)
        self:UpdateLoanPopup(delta)
    end

    @ExecSpace("ClientOnly")
    method void UpdateClock()
        -- 서버 권위 큐브 사용 횟수로 라디얼을 채운다(0/5에서 시작해 상환 시점 5/5로 증가).
        local used = _GameManager.CubeUseCount % self.maxCubes
        if _GameManager.IsRepaymentDue then used = self.maxCubes end
        local key = tostring(used)
        if key == self.lastClockKey then return end
        self.lastClockKey = key
        if isvalid(self.timerFill) then
            self.timerFill.FillAmount = used / self.maxCubes
        end
        -- 분침: 0/5 = 12시(handleBaseZ), 1/5칸마다 시계방향으로 handleTurnDeg/maxCubes 만큼 회전.
        if isvalid(self.timerHandle) then
            local frac = used / self.maxCubes
            self.timerHandle.ZRotation = self.handleBaseZ + self.handleClockwiseSign * self.handleTurnDeg * frac
        end
        if isvalid(self.timerLabel) then
            self.timerLabel.Text = tostring(used) .. "/" .. tostring(self.maxCubes)
        end
    end

    @ExecSpace("ClientOnly")
    method void UpdateWeek()
        -- "N주차" 라벨. 일차/주차 = DebtStage + 1 (A안, 서버 GetCurrentDay와 동일 규약).
        --   DebtStage는 @Sync라 클라가 직접 계산. 상환 성공(DebtStage++)마다 문구가 바뀐다.
        local day = _GameManager.DebtStage + 1
        local key = tostring(day)
        if key == self.lastWeekKey then return end
        self.lastWeekKey = key
        if isvalid(self.weekText) then
            self.weekText.Text = tostring(day) .. "주차"
        end
    end

    @ExecSpace("ClientOnly")
    method void UpdateHud()
        -- 현재 소유 메소(충분 초록/부족 빨강) + 이번 라운드 상환 필요 메소. 값 변화 시에만 갱신.
        -- repayText의 FontColor는 여기서 건드리지 않는다 — 임박 깜빡임은 UpdateWarningFX가 단독 관리.
        local meso = _GameManager.Meso
        -- 상환 필요 메소 = 서버 SSOT(GetCurrentRepayment): 미납 시 실효 상환금, 아니면 다음 단계 미리보기.
        local required = _GameManager:GetCurrentRepayment()
        -- 다음 라운드로 넘어가려면 '상환 필요 메소 + 대출 빚'을 전부 갚아야 하므로 충분/부족 판정은 둘의 합 기준.
        local needTotal = required + _GameManager.Debt
        local key = tostring(meso) .. "|" .. tostring(required) .. "|" .. tostring(_GameManager.Debt)
        if key == self.lastHudKey then return end
        self.lastHudKey = key

        if isvalid(self.mesoText) then
            self.mesoText.Text = "현재 소유 메소: " .. self:Comma(meso)
            if meso >= needTotal then
                self.mesoText.FontColor = Color(0.3, 0.85, 0.3, 1)   -- 충분 → 초록
            else
                self.mesoText.FontColor = Color(1, 0.3, 0.3, 1)      -- 부족 → 빨강
            end
        end
        if isvalid(self.repayText) then
            self.repayText.Text = "상환 필요 메소: " .. self:Comma(required)
        end
    end

    @ExecSpace("ClientOnly")
    method void UpdateWarningFX(number delta)
        -- 임박 연출 2단계:
        --   shakeOn(3/5부터): 시계가 주기적으로 짧게 흔들림.
        --   urgentOn(4/5부터): + 중앙 "n/5" 라벨 빨강 깜빡, + 메소 부족 시 상환필요 텍스트 빨강↔골드.
        local goldColor = Color(1, 0.831, 0.475, 1)
        local used = _GameManager.CubeUseCount % self.maxCubes
        if _GameManager.IsRepaymentDue then used = self.maxCubes end
        local shakeOn = used >= (self.maxCubes - 2)   -- 3/5,4/5,5/5
        local urgentOn = used >= (self.maxCubes - 1)  -- 4/5,5/5

        if shakeOn then
            self.warnTime = self.warnTime + delta
            local blinkOn = (math.floor(self.warnTime / 0.3) % 2 == 0)

            -- (a) 부들부들: 2.5초 주기 중 앞 0.35초만 미세 흔들림
            if isvalid(self.timerRoot) and isvalid(self.timerRoot.UITransformComponent) then
                if (self.warnTime % 2.5) < 0.35 then
                    local jx = (_UtilLogic:RandomDouble() - 0.5) * 8
                    local jy = (_UtilLogic:RandomDouble() - 0.5) * 8
                    self.timerRoot.UITransformComponent.anchoredPosition =
                        Vector2(self.timerBasePos.x + jx, self.timerBasePos.y + jy)
                else
                    self.timerRoot.UITransformComponent.anchoredPosition = self.timerBasePos
                end
            end

            if urgentOn then
                -- (b) 라벨 빨강 + 깜빡(글자+외곽선 통째)
                if isvalid(self.timerLabel) then
                    self.timerLabel.FontColor = Color(1, 0.15, 0.15, 1)
                end
                if isvalid(self.timerLabelCanvas) then
                    self.timerLabelCanvas.GroupAlpha = blinkOn and 1.0 or 0.1
                end
                -- (c) 메소 부족 시 상환필요메소 빨강↔골드 (상환 필요 메소 + 대출 빚 합계 기준)
                if isvalid(self.repayText) then
                    local required = _GameManager:GetCurrentRepayment()
                    if _GameManager.Meso < (required + _GameManager.Debt) and blinkOn then
                        self.repayText.FontColor = Color(1, 0.2, 0.2, 1)
                    else
                        self.repayText.FontColor = goldColor
                    end
                end
            else
                -- 3/5: 흔들리기만 — 라벨/상환텍스트 평상
                if isvalid(self.timerLabel) then self.timerLabel.FontColor = Color(1, 1, 1, 1) end
                if isvalid(self.timerLabelCanvas) then self.timerLabelCanvas.GroupAlpha = 1.0 end
                if isvalid(self.repayText) then self.repayText.FontColor = goldColor end
            end
        else
            -- 평상 복원(<=2/5)
            self.warnTime = 0
            if isvalid(self.timerRoot) and isvalid(self.timerRoot.UITransformComponent) then
                self.timerRoot.UITransformComponent.anchoredPosition = self.timerBasePos
            end
            if isvalid(self.timerLabel) then self.timerLabel.FontColor = Color(1, 1, 1, 1) end
            if isvalid(self.timerLabelCanvas) then self.timerLabelCanvas.GroupAlpha = 1.0 end
            if isvalid(self.repayText) then self.repayText.FontColor = goldColor end
        end
    end

    @ExecSpace("ClientOnly")
    method void UpdateDebt()
        -- 대출로 누적된 '현재 빚' 표시. 빚이 0이면 박스를 숨긴다.
        local debt = _GameManager.Debt
        if isvalid(self.debtBox) then self.debtBox.Enable = debt > 0 end
        if isvalid(self.debtText) then
            self.debtText.Text = "현재 빚 : " .. self:Comma(debt)
        end
    end

    @ExecSpace("ClientOnly")
    method void UpdateLoanPopup(number delta)
        -- 대출 유도 팝업을 상단 박스 뒤에서 스르륵 내리고(등장) 올린다(퇴장).
        -- 목표 y: 빚 있으면 DebtBox 아래(-252), 없으면 RepayBox 아래(-168). 숨김 y = 목표 y + 84.
        if not isvalid(self.loanPopup) then return end
        local debt = _GameManager.Debt
        local targetY = (debt > 0) and (-2 * self.popupSlotH - self.popupSlotH) or (-2 * self.popupSlotH)  -- -252 / -168
        local hiddenY = targetY + self.popupSlotH
        local shown = self:WantLoanPopup()
        local ui = self.loanPopup.UITransformComponent
        local cg = self.loanPopup.CanvasGroupComponent

        if not shown and not self.loanPopupActive then
            -- 완전 숨김 유지: 애니메이션 없이 hiddenY로 스냅(빚 변화로 hiddenY가 바뀌어도 조용히 따라감).
            self.popupY = hiddenY
            self.loanPopup.Enable = false
            return
        end

        -- 활성(등장/체류/퇴장 중): 목표를 향해 선형 이동.
        self.loanPopupActive = true
        self.loanPopup.Enable = true
        local goalY = shown and targetY or hiddenY
        local dy = goalY - self.popupY
        local step = self.popupSpeed * delta
        if math.abs(dy) <= step then
            self.popupY = goalY
        elseif dy > 0 then
            self.popupY = self.popupY + step
        else
            self.popupY = self.popupY - step
        end
        if isvalid(ui) then ui.anchoredPosition = Vector2(0, self.popupY) end

        -- 클릭은 완전히 내려온 상태(도착)에서만 허용. 슬라이드 중/퇴장 중엔 막는다.
        local arrived = shown and (math.abs(self.popupY - targetY) < 0.5)
        if isvalid(cg) then cg.Interactable = arrived end

        -- 퇴장 완료 → 비활성화(다음 프레임부터 스냅 경로).
        if (not shown) and (math.abs(self.popupY - hiddenY) < 0.5) then
            self.loanPopupActive = false
            self.loanPopup.Enable = false
        end

        -- 딤(모달) 구동: 팝업이 유효 노출 중(등장~체류~퇴장 슬라이드)이면 화면을 어둡게 + HudGroup을
        --   상점/스크래치 위로 상승시켜 그 아래를 덮고 클릭을 차단한다. 게임오버 사슬 연출과는 분리(IsGameOver 게이팅).
        self:UpdateDim(shown or self.loanPopupActive)
    end

    @ExecSpace("ClientOnly")
    method void UpdateDim(boolean present)
        -- present=팝업이 화면에 유효 노출 중인가. 게임오버(사슬/자물쇠 연출)는 자체 딤을 쓰므로 여기선 개입 안 함.
        local dimOn = present and (not _GameManager.IsGameOver)
        if dimOn == self.dimActive then return end   -- 변화 없을 때 매 프레임 write 방지
        self.dimActive = dimOn
        -- 전면 딤 토글만 담당. HudGroup(정적 GroupOrder=4)이 이미 상점/스크래치/로비 위라, 딤(최하단 형제)이
        --   켜지면 그 콘텐츠를 덮고 raycast로 클릭을 흡수한다. HUD 박스/시계/팝업은 딤 위(밝게) 유지.
        if isvalid(self.dim) then self.dim.Enable = dimOn end
    end

    @ExecSpace("ClientOnly")
    method void SetForceLoanPopup(boolean force)
        -- 게임오버 사슬 연출용: IsGameOver 상태에서도 대출 팝업을 강제로 유지/해제(GameOverManager가 호출).
        self.forceLoanPopup = force
    end

    @ExecSpace("ClientOnly")
    method boolean WantLoanPopup()
        -- 대출 유도 팝업을 띄울 상황인가:
        --   스크래치 화면(아이템 보유, 큐브 미사용) → 이상한 큐브 살 돈이 모자람.
        --   큐브 사용 후(결과 보유)에는 판매로 회생 가능하므로 띄우지 않는다.
        --   상점 화면(ActiveScreen=="shop", 미보유) → 상점 무기 3슬롯을 전부 살 수 없음.
        --   재정 관리 화면에서는 띄우지 않는다.
        --   게임오버 시에는 사슬 연출(weapon/cube) 동안만 강제 표시(forceLoanPopup).
        if _GameManager.IsGameOver then return self.forceLoanPopup end
        local screen = isvalid(_LobbyManager) and _LobbyManager.ActiveScreen or "lobby"
        if screen == "finance" then return false end
        if _GameManager.CurrentItemId ~= "" then
            -- 큐브를 이미 사용해 결과가 나온 상태면 판매로 회생 가능 → 대출 유도 안 함(위기 상황 아님).
            if _GameManager.HasPotential then return false end
            local weird = _BlacksmithConfig:GetCube("weird")
            local cost = (weird ~= nil) and weird.cost or 0
            return _GameManager.Meso < cost
        elseif screen == "shop" then
            return self:AllShopUnaffordable()
        end
        return false
    end

    @ExecSpace("ClientOnly")
    method boolean AllShopUnaffordable()
        -- 상점 슬롯 CSV(ShopSlotsData)를 파싱해 3슬롯 실효 구매가가 전부 보유 메소를 초과하는지 판정.
        --   하나라도 살 수 있으면 false. 슬롯이 아예 없으면 false(판정 불가).
        local data = _GameManager.ShopSlotsData
        if data == nil or data == "" then return false end
        local meso = _GameManager.Meso
        local any = false
        for token in string.gmatch(data, "([^,]+)") do
            any = true
            local gradeKey = string.match(token, ":([^:]+)")
            local g = (gradeKey ~= nil) and _BlacksmithConfig:GetWeaponGrade(gradeKey) or nil
            if g ~= nil then
                local cost = _GameManager:GetEffectiveBuyCost(g.buyCost)
                if meso >= cost then return false end
            end
        end
        return any
    end

    @ExecSpace("ClientOnly")
    method void OnLoanPopupClicked()
        -- 팝업 클릭 → 재정 관리 페이지 진입(FinanceManager가 화면 전환·팝업 퇴장 처리).
        log("[HudManager] loan popup clicked -> open finance")
        if isvalid(_FinanceManager) then
            _FinanceManager:Open()
        end
    end

    method string Comma(integer n)
        -- 천 단위 콤마 문자열(가격/메소용).
        local s = tostring(n)
        local out = ""
        local cnt = 0
        for i = #s, 1, -1 do
            out = string.sub(s, i, i) .. out
            cnt = cnt + 1
            if cnt % 3 == 0 and i > 1 then out = "," .. out end
        end
        return out
    end
end
