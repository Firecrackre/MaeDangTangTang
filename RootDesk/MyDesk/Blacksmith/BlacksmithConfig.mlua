@Logic
script BlacksmithConfig extends Logic

	property any Data = nil

	method void OnInitialize()
		        -- 서버/클라이언트 양쪽에서 동일한 설정 사본을 미리 구축한다.
		        self:BuildData()
	end

	method void OnBeginPlay()
		        -- 검증용: 설정이 정상 구축되었는지 로그로 증거를 남긴다.
		        local d = self:GetData()
		        log("[BlacksmithConfig] ready. startMeso=" .. tostring(d.startMeso)
		            .. ", cubeCost=" .. tostring(d.cubeCost)
		            .. ", equipments=" .. tostring(#d.equipmentOrder))
	end

	method void BuildData()
		        -- 모든 밸런스 상수를 조립한다(지연 1회).
		        if self.Data ~= nil then return end
		        local d = {}
		
		        -- 시작/재화 기본값 (flow §5, concept §6-2)
		        d.startMeso = 90000
		        d.cubeCost = 7000              -- 이상한 큐브 사용 비용(폴백 — GetCubeCost(cubeKey, gradeStage)가 SSOT)
		        d.bonusChance = 16             -- 이탈 확률(%) — 주요 옵션 1줄당 (potential §8)
		
		        -- 큐브 종류 (concept §6-2, potential §12). 메커톤: 이상한 큐브 + 장인의 큐브 2종.
		        --   cost: 1회 사용 비용. allowDestroy: 파괴 항목 등장 가능 여부(장인의 큐브는 false → 파괴 없음).
		        --   icon: 큐브 아이콘 스프라이트 RUID(좌하단 큐브 선택 UI / 중앙 큐브 아이콘). 빈 값 금지.
		        d.cubeOrder = {"weird", "master"}
		        --   ⚠ icon은 plain 스프라이트 RUID(thumbnail:// 접두사 없이 ImageRUID에 직접 설정). 메이플 공식 큐브 아이콘.
		        --   이상한 큐브=수상한 큐브, 장인의 큐브=블랙 큐브 (msw-search 리소스 검색).
		        --   costs: 증강 '귀한 태생'(innateGrade) 단계별 큐브 1개 구매 가격(index = 단계+1, 0~3단계).
		        --     증강이 등급 확률을 올리는 대신 큐브 비용을 키우는 고위험 트레이드오프(유저 지정). GetCubeCost가 SSOT.
		        --     (cost 필드는 폐기 — 모든 호출부는 GetCubeCost(cubeKey, gradeStage) 사용.)
		        d.cubes = {
		            weird  = { key = "weird",  label = "이상한 큐브", costs = {7000, 9000, 12000, 16000},    allowDestroy = true,  icon = "31e4268ff65b4281abd509162ca199e3" },
		            master = { key = "master", label = "장인의 큐브", costs = {45000, 50000, 74000, 95000}, allowDestroy = false, icon = "1edec01f822c422293f62729e7462a22" },
		        }
		
		        -- 등급 (potential §4). 잠재능력 등급 = 5단계(커먼~레전더리). ⚠ 무기 등급(weaponGrades)과는 별개 축.
		        --   gradeProb = 0단계(증강 '귀한 태생' 미보유) 기본 등장 확률표. 상위 단계는 cubeGradeProb로 교체.
		        d.gradeOrder = {"Common", "Rare", "Epic", "Unique", "Legendary"}
		        d.gradeProb = { Common = 60, Rare = 30, Epic = 10, Unique = 0, Legendary = 0 }        -- 0단계 기본표(합 100)
		        d.gradeMult = { Common = 1.0, Rare = 1.3, Epic = 1.6, Unique = 2.3, Legendary = 3.2 }  -- 판매가 등급 배수(유저 지정)
		
		        -- 증강 '귀한 태생'(innateGrade) 단계별 잠재 등급 절대 확률표 (blacksmith_upgrade.md §6, betterGoodsGradeProb 패턴).
		        --   0단계(미보유) = 위 gradeProb. 1~3단계 = 아래 표로 통째 교체. 각 표의 합은 100.
		        --   PotentialService:RollGrade가 보유 단계를 GetCubeGradeProbTable로 조회해 추첨한다.
		        d.cubeGradeProb = {
		            [1] = { Common = 40, Rare = 40, Epic = 15, Unique = 5,  Legendary = 0 },
		            [2] = { Common = 24, Rare = 38, Epic = 23, Unique = 12, Legendary = 3 },
		            [3] = { Common = 20, Rare = 25, Epic = 31, Unique = 19, Legendary = 5 },
		        }
		
		        -- 옵션 타입 확률 — 각 줄 개별 판정 (potential §5). 합 100.
		        d.optionTypeProb = { Main = 70, Junk = 28, Destroy = 2 }
		
		        -- 주요 옵션 풀: 주스탯4 + 공격계열3 = 7종 균등 추첨 (potential §6)
		        d.mainPool = {"STR", "DEX", "INT", "LUK", "ATK", "MATK", "BATK"}
		        d.mainOptions = {
		            STR  = { group = "MainStat", normal = 9,  bonus = 12, label = "STR",        unit = "%" },
		            DEX  = { group = "MainStat", normal = 9,  bonus = 12, label = "DEX",        unit = "%" },
		            INT  = { group = "MainStat", normal = 9,  bonus = 12, label = "INT",        unit = "%" },
		            LUK  = { group = "MainStat", normal = 9,  bonus = 12, label = "LUK",        unit = "%" },
		            ATK  = { group = "Attack",   normal = 6,  bonus = 9,  label = "공격력",      unit = "%" },
		            MATK = { group = "Attack",   normal = 6,  bonus = 9,  label = "마력",        unit = "%" },
		            BATK = { group = "Attack",   normal = 20, bonus = 30, label = "보스공격력",  unit = "%" },
		        }
		
		        -- 잡옵 (potential §7) — value/보너스 (pricing §9)
		        d.junkPool = {"Sleep", "Speed", "Jump", "Language", "Charm"}
		        d.junkOptions = {
		            Sleep    = { value = 30, unit = "%", bonus = 100, label = "수면 효율" },
		            Speed    = { value = 10, unit = "",  bonus = 200, label = "이동속도" },
		            Jump     = { value = 10, unit = "",  bonus = 300, label = "점프력" },
		            Language = { value = 30, unit = "%", bonus = 400, label = "언어 능력" },
		            Charm    = { value = 30, unit = "%", bonus = 500, label = "친화력" },
		        }
		
		        -- 옵션 보너스 — 유효 기준 (pricing §9)
		        d.optionBonus = {
		            validStat   = 15000,   -- 유효 주스탯 (STR/DEX/INT/LUK)
		            validAtk    = 20000,   -- 유효 공격력 / 마력
		            validBatk   = 25000,   -- 유효 보스공격력
		            invalidMain = 5000,    -- 비유효 주요 옵션 (장비와 안 맞는 주스탯/공격계열)
		        }
		
		        -- 이탈 배수 — 유효 이탈 개수 기준 (pricing §12). 키 = 개수(0~3)
		        d.bonusMult = { [0] = 1.0, [1] = 1.15, [2] = 1.4, [3] = 1.85 }
		
		        -- 조합 보너스 — 우선순위 높은 순서대로. 적용은 PricingCalculator에서 최고 1개만. (pricing §10)
		        d.comboBonus = {
		            { key = "godAttack",  bonus = 220000 },  -- 유효 공격계열 3줄 + 유효 이탈 3개 (신급 대박)
		            { key = "legendStat", bonus = 220000 },  -- 유효 동일 주스탯 3줄 + 유효 이탈 3개 (전설급 대박)
		            { key = "attack3",    bonus = 140000 },  -- 유효 공격계열 3줄
		            { key = "sameStat3",  bonus = 120000 },  -- 유효 동일 주스탯 3줄
		            { key = "main3",      bonus = 80000  },  -- 유효 주요 옵션 3줄
		            { key = "main2bonus", bonus = 45000  },  -- 유효 주요 옵션 2줄 + 이탈 포함
		        }
		
		        -- 장비 5종 (flow §6, pricing §7·§8). 무기 *종류*는 유효 옵션(stat/atk)·아이콘만 결정한다.
		        -- 보스공격력(BATK)은 모든 장비에서 유효이므로 atk 목록에 포함한다.
		        -- ⚠ basePrice/buyCost는 무기 등급(d.weaponGrades, 아래)이 대체한다 — 상점 구매 시 GameManager가
		        --   구매한 등급의 basePrice/buyCost를 사용한다. 여기 값은 등급 정보가 없을 때의 폴백으로만 남겨둔다.
		        -- icon: 아바타 무기 아이템 RUID(상점 아이콘). 렌더 시 "thumbnail://" 접두사를 붙인다(avataritem 규칙).
		        d.equipment = {
		            sword  = { id = "sword",  label = "검",     stat = "STR", atk = {"ATK", "BATK"},  basePrice = 50000,  buyCost = 18000, icon = "2f92c17d771e4b1d887b3e58ecfab6bf",
		                gradeIcons = { Common = "74ee6047ee0142b281f17c905219eb4b", Rare = "cb774c76c3a54b3f8983eee569100fb8", Epic = "663ced1bf5544d2096cc33d5976e77c4", Unique = "acb65b187f21498d9ad1905359f2f759", Legendary = "23f591e794a8487298d8e5ee9a3a7727" } },  -- ⭐토트훈련용검/영웅글라디우스/프라우테/우트가르드세이버/앱솔랩스세이버
		            bow    = { id = "bow",    label = "활",     stat = "DEX", atk = {"ATK", "BATK"},  basePrice = 50000,  buyCost = 18000, icon = "0b85f005a25241189d274e61c5df0cdd",
		                gradeIcons = { Common = "67ce4147813d49f5975917ee86777950", Rare = "d1df8ca59a99400c97a98668c183b283", Epic = "ed83963681d448f08ecad5d78292d08e", Unique = "e9bf79c342e140ebaba882422cbe56fa", Legendary = "18d80518f407457aa489da97c5fead0d" } },  -- 사냥꾼의활/레드바이퍼/드래곤샤인보우/팍스반레온보우/파프니르윈드체이서
		            staff  = { id = "staff",  label = "스태프", stat = "INT", atk = {"MATK", "BATK"}, basePrice = 100000, buyCost = 40000, icon = "989be911209545fdacf84f92874cb338",
		                gradeIcons = { Common = "7380b5e5754a4e338e65fa232a8a095b", Rare = "2425d40177814d208b56b2a8dac4be1c", Epic = "f7349a239ce946419f936edd91ea8eec", Unique = "91da8c2fa81945a68ae9c13f9f8553dc", Legendary = "eb8d8b0ad5ae482facb6f6b6bfb7ef89" } },  -- ⭐나무스태프/메이플스태프/⭐10주년블랙스태프/네크로로드/마이스터배틀스태프
		            wand   = { id = "wand",   label = "완드",   stat = "INT", atk = {"MATK", "BATK"}, basePrice = 50000,  buyCost = 18000, icon = "133e697ac731441a912f1e58ec2a9182",
		                gradeIcons = { Common = "8b30dd5dc3e24064ad96799b4587ae5a", Rare = "a5dc4044efcd429cb053cf30b11f4d4b", Epic = "d8bc9682c6a849ab941993a36c0e7e5c", Unique = "78827f2a06c3403a9e0d78e8da58d402", Legendary = "0de959f44ddb4a7c8ab39c9db557d37b" } },  -- 하드우드완드/이블테일러/드래곤완드/우트가르드완드/아케인셰이드완드
		            dagger = { id = "dagger", label = "단도",   stat = "LUK", atk = {"ATK", "BATK"},  basePrice = 50000,  buyCost = 18000, icon = "11ccce1ca9224050897b2d59fe14a3bf",
		                gradeIcons = { Common = "623edb37903f49b5acb1517bb550d1fb", Rare = "77a92b6db90b458aa7bd60f203e061ca", Epic = "1965573dd25047c9a6ec6f6f42a298dd", Unique = "df8f87efb85e4df8afd56bda71b29a44", Legendary = "dac4563ba6ca4aa4a5cae9a93a6fcd66" } },  -- 필드대거/베즐러드/블러드대거/⭐녹스반레온대거/⭐앱솔랩스슬래셔
		        }
		        d.equipmentOrder = {"bow", "wand", "sword", "dagger", "staff"}
		
		        -- 무기 등급(상점) = "아이템 기본 판매가" 티어. 잠재능력 등급(gradeMult)과는 별개 차원이다.
		        --   같은 등급이면 무기 종류가 달라도 basePrice·buyCost가 동일하다(커먼 활 == 커먼 검 가격).
		        --   ⚠ key 이름(Rare/Epic/Unique/Legendary)이 잠재능력 등급(d.gradeProb/d.gradeMult)과 겹치나,
		        --     별개 테이블(weaponGrades vs gradeProb)이라 기능 충돌은 없다. 혼동 주의.
		        --   구매가(buyCost) = 기본판매가(basePrice) × 1.2 → 구매가 > 판매가. 큐브로 잠재를 안 올리면 손해
		        --     (도박 강제 경제, weapon_shop.md §7 / 초안 §7 비율 1.2). 시작메소 40000이면 초반엔 커먼만 구매 가능.
		        --   color = (레거시) 등급 색. 상점 슬롯 프레임은 이제 색 대신 image(희귀도 프레임 스프라이트)로 시각화한다.
		        --   image = 슬롯 프레임 희귀도 이미지(plain 스프라이트 RUID, thumbnail:// 없이 ImageRUID에 직접 설정). 사용자 제공 에셋.
		        --   prob = 상점 슬롯 추첨 확률(%). prob 합 100.
		        --   수치는 초기 기준안(weapon_shop.md §7·§9 참조) — 플레이테스트로 조정.
		        d.shopSlotCount = 3  -- 상점에 동시에 노출되는 무기 슬롯 수 (weapon_shop.md §4 기준: 3슬롯)
		        d.weaponGradeOrder = {"Common", "Rare", "Epic", "Unique", "Legendary"}
		        -- prob = 0단계(더좋은물품 미보유) 기본 등장 확률(%) — 무기 상점 기획서 §9 기준안(60/30/9/1/0, 합 100).
		        --   0단계에서는 레전더리 0%·유니크 1% — 상위 등급은 증강 '더 좋은 물품'(betterGoodsGradeProb)으로만 열린다.
		        d.weaponGrades = {
		    		Common    = { key = "Common",    label = "커먼",     basePrice = 25000,  buyCost = 30000,  prob = 60, color = {0.62, 0.64, 0.68}, image = "93b4517e8ad7439a9bc0756257e1454f"},
		            Rare      = { key = "Rare",      label = "레어",     basePrice = 45000,  buyCost = 54000,  prob = 30, color = {0.30, 0.58, 0.92}, image = "5882531c2b5841cbb68127cdb28cfe36" },
		            Epic      = { key = "Epic",      label = "에픽",     basePrice = 75000,  buyCost = 90000,  prob = 9,  color = {0.70, 0.40, 0.92}, image = "7afb7a9b2fb647e991dbbd51c370a8d3"},
		            Unique    = { key = "Unique",    label = "유니크",   basePrice = 120000, buyCost = 150000, prob = 1,  color = {0.96, 0.80, 0.22}, image = "84bfdd28bcf1441cbff9dc8879c9cede"  },
		            Legendary = { key = "Legendary", label = "레전더리", basePrice = 210000, buyCost = 260000, prob = 0,  color = {0.40, 0.85, 0.45}, image = "f914e97740fd473ea2f3ace6dd247e10" },
				}
		
		        -- 증강 '더 좋은 물품 들여오기' 단계별 상점 등급 절대 확률표 (blacksmith_upgrade.md §6).
		        --   0단계(미보유) = 위 weaponGrades.prob(30/30/28/10/2). 각 표의 합은 100.
		        --   1단계는 레전더리 0% — RollWeaponGrade가 0 가중치를 허용하므로 그대로 동작한다.
		        d.betterGoodsGradeProb = {
		            [1] = { Common = 45, Rare = 40, Epic = 12, Unique = 3,  Legendary = 0 },
		            [2] = { Common = 30, Rare = 42, Epic = 19, Unique = 7,  Legendary = 2 },
		            [3] = { Common = 18, Rare = 38, Epic = 27, Unique = 13, Legendary = 4 },
		        }
		
		        -- 빚 상환 (concept §6-3, flow §15, finance_management.md 상환액 스케줄)
		        d.debtCycle = 5                                -- N회 큐브 사용마다 상환
		        d.debtTable = {50000, 100000, 200000, 450000}   -- 1~4주 금액
		        d.debtGrowth = 1.1                             -- 테이블 범위 밖(5주~)은 매주 ×1.1
		        d.winStage = 5                                 -- 상환 N회 성공 시 승리
		
		        -- ── 대장 기술(증강) (blacksmith_upgrade.md §5·§6) ──────────────────────────
		        --   증강은 상환 단계 도달 시 3택 1로 획득(MVP 트리거). 같은 증강 중복 시 단계 상승(최대 3).
		        --   3단계 소진 증강은 이후 선택지에 등장하지 않는다(§5).
		        --   stages[stage] = 해당 단계의 효과 수치. type/applyTarget은 효과 배선 위치를 가리킨다.
		        --   ⚠ 기획서는 단계별 수치를 "소폭/증가/크게"로만 명시 → 아래는 코드 측 기준안(플레이테스트로 조정).
		        d.augmentMaxStage = 3      -- 한 증강당 최대 단계 (§5: 3단계까지만 등장)
		        d.augmentChoiceCount = 3   -- 획득 시 제시하는 무작위 선택지 수 (§4-4: 3개)
		        d.augmentOrder = {"betterGoods", "smithEye", "priceNego", "riskyDeal", "innateGrade", "recycleExpert"}
		        -- 증강 구매 비용 = 증강이 '도달할 단계' 기준(단계 높을수록 비쌈). (blacksmith_upgrade.md §3)
		        --   구매 방식(유저 확정): 로비 '대장 기술' → 3택 창 → 각 증강 하단의 구매 골드로 즉시 지불.
		        --   1단계 7,500 / 2단계 12,500 / 3단계 20,000. 범위 밖은 마지막 값으로 클램프.
		        d.augmentCosts = {30000, 70000, 150000}
		        -- icon: 증강 아이콘 스프라이트 RUID(증강 UI 슬롯/보유 목록). plain 스프라이트라 thumbnail:// 접두사 없이
		        --   ImageRUID에 직접 설정한다(cubes.icon 패턴). msw-search로 확보한 메이플 공식 아이템 아이콘.
		        d.augments = {
		            -- 더 좋은 물품 들여오기: 상점에 높은 등급 무기가 등장할 확률 증가 (§6, 적용=RollShop)
		            --   ⚠ 효과는 배수가 아니라 단계별 절대 확률표(d.betterGoodsGradeProb)로 적용된다.
		            --     stages는 단계 표기용(1/2/3)일 뿐 수치 의미 없음 — RollShop이 보유 단계를 직접 넘긴다.
		            betterGoods = { key = "betterGoods", name = "더 좋은 물품 들여오기", type = "shopGrade",
		                applyTarget = "RollShop", desc = "무기 상점에 높은 등급 무기가 등장할 확률 증가",
		                stages = {1, 2, 3}, icon = "c3c4aca456474afe9602518db5c21abe" },  -- 금은보화(보물상자)
		            -- 대장장이의 눈: 현재 무기와 맞는 유효 옵션 등장 확률 증가 (§6, 적용=RollLine)
		            --   stages = 주요 옵션 1줄이 '유효 옵션'으로 강제될 확률(%). 10/20/45 (blacksmith_upgrade.md §6).
		            smithEye = { key = "smithEye", name = "대장장이의 눈", type = "validOption",
		                applyTarget = "RollLine", desc = "현재 무기의 유효 옵션 등장 확률 증가",
		                stages = {15, 30, 45}, icon = "2c87d6385a60420ab55fa8d36ff3d6dc" },  -- 감정 돋보기
		            -- 가격 협상: 무기 구매가 감소, 게임 끝까지 유지 (§6, 적용=RequestBuyItem)
		            --   stages = 구매가 감소율(%). 10/18/40 (blacksmith_upgrade.md §6).
		            priceNego = { key = "priceNego", name = "가격 협상", type = "buyCost",
		                applyTarget = "RequestBuyItem", desc = "무기 구매가 감소",
		                stages = {10, 18, 30}, icon = "0bc56bdb2ba54b3dbdf43ff07cddb57f" },  -- 돈 주머니
		            -- 위험 거래: 상환 이자 증가 + 판매가 증가(고위험 고수익) (§6, 적용=Pricing+Debt)
		            --   stages = 판매가/상환이자 동시 증가율(%). 10/20/30.
		            riskyDeal = { key = "riskyDeal", name = "위험 거래", type = "riskReward",
		                applyTarget = "Pricing+Debt", desc = "상환 이자 증가, 대신 판매가 증가",
		                stages = {10, 18, 30}, icon = "8114bc5eeba544989e14a8e46a1ea0f2" },  -- 시한폭탄
		            -- 귀한 태생: 큐브 사용 시 높은 잠재 등급이 등장할 확률 증가 (적용=RollGrade, cubeGradeProb 단계표)
		            --   ⚠ 효과는 배수가 아니라 단계별 절대 확률표(d.cubeGradeProb). stages는 단계 표기용(1/2/3)일 뿐 수치 의미 없음.
		            --   ⚠ 트레이드오프: 단계가 오를수록 큐브 구매가(d.cubes.*.costs)도 상승한다(유저 지정).
		            innateGrade = { key = "innateGrade", name = "귀한 태생", type = "cubeGrade",
		                applyTarget = "RollGrade", desc = "더 좋은 등급의 복권을 뽑을 확률이 증가합니다",
		                stages = {1, 2, 3}, icon = "9eca66ef45a94dbd8048e45c6307e2c9" },  -- 큐브 결정(귀한 결정)
		            -- 재활용 전문가: 큐브 사용 시 확률로 사용 횟수 차감 방지 (§6, 적용=DoUseCube)
		            --   stages = 차감 방지 확률(%). 10/20/35 (blacksmith_upgrade.md §6).
		            --   메소는 정상 차감(유저 확정) — 시계 카운트·상환 카운트만 오르지 않는다.
		            recycleExpert = { key = "recycleExpert", name = "재활용 전문가", type = "cubeSave",
		                applyTarget = "DoUseCube", desc = "큐브 사용 시 일정 확률로 사용 횟수 차감 방지",
		                stages = {10, 20, 35}, icon = "3fd4b286ba544158aa863c2f02983495" },  -- 마법의 모래시계
		        }
		
		        -- ── 재정 관리 (finance_management.md) ─────────────────────────────────────
		        -- 메소 대출 서비스 (§2·§3, 필수 구현). 사용 횟수는 확정값 1회.
		        --   대출 금액은 고정값이 아니라 '현재 상환 필요 메소'에 동적 연동한다(유저 확정):
		        --   지급 메소 = 현재 상환 필요 메소, 빚도 그만큼 증가 → 상환 시 '상환금 + 빚'을 한 번에 청구.
		        --   (금액 계산은 GameManager:GetCurrentRepayment(). 여기선 사용 횟수 제한만 상수로 둔다.)
		        d.loan = {
		            maxUses = 1,          -- 한 게임당 대출 가능 횟수 (확정: 1회)
		        }
		        -- 골드리치 은행 저축 (§6~§8, 후순위 — 데이터만 준비, 로직은 미구현).
		        --   '하루' = 상환 주기 1회(= DebtStage 증가) 기준(A안: 일차 = DebtStage+1).
		        d.savings = {
		            minDeposit = 10000,   -- 최소 저축 금액 (§8)
		            dailyRate = 5,        -- 상환 1회(하루)당 이자율(%) (§8)
		        }

		        -- ── 시즌 패스 (docs/specs/seasonpass.md §12·§15·§16) ──────────────────────
		        --   미션 판정은 서버 범용 엔진(GameManager:CheckSeasonMissions)이 statKey로 세션 통계를 직접 읽는다:
		        --     s[statKey] >= target 이면 자동 클리어 + reward 점수 지급(§8 자동 지급, 유저 확정).
		        --   statKey는 GameManager 세션 테이블의 필드명(SSOT) — 이름 변경 시 세션 필드와 함께 바꿔야 한다.
		        --   rewards = 점수 오름차순 배열(0점 포함 5지점 — 컨셉 아트 5열, 유저 확정). 보상은 표시 전용(§13 지급 미구현).
		        --     icon = 완성 ImageRUID 문자열(아바타 아이템이면 "thumbnail://" 접두 포함해 저장) — 클라가 그대로 대입.
		        d.seasonPass = {
		            maxScore = 4000,   -- 게이지 최대 표시 점수 (§10)
		            missionOrder = {"cube3", "sell1", "bigSale", "totalSale", "destroy1", "debt1"},
		            missions = {
		                cube3     = { key = "cube3",     name = "큐브 맛보기",      desc = "이상한 큐브 3회 사용",              statKey = "WeirdCubeUseCount", target = 3,      reward = 300 },
		                sell1     = { key = "sell1",     name = "첫 판매 성공",     desc = "무기 1회 판매",                     statKey = "TotalSellCount",    target = 1,      reward = 200 },
		                bigSale   = { key = "bigSale",   name = "제법 괜찮은 거래", desc = "1회 판매 금액 100,000 메소 달성",   statKey = "MaxSellPrice",      target = 100000, reward = 500 },
		                totalSale = { key = "totalSale", name = "장사의 감각",      desc = "총 누적 판매 금액 300,000 메소 달성", statKey = "TotalSellAmount", target = 300000, reward = 700 },
		                destroy1  = { key = "destroy1",  name = "아찔한 실패",      desc = "장비 파괴 1회 경험",                statKey = "DestroyCount",      target = 1,      reward = 300 },
		                debt1     = { key = "debt1",     name = "빚은 갚아야지",    desc = "빚 상환 1회 성공",                  statKey = "DebtStage",         target = 1,      reward = 400 },
		            },
		            rewards = {
		                -- icon 출처(msw-search): 증표=명예의 훈장(plain sprite) / 앞치마=Chef Overall / 고글=고글 블랙캡 /
		                --   망치=강철구 망치 / 세트=블루 오버롤(전부 avataritem → thumbnail:// 접두 완성 문자열).
		                { score = 0,    name = "견습 대장장이 증표",   icon = "3868621aa4004fb98804fc8774f1daa5" },
		                { score = 1000, name = "작업용 앞치마",        icon = "thumbnail://ca24091d534449388c01c5929cdcffae" },
		                { score = 2000, name = "장인의 고글",          icon = "thumbnail://f3050f75313d423bb5386f3664a8e375" },
		                { score = 3000, name = "빛나는 망치",          icon = "thumbnail://afa0b6e01e5c41d29789796905547bcd" },
		                { score = 4000, name = "뒷골목 대장장이 세트", icon = "thumbnail://237cd883e7134b65b7af11ffd9f14e5d" },
		            },
		        }

		        self.Data = d
	end

	method any GetData()
		        -- 전체 설정 테이블 반환(지연 구축).
		        if self.Data == nil then self:BuildData() end
		        return self.Data
	end

	method any GetEquipment(string id)
		        -- 장비 1종 정의 반환. 알 수 없는 id면 nil.
		        return self:GetData().equipment[id]
	end

	method any GetEquipmentOrder()
		        -- 구매/표시 순서의 장비 id 배열.
		        return self:GetData().equipmentOrder
	end

	method string GetWeaponIcon(string equipId, string grade)
		        -- 무기 아이콘 RUID(표시용 SSOT): 등급별 아이콘(gradeIcons) 우선, 없으면 종류 기본 icon 폴백.
		        --   렌더 사이트(상점 슬롯/상세/판매 결과창)가 이 값을 "thumbnail://" 접두사와 함께 사용한다.
		        local eq = self:GetEquipment(equipId)
		        if eq == nil then return "" end
		        if eq.gradeIcons ~= nil and grade ~= nil and eq.gradeIcons[grade] ~= nil then
		            return eq.gradeIcons[grade]
		        end
		        return eq.icon
	end

	method any GetWeaponGrade(string key)
		        -- 무기 등급 1종 정의 반환(basePrice/buyCost/color/label). 알 수 없는 key면 nil.
		        return self:GetData().weaponGrades[key]
	end

	method any GetCube(string key)
		        -- 큐브 1종 정의 반환(costs/allowDestroy/icon/label). 알 수 없는 key면 nil.
		        return self:GetData().cubes[key]
	end

	method integer GetCubeCost(string cubeKey, integer gradeStage)
		        -- 큐브 1개 구매 가격. 증강 '귀한 태생'(innateGrade) 단계(0~3)에 연동한다(유저 지정 트레이드오프).
		        --   index = gradeStage + 1, costs 배열 범위로 클램프. 미존재 큐브면 0.
		        local c = self:GetData().cubes[cubeKey]
		        if c == nil or c.costs == nil then return 0 end
		        local i = (gradeStage or 0) + 1
		        if i < 1 then i = 1 end
		        if i > #c.costs then i = #c.costs end
		        return c.costs[i]
	end

	method any GetWeaponGradeOrder()
		        -- 무기 등급 표시/추첨 순서 배열(낮은 등급 → 높은 등급).
		        return self:GetData().weaponGradeOrder
	end

	method any GetShopGradeProbTable(integer betterGoodsStage)
		        -- 상점 등급 확률표 반환 {gradeKey=확률(%)}. (blacksmith_upgrade.md §6)
		        --   0단계(미보유) = weaponGrades.prob 기본표, 1~3단계 = betterGoodsGradeProb 절대 확률표.
		        --   범위 초과 단계는 최대 단계 표로 클램프. 각 표의 합은 100이라 값이 곧 %다.
		        local d = self:GetData()
		        if betterGoodsStage >= 1 then
		            local n = #d.betterGoodsGradeProb
		            local stage = betterGoodsStage
		            if stage > n then stage = n end
		            return d.betterGoodsGradeProb[stage]
		        end
		        local base = {}
		        for _, key in ipairs(d.weaponGradeOrder) do
		            base[key] = d.weaponGrades[key].prob
		        end
		        return base
	end

	method any GetCubeGradeProbTable(integer innateGradeStage)
		        -- 잠재 등급 확률표 반환 {gradeKey=확률(%)}. (blacksmith_upgrade.md §6, GetShopGradeProbTable 패턴)
		        --   0단계(증강 '귀한 태생' 미보유) = gradeProb 기본표, 1~3단계 = cubeGradeProb 절대 확률표.
		        --   범위 초과 단계는 최대 단계 표로 클램프. 각 표의 합은 100이라 값이 곧 %다.
		        local d = self:GetData()
		        if innateGradeStage >= 1 then
		            local n = #d.cubeGradeProb
		            local stage = innateGradeStage
		            if stage > n then stage = n end
		            return d.cubeGradeProb[stage]
		        end
		        return d.gradeProb
	end

	method any RollWeaponGradeDetail(integer betterGoodsStage)
		        -- 등급 확률표로 무기 등급 1개를 추첨하고 추첨 상세를 반환한다(서버 권위 추첨에서 호출).
		        -- betterGoodsStage: 증강 '더 좋은 물품' 보유 단계(0=미보유). 단계별 절대 확률표를 사용한다.
		        --   가중치를 재정규화해 확률로 환산하므로 표의 합이 100이 아니어도 동작한다(0 가중치 허용).
		        -- 반환: { grade = 등급 key, roll = 실제 뽑힌 랜덤 값(0~total), total = 가중치 총합(보통 100) }
		        --   roll은 등급 누적 구간과 비교해 "몇이 떠서 이 등급이 나왔는지" 로그 표기에 쓰인다.
		        local d = self:GetData()
		        local weights = self:GetShopGradeProbTable(betterGoodsStage)
		        local total = 0
		        for _, key in ipairs(d.weaponGradeOrder) do
		            total = total + weights[key]
		        end
		        if total <= 0 then
		            return { grade = d.weaponGradeOrder[1], roll = 0, total = 0 }
		        end
		        local roll = _UtilLogic:RandomDouble() * total
		        local acc = 0
		        for _, key in ipairs(d.weaponGradeOrder) do
		            acc = acc + weights[key]
		            if roll <= acc then
		                return { grade = key, roll = roll, total = total }
		            end
		        end
		        return { grade = d.weaponGradeOrder[#d.weaponGradeOrder], roll = roll, total = total }  -- 폴백(부동소수 오차 대비)
	end

	method string RollWeaponGrade(integer betterGoodsStage)
		        -- 등급 key만 필요한 호출부용 래퍼(분포 테스트 등). 상세는 RollWeaponGradeDetail 참조.
		        local r = self:RollWeaponGradeDetail(betterGoodsStage)
		        return r.grade
	end

	method number GetGradeMultiplier(string grade)
		        -- 등급 판매가 배수.
		        return self:GetData().gradeMult[grade]
	end

	method number GetBonusMultiplier(integer count)
		        -- 유효 이탈 개수별 배수 (0~3 범위로 클램프).
		        local t = self:GetData().bonusMult
		        if count > 3 then count = 3 end
		        if count < 0 then count = 0 end
		        return t[count]
	end

	method boolean IsValidMain(string equipId, string optionName)
		        -- 주요 옵션이 해당 장비에 유효한지 판정. 보스공격력(BATK)은 항상 유효. (pricing §8)
		        local eq = self:GetEquipment(equipId)
		        if eq == nil then return false end
		        local opt = self:GetData().mainOptions[optionName]
		        if opt == nil then return false end
		        if opt.group == "MainStat" then
		            return optionName == eq.stat
		        elseif opt.group == "Attack" then
		            for _, a in ipairs(eq.atk) do
		                if a == optionName then return true end
		            end
		            return false
		        end
		        return false
	end

	method integer GetDebtAmount(integer stage)
		        -- 상환 단계(주차)별 금액(1부터). debtTable 범위를 넘으면 매주 ×debtGrowth(10% 증가), 1000단위 반올림.
		        -- (finance_management.md 상환액 스케줄 SSOT)
		        local d = self:GetData()
		        if stage < 1 then return 0 end
		        local n = #d.debtTable
		        if stage <= n then return d.debtTable[stage] end
		        local amount = d.debtTable[n] * (d.debtGrowth ^ (stage - n))
		        return math.floor(amount / 1000 + 0.5) * 1000
	end

	method any GetAugment(string key)
		        -- 증강 1종 정의 반환(name/type/applyTarget/stages). 알 수 없는 key면 nil.
		        return self:GetData().augments[key]
	end

	method any GetAugmentOrder()
		        -- 증강 표시/추첨 순서 key 배열.
		        return self:GetData().augmentOrder
	end

	method number GetAugmentStageValue(string key, integer stage)
		        -- 증강의 특정 단계 효과 수치 반환. 단계 범위를 벗어나면 클램프. 없으면 0.
		        local a = self:GetData().augments[key]
		        if a == nil then return 0 end
		        local n = #a.stages
		        if stage < 1 then return 0 end
		        if stage > n then stage = n end
		        return a.stages[stage]
	end

	method integer GetAugmentCost(integer stage)
		        -- 증강 구매 비용(도달할 단계 기준). 서버·클라 공용(클라 가격 표시용, ExecSpace 없음).
		        --   stage = 이 구매로 도달하는 단계(현재단계+1). 범위 밖은 마지막 값으로 클램프. (blacksmith_upgrade.md §3)
		        local costs = self:GetData().augmentCosts
		        local n = #costs
		        if stage < 1 then stage = 1 end
		        if stage > n then stage = n end
		        return costs[stage]
	end

	method any GetLoanConfig()
		        -- 메소 대출 상수(payout/repayMultiplier/maxUses).
		        return self:GetData().loan
	end

	method any GetSeasonPass()
		        -- 시즌 패스 설정(maxScore/missionOrder/missions/rewards) 반환. 서버·클라 공용(SSOT).
		        return self:GetData().seasonPass
	end

end