@Logic
script GameManager extends Logic
    -- 커닝시티 뒷골목 대장장이 — 플레이어 상태 관리자(서버 권위).
    -- 멀티 클라이언트 대응: 서버 진실은 userId별 세션 테이블(self.Sessions)에만 존재한다.
    --   아래 property들은 각 클라이언트의 "내 세션 미러" — 서버가 targeted Client RPC(ApplySessionState,
    --   call-site 마지막 인자 = targetUserId)로 해당 유저에게만 밀어넣는다. @Sync(전 클라 브로드캐스트) 미사용.
    -- 모든 상태 변경은 서버에서만 일어나고(클라 입력 불신), 각 Server RPC 말미의 PushState 1회로 미러가 갱신된다.
    -- 클라이언트 UI는 기존처럼 이 property들을 폴링하면 된다(값이 "내 세션"만 반영).

    property integer Meso = 0            -- 보유 메소
    property string CurrentItemId = ""   -- 현재 보유 아이템(장비 id). 없으면 ""
    property integer CubeUseCount = 0    -- 누적 큐브 사용 횟수 ([6])
    -- 이번 주(현재 상환 단계) 큐브 사용 횟수. 상환 성공 시 0 리셋. HUD 시계 "n/N"의 n.
    --   주기가 주차별 가변(debtCycles 5/6/6/7/7)이라 누적 % 연산 대신 이 카운터로 상환 경계를 판정한다.
    property integer WeekCubeCount = 0
    property integer DebtStage = 0       -- 완료한 상환 단계 ([7])
    property boolean IsGameOver = false  -- 게임 오버 여부 ([7])
    -- 게임오버 원인(게임오버 UI '사망 원인' 표시용). "" = 게임오버 아님.
    --   "repayment"=상환액 미지불 / "debt"=빚 미지불 / "weapon"=무기 살 돈 부족 / "cube"=큐브 살 돈 부족
    property string GameOverReason = ""
    -- 승리 여부: 상환 winStage회(5주) 성공 시 true. (finance_management.md 승리 조건)
    property boolean IsVictory = false

    -- 빚 상환 상태 (concept §6-3, flow §15·§16)
    property integer CubesUntilRepayment = 0 -- 다음 상환까지 남은 큐브 횟수 ([6] HUD 표시용)
    property boolean IsRepaymentDue = false  -- 상환 시점 도달(미납) 여부
    property integer PendingRepayment = 0    -- 이번에 갚아야 할 금액

    -- 상점(무기 구매 UI) 상태.
    --   ShopSlots(서버 세션 필드): 서버 권위 슬롯 배열 {{equipId, grade}, ...} (세션 테이블에 보관).
    --   ShopSlotsData: 위 배열을 직렬화한 미러 문자열 "equipId:grade,equipId:grade,...". 클라가 파싱해 렌더.
    property string ShopSlotsData = ""

    -- 구매한 아이템의 무기 등급 정보(상점 등급 = 기본 판매가 티어). 판매가 계산의 base로 사용.
    property integer CurrentBasePrice = 0    -- 현재 아이템의 기본 판매가(구매 등급 basePrice)
    property string CurrentWeaponGrade = ""  -- 현재 아이템의 무기 등급 key(Common/Rare/Epic/Unique/Legendary)

    -- 현재 아이템의 잠재 결과 요약(HUD가 읽음). 옵션 3줄 전체는 세션의 CurrentPotential에 보관. (flow §8)
    property boolean HasPotential = false      -- 현재 아이템에 큐브를 1회 이상 사용했는지
    property string CurrentGrade = ""          -- 현재 잠재 등급(Rare/Epic/Unique/Legendary)
    property string CurrentResultType = ""     -- 조합 판정 결과(연출용 RAW 문자열)
    property integer CurrentPrice = 0          -- 현재 예상 판매가(파괴 시 0)
    property boolean IsCurrentDestroyed = false -- 현재 아이템 파괴 여부 (flow §14)
    -- 현재 판매가가 어떤 계산으로 나왔는지 사람이 읽는 수식 문자열(디버그/로그용). 파괴 시 "".
    --   서버가 RequestUseCube에서 PricingCalculator breakdown으로 1회 조립 → 미러로 클라(스크래치 로그)에 전달.
    property string CurrentPriceFormula = ""

    -- 옵션 3줄을 클라(스크래치 UI)에 전달하기 위한 직렬화 문자열(ShopSlotsData와 동일 패턴).
    --   포맷: "grade;line;line;line", line = "label|value|unit|optionType|isBonus|isDestroy|isValid".
    --   isValid는 서버가 IsValidMain(현재장비, optionName)으로 계산(클라 신뢰 안 함). 없으면 "".
    property string CurrentPotentialData = ""

    -- ── 판매 통계(게임오버 기록용, flow §게임 오버 표시 정보) ──
    property integer TotalSellCount = 0   -- 판매 성공 누적 횟수
    property integer MaxSellPrice = 0     -- 한 번에 가장 비싸게 판 금액

    -- ── 시즌 패스 (docs/specs/seasonpass.md) ──
    --   미션은 서버 자동 클리어(CheckSeasonMissions — config statKey 주도), 보상은 표시 전용(§13 지급 미구현).
    --   SeasonMissionsData: "key:progress:cleared,..." — missionOrder 순 6토큰 고정 CSV(클라 파싱 단순화).
    --     progress는 target으로 클램프, 클리어 미션은 target 고정(재시작 후 통계 리셋돼도 완료 표기 유지).
    --   판정용 통계(WeirdCubeUseCount/TotalSellAmount/DestroyCount)는 서버 전용 — 미러엔 이 CSV만 싣는다.
    property integer SeasonScore = 0        -- 시즌 패스 총점(미션 보상 합)
    property string SeasonMissionsData = "" -- 미션 진행/클리어 미러 CSV

    -- ── 2단계 판매(판매 확정 → 수령하기) (cube_scratch_system §11) ──
    --   판매 버튼 → RequestSellItem: 즉시 지급하지 않고 IsSalePending으로 전환(아이템/잠재 유지).
    --   판매 결과 창의 '수령하기' → RequestCollectSale: 이때 메소 지급 + 아이템 정리.
    property boolean IsSalePending = false   -- 판매 확정 후 수령 대기 여부
    property integer PendingSalePrice = 0    -- 수령 대기 금액(확정 판매가)
    property string PendingSaleItemId = ""   -- 결과 창 무기 아이콘용(판매된 장비 id)

    -- ── 일차(A안): 별도 시간 시스템 없이 DebtStage로 표시. 일차 = DebtStage + 1 ──

    -- ── 대장 기술(증강) 상태 (blacksmith_upgrade.md) ──
    --   OwnedAugments(서버 세션 필드): 서버 권위 {key = stage} 테이블(세션 테이블에 보관).
    --   AugmentsData: "key:stage,key:stage,..." 직렬화 미러(ShopSlotsData 패턴).
    property string AugmentsData = ""
    -- 획득 시 제시하는 3택 선택지(key CSV) + 대기 여부. 선택 전까지 유지.
    property string AugmentChoicesData = ""
    property boolean IsAugmentPending = false
    -- 증강 '재활용 전문가' 발동 누적 횟수. 클라(HudManager)가 증가 에지를 감지해 시계 되감기 연출을 재생.
    property integer RecycleProcCount = 0

    -- ── 재정 관리: 메소 대출 (finance_management.md) ──
    property integer LoanUseCount = 0      -- 사용한 대출 횟수
    property boolean CanLoan = false       -- 현재 대출 가능 여부(서버 판정, HUD/버튼 게이팅용)
    -- 대출로 누적된 갚아야 할 빚. 상환 시점(5/5)에 '상환 필요 메소 + 이 빚'을 전부 갚아야 다음 라운드 진행.
    property integer Debt = 0

    -- ── 로비 상태(전이 API) ──
    --   현재 어떤 활동에 있는지 서버 권위 상태. UI/맵이 이 값을 읽어 전환. (lobby_hub.md)
    --   "lobby" / "cube" / "augment" / "finance" / "seasonpass"
    property string CurrentActivity = "lobby"

    -- ═══════════════ 서버 전용 상태 ═══════════════

    -- userId → 세션 테이블. 서버 진실의 유일한 저장소(CreateSessionTable 참조). 서버에서만 접근.
    property any Sessions = nil

    -- 게임오버 누적 기록용 DataStorage 핸들(OnBeginPlay에서 획득). Credit 절약 위해 게임오버 시에만 접근.
    property any recordStorage = nil

    -- 클라 로컬: 초기 미러 동기화 핸드셰이크 요청 여부(RequestInitialSync 1회 가드).
    property boolean initialSyncRequested = false

    -- ═══════════════ 라이프사이클 ═══════════════

    @ExecSpace("ServerOnly")
    method void OnBeginPlay()
        -- 게임오버 기록용 영구 저장 핸들 준비 + 세션 저장소 초기화. Get*DataStorage는 ServerOnly.
        --   handle 획득 자체는 Credit 0(None 그룹). 실제 Set/Get는 게임오버 시점에만.
        -- 세션 생성은 여기서 하지 않는다 — 유저 입장(HandleUserEnterEvent)/핸드셰이크에서 유저별로 생성.
        self.recordStorage = _DataStorageService:GetGlobalDataStorage("BlacksmithRecords")
        self.Sessions = {}
        log("[GameManager] server ready (per-user sessions)")
    end

    @ExecSpace("ClientOnly")
    method void OnUpdate(number delta)
        -- 초기 미러 동기화 핸드셰이크: 입장 완료(LocalPlayer 유효) 후 첫 프레임에 1회 서버에 push를 요청한다.
        --   클라 발신이므로 응답(ApplySessionState) 시점에 수신 가능 상태가 보장된다(입장 순서 레이스 차단).
        if self.initialSyncRequested then return end
        if not isvalid(_UserService.LocalPlayer) then return end
        self.initialSyncRequested = true
        self:RequestInitialSync()
    end

    @ExecSpace("ServerOnly")
    @EventSender("Service", "UserService")
    handler HandleUserEnterEvent(UserEnterEvent event)
        -- 유저 입장 = 새 세션 시작(제품 결정: 재접속도 새 게임). 미러 push는 하지 않는다 —
        --   클라 스크립트 로드 전이면 유실될 수 있어 초기 동기화는 RequestInitialSync로 일원화.
        self:ResetSessionFor(event.UserId)
    end

    @ExecSpace("ServerOnly")
    @EventSender("Service", "UserService")
    handler HandleUserLeaveEvent(UserLeaveEvent event)
        -- 유저 퇴장 = 세션 폐기(재접속 = 새 게임, 서버 메모리 정리).
        if self.Sessions ~= nil then
            self.Sessions[event.UserId] = nil
        end
        log("[GameManager][u:" .. string.sub(event.UserId, 1, 8) .. "] session dropped (user left)")
    end

    -- ═══════════════ 세션 인프라 (per-user) ═══════════════

    method string Tag(table s)
        -- 서버 로그 접두: 어느 유저 세션의 로그인지 식별(멀티클라 검증의 핵심 관측 수단).
        local uid = tostring(s.UserId or "?")
        return "[GameManager][u:" .. string.sub(uid, 1, 8) .. "] "
    end

    @ExecSpace("ServerOnly")
    method table CreateSessionTable()
        -- 한 판의 전체 시작 상태 테이블을 생성한다. 설정은 BlacksmithConfig가 SSOT.
        -- 미러 33개 스칼라 + 서버 전용 중첩 필드(ShopSlots/CurrentPotential/OwnedAugments) + UserId(생성자가 채움).
        local d = _BlacksmithConfig:GetData()
        return {
            Meso = d.startMeso,
            CurrentItemId = "",
            CubeUseCount = 0,
            WeekCubeCount = 0,
            DebtStage = 0,
            IsGameOver = false,
            GameOverReason = "",
            IsVictory = false,
            CubesUntilRepayment = 0,
            IsRepaymentDue = false,
            PendingRepayment = 0,
            ShopSlotsData = "",
            CurrentBasePrice = 0,
            CurrentWeaponGrade = "",
            HasPotential = false,
            CurrentGrade = "",
            CurrentResultType = "",
            CurrentPrice = 0,
            IsCurrentDestroyed = false,
            CurrentPriceFormula = "",
            CurrentPotentialData = "",
            TotalSellCount = 0,
            MaxSellPrice = 0,
            SeasonScore = 0,
            SeasonMissionsData = "",
            IsSalePending = false,
            PendingSalePrice = 0,
            PendingSaleItemId = "",
            AugmentsData = "",
            AugmentChoicesData = "",
            IsAugmentPending = false,
            RecycleProcCount = 0,
            LoanUseCount = 0,
            CanLoan = false,
            Debt = 0,
            CurrentActivity = "lobby",
            -- 서버 전용 스칼라(시즌 패스 미션 판정 통계 — 미러/PushState 제외, 진행도는 SeasonMissionsData로만 전달)
            WeirdCubeUseCount = 0,   -- 이상한 큐브 사용 횟수(재활용 발동 무관 — CubeUseCount와 의미 다름)
            TotalSellAmount = 0,     -- 누적 판매 금액
            DestroyCount = 0,        -- 장비 파괴 경험 횟수
            -- 서버 전용 중첩(미러/PushState에 절대 포함 금지 — cross-space 전송 불가)
            ShopSlots = nil,
            CurrentPotential = nil,
            OwnedAugments = {},
            SeasonMissions = {},     -- 클리어된 시즌 미션 {key = true}
        }
    end

    @ExecSpace("ServerOnly")
    method table GetSession(string userId)
        -- userId의 세션을 반환. 없으면 lazy 생성(입장 이벤트를 놓친 경로 대비 안전망).
        if self.Sessions == nil then self.Sessions = {} end
        if self.Sessions[userId] == nil then
            self:ResetSessionFor(userId)
        end
        return self.Sessions[userId]
    end

    @ExecSpace("ServerOnly")
    method void ResetSessionFor(string userId)
        -- 해당 유저의 한 판 전체 상태를 시작값으로 초기화한다. 입장 + RequestRestart 공용 (flow §5).
        -- DataStorage 누적 기록(recordStorage)은 여기서 건드리지 않는다.
        if self.Sessions == nil then self.Sessions = {} end
        local s = self:CreateSessionTable()
        s.UserId = userId
        self.Sessions[userId] = s
        self:UpdateRepaymentCountdown(s)  -- 시작 시 '다음 상환까지 남은 큐브' 표시 (flow §5-4)
        self:ResetPotentialState(s)
        self:RollShop(s)                  -- 시작 시 상점 슬롯 구성 (concept §6-1)
        self:RollAugmentChoices(s)        -- 시작부터 대장 기술 3택 준비(구매형 상시 진입). blacksmith_upgrade.md §4
        self:UpdateCanLoan(s)
        self:SerializeSeasonMissions(s)   -- 시즌 패스 CSV를 6토큰으로 채워 초기 PushState부터 클라 파싱 성립
        log(self:Tag(s) .. "session start. meso=" .. tostring(s.Meso)
            .. ", nextRepayIn=" .. tostring(s.CubesUntilRepayment))
    end

    @ExecSpace("ServerOnly")
    method void PushState(string userId)
        -- 세션의 미러 33개 스칼라를 flat table로 복사해 해당 유저 클라에만 전송한다(targeted Client RPC).
        -- ⚠ 화이트리스트 명시 복사만 허용 — 중첩 테이블(ShopSlots 등)·UserId는 절대 포함 금지.
        local s = self:GetSession(userId)
        local state = {
            Meso = s.Meso,
            CurrentItemId = s.CurrentItemId,
            CubeUseCount = s.CubeUseCount,
            WeekCubeCount = s.WeekCubeCount,
            DebtStage = s.DebtStage,
            IsGameOver = s.IsGameOver,
            GameOverReason = s.GameOverReason,
            IsVictory = s.IsVictory,
            CubesUntilRepayment = s.CubesUntilRepayment,
            IsRepaymentDue = s.IsRepaymentDue,
            PendingRepayment = s.PendingRepayment,
            ShopSlotsData = s.ShopSlotsData,
            CurrentBasePrice = s.CurrentBasePrice,
            CurrentWeaponGrade = s.CurrentWeaponGrade,
            HasPotential = s.HasPotential,
            CurrentGrade = s.CurrentGrade,
            CurrentResultType = s.CurrentResultType,
            CurrentPrice = s.CurrentPrice,
            IsCurrentDestroyed = s.IsCurrentDestroyed,
            CurrentPriceFormula = s.CurrentPriceFormula,
            CurrentPotentialData = s.CurrentPotentialData,
            TotalSellCount = s.TotalSellCount,
            MaxSellPrice = s.MaxSellPrice,
            SeasonScore = s.SeasonScore,
            SeasonMissionsData = s.SeasonMissionsData,
            IsSalePending = s.IsSalePending,
            PendingSalePrice = s.PendingSalePrice,
            PendingSaleItemId = s.PendingSaleItemId,
            AugmentsData = s.AugmentsData,
            AugmentChoicesData = s.AugmentChoicesData,
            IsAugmentPending = s.IsAugmentPending,
            RecycleProcCount = s.RecycleProcCount,
            LoanUseCount = s.LoanUseCount,
            CanLoan = s.CanLoan,
            Debt = s.Debt,
            CurrentActivity = s.CurrentActivity,
        }
        self:ApplySessionState(state, userId)
    end

    @ExecSpace("Client")
    method void ApplySessionState(table state)
        -- 서버가 내 세션 상태를 밀어넣는 수신부(targeted — 이 유저에게만 도착). 미러 property 일괄 갱신.
        self.Meso = state.Meso
        self.CurrentItemId = state.CurrentItemId
        self.CubeUseCount = state.CubeUseCount
        self.WeekCubeCount = state.WeekCubeCount
        self.DebtStage = state.DebtStage
        self.IsGameOver = state.IsGameOver
        self.GameOverReason = state.GameOverReason
        self.IsVictory = state.IsVictory
        self.CubesUntilRepayment = state.CubesUntilRepayment
        self.IsRepaymentDue = state.IsRepaymentDue
        self.PendingRepayment = state.PendingRepayment
        self.ShopSlotsData = state.ShopSlotsData
        self.CurrentBasePrice = state.CurrentBasePrice
        self.CurrentWeaponGrade = state.CurrentWeaponGrade
        self.HasPotential = state.HasPotential
        self.CurrentGrade = state.CurrentGrade
        self.CurrentResultType = state.CurrentResultType
        self.CurrentPrice = state.CurrentPrice
        self.IsCurrentDestroyed = state.IsCurrentDestroyed
        self.CurrentPriceFormula = state.CurrentPriceFormula
        self.CurrentPotentialData = state.CurrentPotentialData
        self.TotalSellCount = state.TotalSellCount
        self.MaxSellPrice = state.MaxSellPrice
        self.SeasonScore = state.SeasonScore
        self.SeasonMissionsData = state.SeasonMissionsData
        self.IsSalePending = state.IsSalePending
        self.PendingSalePrice = state.PendingSalePrice
        self.PendingSaleItemId = state.PendingSaleItemId
        self.AugmentsData = state.AugmentsData
        self.AugmentChoicesData = state.AugmentChoicesData
        self.IsAugmentPending = state.IsAugmentPending
        self.RecycleProcCount = state.RecycleProcCount
        self.LoanUseCount = state.LoanUseCount
        self.CanLoan = state.CanLoan
        self.Debt = state.Debt
        self.CurrentActivity = state.CurrentActivity
    end

    @ExecSpace("Server")
    method void RequestInitialSync()
        -- 접속 클라의 미러 초기화 핸드셰이크. GetSession이 lazy 생성을 겸한다(입장 이벤트 유실 대비).
        local s = self:GetSession(senderUserId)
        self:PushState(senderUserId)
        log(self:Tag(s) .. "initial sync pushed. meso=" .. tostring(s.Meso))
    end

    -- ═══════════════ 클라 미러 판독 헬퍼 (ExecSpace 없음 — 클라가 로컬 호출) ═══════════════
    -- ⚠ 서버 코드에서는 호출 금지 — 서버의 property 사본은 진실이 아니다. 서버는 ...Of(s) 변형을 쓴다.

    method boolean IsSessionEnded()
        -- 게임오버 또는 승리로 이번 판이 끝났는지(클라 미러 기준 공용 가드).
        return self.IsGameOver or self.IsVictory
    end

    method any GetCurrentEquipment()
        -- 현재 보유 아이템의 장비 정의 반환. 없으면 nil. (후속 단계/UI에서 사용)
        if self.CurrentItemId == "" then return nil end
        return _BlacksmithConfig:GetEquipment(self.CurrentItemId)
    end

    method integer GetCurrentDay()
        -- 일차 = 완료 상환 단계 + 1 (A안). 로비/HUD '현재 날짜' 표시용 계산 규약. (lobby_hub.md §4)
        return self.DebtStage + 1
    end

    method integer GetCurrentRepayment()
        -- 현재 '상환 필요 메소' 단일 진실값(클라 미러 판독).
        --   상환 미납(5/5)이면 실효 상환금 PendingRepayment, 아니면 다음 단계 원본 상환금 미리보기.
        --   HUD 표시·대출 금액·재정 정보가 모두 이 값을 SSOT로 쓴다(드리프트 방지). 서버는 GetCurrentRepaymentOf.
        if self.PendingRepayment > 0 then return self.PendingRepayment end
        return _BlacksmithConfig:GetDebtAmount(self.DebtStage + 1)
    end

    method integer GetSyncedAugmentStage(string key)
        -- 미러 AugmentsData("key:stage,...")에서 증강 단계 파싱. 미보유면 0.
        --   클라 UI(구매가 표시 등)가 서버와 동일한 결과를 내기 위한 판독 경로. ShopSlotsData 파싱 패턴.
        if self.AugmentsData == nil or self.AugmentsData == "" then return 0 end
        for token in string.gmatch(self.AugmentsData, "([^,]+)") do
            local k = string.match(token, "([^:]+):")
            local st = string.match(token, ":([^:]+)")
            if k == key then return tonumber(st) or 0 end
        end
        return 0
    end

    method integer GetEffectiveBuyCost(integer baseCost)
        -- 증강 '가격 협상' 구매가 감소(%) 적용. 1000단위 반올림. 미보유면 원가. (클라 미러 판독)
        --   미러 AugmentsData 기반이라 서버 차감액(GetEffectiveBuyCostOf)과 클라 표시값이 항상 일치한다.
        local stage = self:GetSyncedAugmentStage("priceNego")
        if stage <= 0 then return baseCost end
        local pct = _BlacksmithConfig:GetAugmentStageValue("priceNego", stage)
        if pct <= 0 then return baseCost end
        local reduced = baseCost * (1 - pct / 100)
        return math.floor(reduced / 1000 + 0.5) * 1000
    end

    method integer GetSyncedCubeCost(string cubeKey)
        -- 큐브 1개 실효 구매가(클라 미러 판독). 증강 '귀한 태생'(innateGrade) 단계에 연동.
        --   미러 AugmentsData 기반이라 서버 차감액(GetCubeCostOf)과 클라 표시값이 항상 일치한다.
        return _BlacksmithConfig:GetCubeCost(cubeKey, self:GetSyncedAugmentStage("innateGrade"))
    end

    -- ═══════════════ 서버 세션 판독 헬퍼 (...Of — 세션 테이블 기준) ═══════════════

    @ExecSpace("ServerOnly")
    method boolean IsSessionEndedOf(table s)
        -- 게임오버 또는 승리로 이번 판이 끝났는지(서버 세션 기준 공용 가드).
        return s.IsGameOver or s.IsVictory
    end

    @ExecSpace("ServerOnly")
    method integer GetCurrentDayOf(table s)
        -- 일차 = 완료 상환 단계 + 1 (A안). 서버 로그용.
        return s.DebtStage + 1
    end

    @ExecSpace("ServerOnly")
    method integer GetCurrentRepaymentOf(table s)
        -- 현재 '상환 필요 메소' 단일 진실값(서버 세션 기준). 클라 GetCurrentRepayment와 동일 규칙.
        if s.PendingRepayment > 0 then return s.PendingRepayment end
        return _BlacksmithConfig:GetDebtAmount(s.DebtStage + 1)
    end

    @ExecSpace("ServerOnly")
    method integer GetAugmentStageOf(table s, string key)
        -- 보유 증강의 현재 단계(0=미보유). 서버 권위 OwnedAugments 기준.
        if s.OwnedAugments == nil then return 0 end
        return s.OwnedAugments[key] or 0
    end

    @ExecSpace("ServerOnly")
    method number GetAugmentStageValueOf(table s, string key)
        -- 보유 중인 증강의 현재 단계 효과 수치. 미보유면 0. (효과 배선 공용 진입점)
        local stage = self:GetAugmentStageOf(s, key)
        if stage <= 0 then return 0 end
        return _BlacksmithConfig:GetAugmentStageValue(key, stage)
    end

    @ExecSpace("ServerOnly")
    method integer GetCubeCostOf(table s, string cubeKey)
        -- 큐브 1개 실효 구매가(서버 세션 기준). 증강 '귀한 태생'(innateGrade) 단계에 연동. GetSyncedCubeCost와 동일 공식.
        return _BlacksmithConfig:GetCubeCost(cubeKey, self:GetAugmentStageOf(s, "innateGrade"))
    end

    @ExecSpace("ServerOnly")
    method integer GetEffectiveBuyCostOf(table s, integer baseCost)
        -- 증강 '가격 협상' 구매가 감소(%) 적용(서버 세션 기준). 클라 GetEffectiveBuyCost와 동일 공식.
        local stage = self:GetAugmentStageOf(s, "priceNego")
        if stage <= 0 then return baseCost end
        local pct = _BlacksmithConfig:GetAugmentStageValue("priceNego", stage)
        if pct <= 0 then return baseCost end
        local reduced = baseCost * (1 - pct / 100)
        return math.floor(reduced / 1000 + 0.5) * 1000
    end

    @ExecSpace("ServerOnly")
    method integer ComputeRepaymentOf(table s, integer stage)
        -- 실효 상환금 = 기본 상환금 × (1 + 위험거래 이자%). 1000단위 반올림. (Phase 8)
        --   대출 빚(s.Debt)은 이 상환금과 별개로 상환 시점(RequestSettleDebt)에 합산한다.
        local base = _BlacksmithConfig:GetDebtAmount(stage)
        local riskPct = self:GetAugmentStageValueOf(s, "riskyDeal")
        local amount = base * (1 + riskPct / 100)
        return math.floor(amount / 1000 + 0.5) * 1000
    end

    -- ═══════════════ 서버 내부 로직 (세션 단위) ═══════════════

    @ExecSpace("ServerOnly")
    method void RollShop(table s)
        -- 상점 슬롯을 무작위로 재구성한다(서버 권위, 해당 세션 한정). 각 슬롯 = 무작위 무기 종류 + 무작위 무기 등급.
        -- 확률·등급은 BlacksmithConfig가 SSOT. 결과는 미러 문자열로 직렬화해 해당 클라에 전달.
        -- 한 상점 내에서 동일 (무기종류+등급) 조합은 중복되지 않는다(같은 종류라도 등급이 다르면 허용).
        local d = _BlacksmithConfig:GetData()
        local order = d.equipmentOrder
        -- 증강 '더 좋은 물품 들여오기': 보유 단계의 절대 확률표 사용(0=기본표). (blacksmith_upgrade.md §6)
        local bgStage = self:GetAugmentStageOf(s, "betterGoods")
        local probTable = _BlacksmithConfig:GetShopGradeProbTable(bgStage)
        local slots = {}
        local parts = {}
        local seen = {}
        for i = 1, d.shopSlotCount do
            local equipId, grade, rollValue, key
            local tries = 0
            repeat
                equipId = order[_UtilLogic:RandomIntegerRange(1, #order)]
                local rolled = _BlacksmithConfig:RollWeaponGradeDetail(bgStage)
                grade = rolled.grade
                rollValue = rolled.roll
                key = equipId .. ":" .. grade
                tries = tries + 1
            until seen[key] == nil or tries >= 50  -- 중복이면 재추첨(20조합이라 상한 도달 사실상 없음)
            seen[key] = true
            slots[i] = { equipId = equipId, grade = grade, roll = rollValue }
            parts[i] = key
        end
        s.ShopSlots = slots
        s.ShopSlotsData = table.concat(parts, ",")
        -- 상점 확률 로그(상시): 적용 중인 전체 확률표(누적 구간 포함) 1줄 + 슬롯별 무기·확률·실제 roll 값 1줄.
        --   roll은 0~100 랜덤 값 — 누적 구간(~60=커먼, ~90=레어 …)에 떨어진 위치가 곧 등급 판정 근거다.
        local tableParts = {}
        local acc = 0
        for _, gk in ipairs(d.weaponGradeOrder) do
            acc = acc + probTable[gk]
            table.insert(tableParts, d.weaponGrades[gk].label .. tostring(probTable[gk]) .. "%(~" .. tostring(acc) .. ")")
        end
        log(self:Tag(s) .. "[RollShop] 등급 확률표(더좋은물품 " .. tostring(bgStage) .. "단계): "
            .. table.concat(tableParts, " "))
        local slotParts = {}
        for i, slot in ipairs(slots) do
            local eqLabel = d.equipment[slot.equipId].label
            local grLabel = d.weaponGrades[slot.grade].label
            local rollStr = tostring(math.floor(slot.roll * 10 + 0.5) / 10)
            table.insert(slotParts, "slot" .. tostring(i) .. "=" .. grLabel .. " " .. eqLabel
                .. "(" .. tostring(probTable[slot.grade]) .. "%, roll=" .. rollStr .. ")")
        end
        log(self:Tag(s) .. "[RollShop] " .. table.concat(slotParts, " "))
    end

    @ExecSpace("ServerOnly")
    method void ClearItem(table s)
        -- 현재 아이템 제거 + 잠재 상태 초기화(판매·파괴 후 공통). (flow §12-5·§14-8)
        s.CurrentItemId = ""
        s.CurrentBasePrice = 0
        s.CurrentWeaponGrade = ""
        self:ResetPotentialState(s)
    end

    @ExecSpace("ServerOnly")
    method void ResetPotentialState(table s)
        -- 잠재 결과/판매가 관련 상태를 초기값으로 되돌린다.
        s.CurrentPotential = nil
        s.HasPotential = false
        s.CurrentGrade = ""
        s.CurrentResultType = ""
        s.CurrentPotentialData = ""
        s.CurrentPrice = 0
        s.CurrentPriceFormula = ""
        s.IsCurrentDestroyed = false
    end

    @ExecSpace("ServerOnly")
    method string SerializePotential(table s, any pr)
        -- 잠재 결과(등급+옵션 3줄)를 미러 문자열로 직렬화한다(클라 스크래치 UI가 파싱해 표시).
        --   포맷: "cubeCount;grade;line;line;line", line = "label|value|unit|optionType|isBonus|isDestroy|isValid|bonus|optionGroup".
        --   맨 앞 cubeCount는 매 큐브 사용마다 값이 달라지게 해 클라가 동일 결과 재추첨도 변화로 감지하게 한다.
        --     재활용 전문가 발동 시 CubeUseCount가 안 오르므로 RecycleProcCount를 합산해 항상 증가시킨다(클라는 이 값 버림).
        --   isValid는 주요 옵션의 장비 유효성(서버 판정). 비주요(잡옵/파괴)는 0.
        --   bonus는 이 줄이 판매가에 더하는 옵션 보너스(서버 권위, GetOptionBonus). 클라는 이 값으로 실시간 판매가를 올린다.
        local parts = { tostring(s.CubeUseCount + s.RecycleProcCount), pr.grade }
        for _, o in ipairs(pr.options) do
            local isValid = 0
            if o.optionType == "Main" and _BlacksmithConfig:IsValidMain(s.CurrentItemId, o.optionName) then
                isValid = 1
            end
            local bonus = _PricingCalculator:GetOptionBonus(s.CurrentItemId, o)
            local line = o.label .. "|" .. tostring(o.value) .. "|" .. o.unit .. "|" .. o.optionType
                .. "|" .. (o.isBonusValue and "1" or "0")
                .. "|" .. (o.isDestroy and "1" or "0")
                .. "|" .. tostring(isValid)
                .. "|" .. tostring(bonus)
                .. "|" .. tostring(o.optionGroup or "Junk")
            table.insert(parts, line)
        end
        return table.concat(parts, ";")
    end

    @ExecSpace("ServerOnly")
    method void CheckStuckGameOver(table s)
        -- 스턱 게임오버 판정: 대출까지 소진했는데 다음 행동(무기/큐브 구매)이 완전히 막히면 게임오버.
        --   (weapon_shop/finance 기획 — 대출 유도 팝업이 떴던 상황이 대출 소진 후 재발하면 게임오버)
        -- ⚠ UpdateCanLoan 내부에서 호출 금지 — 세션 생성 시점 오발동 위험.
        -- 호출 지점: weapon(미보유) = RequestShopStuckCheck(상점 화면 표시 시점) /
        --            cube(보유)   = RequestUseCube·RequestBuyItem 말미.
        if self:IsSessionEndedOf(s) then return end
        if s.IsRepaymentDue then return end  -- 정산이 우선(정산 결과에서 별도 판정)
        local loan = _BlacksmithConfig:GetLoanConfig()
        if s.LoanUseCount < loan.maxUses then return end  -- 대출 여지가 남아 있으면 스턱 아님
        local reason = ""
        if s.CurrentItemId == "" then
            -- 아이템 미보유: 현재 상점 3슬롯 전부 실효 구매가 초과 → 무기를 살 수 없음(새로고침은 디버그 전용).
            local minBuy = -1
            if s.ShopSlots ~= nil then
                for _, slot in ipairs(s.ShopSlots) do
                    local g = _BlacksmithConfig:GetWeaponGrade(slot.grade)
                    if g ~= nil then
                        local c = self:GetEffectiveBuyCostOf(s, g.buyCost)
                        if minBuy < 0 or c < minBuy then minBuy = c end
                    end
                end
            end
            if minBuy < 0 or s.Meso < minBuy then
                reason = "weapon"
            end
        elseif not s.IsCurrentDestroyed then
            -- 아이템 보유: 큐브도 못 사고, 지금 팔아도 상점 최저가에 못 미치면 완전 스턱.
            --   (판매로 살아날 수 있으면 게임오버 아님 — 판 뒤 미보유 판정("weapon")이 이어서 잡는다.)
            local cubeCost = self:GetCubeCostOf(s, "weird")
            if s.Meso < cubeCost then
                -- 큐브 미사용(잠재 없음)이면 판매 불가 → 판매로 회생 불가(회생가 0). (기본가 판매 폐지)
                local sellGain = s.HasPotential and s.CurrentPrice or 0
                local minBuy = -1
                if s.ShopSlots ~= nil then
                    for _, slot in ipairs(s.ShopSlots) do
                        local g = _BlacksmithConfig:GetWeaponGrade(slot.grade)
                        if g ~= nil then
                            local c = self:GetEffectiveBuyCostOf(s, g.buyCost)
                            if minBuy < 0 or c < minBuy then minBuy = c end
                        end
                    end
                end
                if minBuy >= 0 and (s.Meso + sellGain) < minBuy then
                    reason = "cube"
                end
            end
        end
        if reason == "" then return end
        s.GameOverReason = reason
        s.IsGameOver = true
        self:UpdateCanLoan(s)
        self:RecordGameOver(s)
        log(self:Tag(s) .. "GAME OVER(" .. reason .. "): stuck with no loan left. meso="
            .. tostring(s.Meso) .. ", item=" .. tostring(s.CurrentItemId))
    end

    @ExecSpace("ServerOnly")
    method void UpdateRepaymentCountdown(table s)
        -- 다음 상환까지 남은 큐브 횟수 갱신. 미납 상태면 0으로 표시. (concept §6-4, [6])
        -- 주기 = 현재 주차(DebtStage+1)의 debtCycles 값(주차별 가변 5/6/6/7/7).
        if s.IsRepaymentDue then
            s.CubesUntilRepayment = 0
            return
        end
        local cycle = _BlacksmithConfig:GetDebtCycle(s.DebtStage + 1)
        s.CubesUntilRepayment = cycle - s.WeekCubeCount
    end

    @ExecSpace("ServerOnly")
    method void SerializeAugments(table s)
        -- OwnedAugments를 "key:stage,..." 미러 문자열로 직렬화(augmentOrder 순서 유지). ShopSlotsData 패턴.
        local parts = {}
        local order = _BlacksmithConfig:GetAugmentOrder()
        for _, key in ipairs(order) do
            local stage = self:GetAugmentStageOf(s, key)
            if stage > 0 then
                table.insert(parts, key .. ":" .. tostring(stage))
            end
        end
        s.AugmentsData = table.concat(parts, ",")
    end

    @ExecSpace("ServerOnly")
    method void SerializeSeasonMissions(table s)
        -- 시즌 미션 진행/클리어를 "key:progress:cleared,..." 미러 CSV로 직렬화(missionOrder 순 6토큰 고정).
        --   progress = 세션 통계 s[statKey]를 target으로 클램프. 클리어 미션은 target 고정
        --   (재시작 보존 시 통계가 리셋돼도 완료 미션이 0/N으로 보이지 않게). (seasonpass.md §9·§12)
        local sp = _BlacksmithConfig:GetSeasonPass()
        local parts = {}
        for _, key in ipairs(sp.missionOrder) do
            local def = sp.missions[key]
            local cleared = (s.SeasonMissions ~= nil and s.SeasonMissions[key]) and 1 or 0
            local prog = s[def.statKey] or 0
            if cleared == 1 or prog > def.target then prog = def.target end
            table.insert(parts, key .. ":" .. tostring(prog) .. ":" .. tostring(cleared))
        end
        s.SeasonMissionsData = table.concat(parts, ",")
    end

    @ExecSpace("ServerOnly")
    method void CheckSeasonMissions(table s)
        -- 시즌 미션 범용 판정 엔진(config statKey 주도): 미클리어 미션의 통계가 target에 도달하면
        --   즉시 클리어 + 점수 지급(서버 자동 지급 — 클레임 RPC 없음, 유저 확정). (seasonpass.md §8·§9)
        -- 클리어 여부와 무관하게 말미에 항상 재직렬화 → 진행도(2/3 등)도 매 훅마다 최신화된다.
        local sp = _BlacksmithConfig:GetSeasonPass()
        if s.SeasonMissions == nil then s.SeasonMissions = {} end
        for _, key in ipairs(sp.missionOrder) do
            local def = sp.missions[key]
            if not s.SeasonMissions[key] and (s[def.statKey] or 0) >= def.target then
                s.SeasonMissions[key] = true
                s.SeasonScore = s.SeasonScore + def.reward
                log(self:Tag(s) .. "[SeasonPass] mission clear: " .. key .. " +" .. tostring(def.reward)
                    .. " -> score=" .. tostring(s.SeasonScore))
            end
        end
        self:SerializeSeasonMissions(s)
    end

    @ExecSpace("ServerOnly")
    method void RollAugmentChoices(table s)
        -- 3택 무작위 선택지 구성: 아직 최대 단계에 도달하지 않은 증강만 후보(3단계 소진 제외). (blacksmith_upgrade.md §5·§4)
        local d = _BlacksmithConfig:GetData()
        local pool = {}
        for _, key in ipairs(d.augmentOrder) do
            if self:GetAugmentStageOf(s, key) < d.augmentMaxStage then
                table.insert(pool, key)
            end
        end
        if #pool == 0 then
            -- 모든 증강 소진 → 대기 없음.
            s.AugmentChoicesData = ""
            s.IsAugmentPending = false
            log(self:Tag(s) .. "no augment choices (all maxed)")
            return
        end
        -- Fisher-Yates 셔플 후 앞에서 choiceCount개 선택(중복 없음).
        for i = #pool, 2, -1 do
            local j = _UtilLogic:RandomIntegerRange(1, i)
            pool[i], pool[j] = pool[j], pool[i]
        end
        local n = math.min(d.augmentChoiceCount, #pool)
        local chosen = {}
        for i = 1, n do chosen[i] = pool[i] end
        s.AugmentChoicesData = table.concat(chosen, ",")
        s.IsAugmentPending = true
        log(self:Tag(s) .. "augment choices: " .. s.AugmentChoicesData)
    end

    @ExecSpace("ServerOnly")
    method void UpdateCanLoan(table s)
        -- 대출 가능 여부 재계산: 게임오버 아님 + 사용 횟수 남음 + '다음 행동이 막힘'. (finance §2)
        --   현재 화면 상황(아이템 보유 여부)에 따라 '막힘'을 판정해 HUD 대출 유도 팝업 조건과 정합화한다.
        --     · 아이템 미보유(상점 화면): 상점 무기를 하나도 살 수 없음 = 막힘.
        --     · 아이템 보유(스크래치 화면): 이상한 큐브를 살 수 없음 = 막힘(판매 탈출은 조건에서 제외, §2 문구).
        --   (아이템이 없으면 큐브를 쓸 대상 자체가 없으므로 큐브 비용은 무기 구매 불가만으로 판정한다.)
        local loan = _BlacksmithConfig:GetLoanConfig()
        if self:IsSessionEndedOf(s) or s.LoanUseCount >= loan.maxUses then
            s.CanLoan = false
            return
        end
        local stuck
        if s.CurrentItemId ~= "" then
            local cubeCost = self:GetCubeCostOf(s, "weird")
            stuck = s.Meso < cubeCost
        else
            local minBuy = -1
            if s.ShopSlots ~= nil then
                for _, slot in ipairs(s.ShopSlots) do
                    local g = _BlacksmithConfig:GetWeaponGrade(slot.grade)
                    if g ~= nil then
                        local c = self:GetEffectiveBuyCostOf(s, g.buyCost)
                        if minBuy < 0 or c < minBuy then minBuy = c end
                    end
                end
            end
            stuck = (minBuy < 0) or (s.Meso < minBuy)
        end
        s.CanLoan = stuck
    end

    @ExecSpace("ServerOnly")
    method void RecordGameOver(table s)
        -- 게임오버 시 최종 결과 5개 항목을 유저별 키로 영구 저장. (flow §게임오버 표시 정보)
        -- ⚠ DataStorage는 Credit 과금 → 게임오버 1회성 이벤트에서만 호출(OnUpdate/타이머 금지). datastorage.md 준수.
        if self.recordStorage == nil then
            log_warning(self:Tag(s) .. "record skip: no storage handle")
            return
        end
        local record = {
            finalMeso = s.Meso,
            totalCubes = s.CubeUseCount,
            totalSells = s.TotalSellCount,
            maxSellPrice = s.MaxSellPrice,
            finalDebtStage = s.DebtStage,
        }
        -- 마지막 판 기록(유저별 키, 값 4KB 미만 → 1 Credit). 비동기 저장(프레임 보호).
        self.recordStorage:SetAsync("lastRun:" .. tostring(s.UserId), _UtilLogic:TableToString(record), nil)
        log(self:Tag(s) .. "game over recorded: meso=" .. tostring(record.finalMeso)
            .. ", cubes=" .. tostring(record.totalCubes) .. ", sells=" .. tostring(record.totalSells)
            .. ", maxPrice=" .. tostring(record.maxSellPrice) .. ", debtStage=" .. tostring(record.finalDebtStage))
    end

    method string BuildPriceFormula(any calc, number prePrice, number riskPct)
        -- 판매가 계산식을 사람이 읽는 문자열로 조립(디버그/로그용, 파괴 아닐 때만 호출).
        --   형식: (기본 B + 옵션 O + 조합 C[key]) × 등급 G × 이탈 E = prePrice [× 위험거래(1+R%) = finalPrice]
        --   수치는 라인 로그와 동일하게 raw. 판매가 공식은 pricing_calculation.md §4.
        local comboStr = ""
        if calc.comboBonus ~= nil and calc.comboBonus > 0 then
            comboStr = " + 조합 " .. tostring(calc.comboBonus)
            if calc.comboKey ~= nil and calc.comboKey ~= "" then
                comboStr = comboStr .. "[" .. calc.comboKey .. "]"
            end
        end
        local f = "(기본 " .. tostring(calc.base) .. " + 옵션 " .. tostring(calc.optionBonusSum)
            .. comboStr .. ") x 등급 " .. tostring(calc.gradeMult)
            .. " x 이탈 " .. tostring(calc.bonusMult)
            .. " = " .. tostring(prePrice)
        if riskPct ~= nil and riskPct > 0 then
            f = f .. " x 위험거래(1+" .. tostring(riskPct) .. "%) = " .. tostring(calc.price)
        end
        return f
    end

    -- ═══════════════ Server RPC 엔트리포인트 (클라 호출) ═══════════════
    -- 공통 패턴: 세션 조회(senderUserId — 서버 부여, 위조 불가) → 본문(Do*) → PushState 1회.
    -- 본문에 early return이 있어도 말미 PushState가 항상 실행돼 미러 정체가 없다.

    @ExecSpace("Server")
    method void RequestRestart()
        -- 재시작: 게임오버/승리 상태에서만 허용. 요청 유저의 세션만 전체 리셋(누적 기록은 보존). (flow §게임오버 §7)
        local s = self:GetSession(senderUserId)
        if not self:IsSessionEndedOf(s) then
            log_warning(self:Tag(s) .. "restart rejected: session not ended")
        else
            -- 시즌 패스는 판(run)을 넘는 메타 진행 — 점수·클리어 미션만 백업 후 새 세션에 복원(유저 확정).
            --   미클리어 미션의 부분 진행도(큐브 2/3 등)는 새 판 통계 기준으로 리셋된다(HUD 시계와 의미 충돌 방지).
            --   서버 내 테이블 이동이라 cross-space 전송 금지 규칙과 무관. 재접속은 기존대로 완전 초기화(서버 저장 미구현).
            local keepScore = s.SeasonScore or 0
            local keepMissions = s.SeasonMissions or {}
            self:ResetSessionFor(senderUserId)
            local ns = self.Sessions[senderUserId]
            ns.SeasonScore = keepScore
            ns.SeasonMissions = keepMissions
            self:SerializeSeasonMissions(ns)
            log(self:Tag(ns) .. "RESTART -> new session (season kept: score=" .. tostring(keepScore) .. ")")
        end
        self:PushState(senderUserId)
    end

    @ExecSpace("Server")
    method void RequestRefreshShop()
        -- '새로고침' 버튼: 메소 차감 없이 상점을 재추첨한다(개발/테스트 편의 + concept §6-1 선택 갱신).
        local s = self:GetSession(senderUserId)
        if self:IsSessionEndedOf(s) then
            log_warning(self:Tag(s) .. "refresh rejected: session ended")
        else
            self:RollShop(s)
        end
        self:PushState(senderUserId)
    end

    @ExecSpace("Server")
    method void RequestBuyItem(integer slotIndex)
        -- 아이템 구매 진입점. 검증·처리는 DoBuyItem(서버 권위), 말미 미러 push.
        local s = self:GetSession(senderUserId)
        self:DoBuyItem(s, slotIndex)
        self:PushState(senderUserId)
    end

    @ExecSpace("ServerOnly")
    method void DoBuyItem(table s, integer slotIndex)
        -- 아이템 구매: 슬롯 인덱스 검증 → 등급 가격 차감 → 현재 아이템 등록 → 상점 재추첨 (flow §6).
        -- 클라 입력(slotIndex)은 신뢰하지 않고, 서버 자신의 ShopSlots에서 등급/가격을 읽어 검증한다(위조 차단).
        if self:IsSessionEndedOf(s) then
            log_warning(self:Tag(s) .. "buy rejected: session ended")
            return
        end

        -- 상환 미납(5/5) 상태면 정산이 먼저 — sync 갭 프레임의 상점 구매 방지
        if s.IsRepaymentDue then
            log_warning(self:Tag(s) .. "buy rejected: repayment due (settle first)")
            return
        end

        -- 현재 아이템이 있으면 새로 구매 불가 (flow §6 실패 처리)
        if s.CurrentItemId ~= "" then
            log_warning(self:Tag(s) .. "buy rejected: already holding '" .. s.CurrentItemId .. "'")
            return
        end

        -- 슬롯 인덱스 유효성 검증 (서버 권위 ShopSlots 기준)
        if s.ShopSlots == nil or slotIndex < 1 or slotIndex > #s.ShopSlots then
            log_warning(self:Tag(s) .. "buy rejected: invalid slot " .. tostring(slotIndex))
            return
        end
        local slot = s.ShopSlots[slotIndex]
        local eq = _BlacksmithConfig:GetEquipment(slot.equipId)
        local grade = _BlacksmithConfig:GetWeaponGrade(slot.grade)
        if eq == nil or grade == nil then
            log_warning(self:Tag(s) .. "buy rejected: bad slot data " .. tostring(slot.equipId)
                .. "/" .. tostring(slot.grade))
            return
        end

        -- 증강 '가격 협상': 구매가 % 감소(미보유면 0%). (Phase 8)
        local buyCost = self:GetEffectiveBuyCostOf(s, grade.buyCost)

        -- 보유 메소 부족 시 구매 불가
        if s.Meso < buyCost then
            log_warning(self:Tag(s) .. "buy rejected: not enough meso (" .. tostring(s.Meso)
                .. " < " .. tostring(buyCost) .. ")")
            return
        end

        s.Meso = s.Meso - buyCost
        s.CurrentItemId = slot.equipId
        s.CurrentBasePrice = grade.basePrice   -- 구매 등급의 기본 판매가(판매가 계산 base)
        s.CurrentWeaponGrade = slot.grade
        self:ResetPotentialState(s)  -- 새 아이템은 잠재 미사용 상태에서 시작
        self:RollShop(s)             -- 구매한 무기는 작업대로 가져갔으므로 상점을 새로 채운다
        self:UpdateCanLoan(s)
        log(self:Tag(s) .. "bought '" .. grade.label .. " " .. eq.label .. "' (-"
            .. tostring(buyCost) .. " base=" .. tostring(grade.buyCost)
            .. "), basePrice=" .. tostring(s.CurrentBasePrice)
            .. ", meso=" .. tostring(s.Meso) .. ", item=" .. s.CurrentItemId)
        self:CheckStuckGameOver(s)
    end

    @ExecSpace("Server")
    method void RequestUseCube(string cubeType)
        -- 큐브 사용 진입점. 검증·판정은 DoUseCube(서버 권위), 말미 미러 push.
        local s = self:GetSession(senderUserId)
        self:DoUseCube(s, cubeType)
        self:PushState(senderUserId)
    end

    @ExecSpace("ServerOnly")
    method void DoUseCube(table s, string cubeType)
        -- 큐브 사용: 비용 차감 → 횟수 증가 → 잠재 판정 → 판매가 계산 → 결과 보관. (flow §7·§13)
        -- 최초 사용과 '한 번 더 사용하기'는 둘 다 "현재 아이템에 큐브 사용"이라 이 메서드로 함께 처리한다.
        -- cubeType: "weird"(이상한, 파괴 가능) / "master"(장인, 파괴 없음). 알 수 없으면 weird 폴백(클라 입력 불신).
        if self:IsSessionEndedOf(s) then
            log_warning(self:Tag(s) .. "cube rejected: session ended")
            return
        end
        -- 상환 미납 상태면 먼저 갚아야 다음 큐브 사용 가능 (flow §15 "상환 먼저 처리 후 진행")
        if s.IsRepaymentDue then
            log_warning(self:Tag(s) .. "cube rejected: repayment due (settle first)")
            return
        end
        -- 큐브 사용은 현재 아이템이 있을 때만 가능 (flow §7 기준)
        if s.CurrentItemId == "" then
            log_warning(self:Tag(s) .. "cube rejected: no item")
            return
        end
        -- 파괴된 아이템에는 다시 큐브를 사용할 수 없다. 먼저 확인(파괴 정리)이 필요. (flow §14)
        if s.IsCurrentDestroyed then
            log_warning(self:Tag(s) .. "cube rejected: item destroyed (confirm first)")
            return
        end
        -- 판매 확정(수령 대기) 상태면 큐브 재사용 불가 — 먼저 수령해야 한다. (2단계 판매)
        if s.IsSalePending then
            log_warning(self:Tag(s) .. "cube rejected: sale pending (collect first)")
            return
        end

        -- 큐브 종류 해석(클라 입력 불신 → 서버가 config에서 비용/파괴여부 확정). 알 수 없으면 weird 폴백.
        local cube = _BlacksmithConfig:GetCube(cubeType)
        local cubeKey = cubeType
        if cube == nil then
            cubeKey = "weird"
            cube = _BlacksmithConfig:GetCube("weird")
        end
        -- 큐브 비용 = 증강 '귀한 태생' 단계 연동(GetCubeCostOf가 SSOT — 정적 cost 필드 폐기).
        local cost = self:GetCubeCostOf(s, cubeKey)
        if s.Meso < cost then
            log_warning(self:Tag(s) .. "cube rejected: not enough meso (" .. tostring(s.Meso)
                .. " < " .. tostring(cost) .. ")")
            return
        end

        -- 증강 '재활용 전문가': 큐브 사용 시 단계별 확률(10/20/35%)로 사용 횟수 차감 방지. (blacksmith_upgrade.md §6)
        --   메소는 정상 차감(유저 확정), 잠재도 정상 재설정 — 시계 카운트·상환 트리거만 오르지 않는다.
        local recyclePct = self:GetAugmentStageValueOf(s, "recycleExpert")
        local recycled = recyclePct > 0 and _UtilLogic:RandomIntegerRange(1, 100) <= recyclePct

        -- 비용 차감 + 큐브 사용 횟수 1 증가 (flow §7-4·5).
        -- '한 번 더 사용하기' 시 기존 잠재/판매가는 새 결과로 덮어쓴다 (flow §13).
        s.Meso = s.Meso - cost
        -- 시즌 패스: '이상한 큐브 사용' 미션 통계. 재활용 발동 여부 무관 — 메소를 쓰고 잠재를 굴렸으면 1회.
        --   (CubeUseCount는 상환 시계용이라 장인의 큐브도 세고 재활용 시 안 오름 — 미션 의미와 달라 분리.)
        if cubeKey == "weird" then
            s.WeirdCubeUseCount = (s.WeirdCubeUseCount or 0) + 1
        end
        if recycled then
            -- 발동: 횟수 미증가 + 상환 경계 판정 스킵(카운트 불변인데 % 판정을 다시 타면 재상환 버그).
            --   RecycleProcCount 증가 에지를 클라(HudManager)가 감지해 시계 되감기 연출을 재생한다.
            s.RecycleProcCount = s.RecycleProcCount + 1
            log(self:Tag(s) .. "recycleExpert proc! (" .. tostring(recyclePct)
                .. "%) cube count kept at " .. tostring(s.CubeUseCount)
                .. ", procTotal=" .. tostring(s.RecycleProcCount))
        else
            s.CubeUseCount = s.CubeUseCount + 1
            s.WeekCubeCount = s.WeekCubeCount + 1

            -- 이번 주 상환 주기(주차별 가변 5/6/6/7/7) 도달 시 상환 예정 상태로 전환 (concept §6-3, flow §15).
            -- 실제 차감/게임오버는 RequestSettleDebt에서 처리(스크래치 결과 완료 후 호출).
            -- 미납 중 큐브 사용은 위에서 차단되므로 상환 단계 = 현재 주차(DebtStage+1).
            local cycle = _BlacksmithConfig:GetDebtCycle(s.DebtStage + 1)
            if s.WeekCubeCount >= cycle then
                local stage = s.DebtStage + 1
                s.IsRepaymentDue = true
                -- 위험 거래(이자 증가)를 반영한 실효 상환금. 대출 빚(s.Debt)은 상환 시점에 별도 합산. (Phase 8·9)
                s.PendingRepayment = self:ComputeRepaymentOf(s, stage)
                log(self:Tag(s) .. "repayment DUE: stage=" .. tostring(stage)
                    .. ", cycle=" .. tostring(cycle)
                    .. ", amount=" .. tostring(s.PendingRepayment))
            end
        end
        self:UpdateRepaymentCountdown(s)

        -- 잠재능력 판정(서버 권위) → 판매가 계산(파괴면 Destroyed).
        -- 기본 판매가는 구매한 무기 등급(CurrentBasePrice)을 baseOverride로 넘긴다(상점 등급 = 기본 판매가).
        -- 파괴 허용 여부는 큐브 종류로 결정(장인의 큐브는 파괴 없음).
        -- 증강 '대장장이의 눈': 현재 무기 유효 옵션 강제 확률(%)을 판정 컨텍스트로 넘긴다. (Phase 8)
        local validForce = self:GetAugmentStageValueOf(s, "smithEye")
        -- 증강 '귀한 태생': 보유 단계(0=미보유)를 넘겨 상위 잠재 등급 확률표를 사용하게 한다.
        local gradeStage = self:GetAugmentStageOf(s, "innateGrade")
        local pr = _PotentialService:RollPotential(cube.allowDestroy, s.CurrentItemId, validForce, gradeStage)
        pr.baseOverride = s.CurrentBasePrice
        local calc = _PricingCalculator:Calculate(s.CurrentItemId, pr)
        -- 증강 '위험 거래': 판매가 % 증가(파괴가 아닐 때만). (Phase 8)
        -- 계산식 로그용: riskyDeal 적용 전 가격(prePrice)과 증가율(riskPct)을 캡처해 둔다.
        local prePrice = calc.price
        local riskPct = 0
        if not calc.destroyed then
            riskPct = self:GetAugmentStageValueOf(s, "riskyDeal")
            if riskPct > 0 then
                calc.price = math.floor((calc.price * (1 + riskPct / 100)) / 1000 + 0.5) * 1000
            end
        end

        -- 서버 권위 전체 결과 보관(옵션 3줄 포함) + 클라 전달용 직렬화.
        s.CurrentPotential = pr
        s.CurrentGrade = pr.grade
        s.CurrentResultType = pr.resultType
        s.CurrentPotentialData = self:SerializePotential(s, pr)
        s.HasPotential = true

        if calc.destroyed then
            -- 파괴: 판매가 0, 파괴 상태로 전환. 실제 아이템 제거는 확인(RequestConfirmDestroy) 시. (flow §14)
            s.IsCurrentDestroyed = true
            s.DestroyCount = (s.DestroyCount or 0) + 1  -- 시즌 패스: 파괴 발생 순간 카운트(확인 전 이탈해도 인정)
            s.CurrentPrice = 0
            s.CurrentPriceFormula = ""
            log(self:Tag(s) .. "cube used -> DESTROYED. item=" .. s.CurrentItemId
                .. ", cubeCount=" .. tostring(s.CubeUseCount) .. ", meso=" .. tostring(s.Meso))
        else
            s.IsCurrentDestroyed = false
            s.CurrentPrice = calc.price
            -- 판매가 계산식 문자열 조립(미러로 클라 스크래치 로그에 전달).
            s.CurrentPriceFormula = self:BuildPriceFormula(calc, prePrice, riskPct)
            log(self:Tag(s) .. "cube used -> grade=" .. pr.grade .. ", type=" .. pr.resultType
                .. ", price=" .. tostring(calc.price) .. ", cubeCount=" .. tostring(s.CubeUseCount)
                .. ", meso=" .. tostring(s.Meso))
            log(self:Tag(s) .. "price formula: " .. s.CurrentPriceFormula)
        end
        self:CheckSeasonMissions(s)  -- 시즌 패스: cube3/destroy1 판정(행동은 게임오버 판정보다 먼저 발생한 것)
        self:UpdateCanLoan(s)
        self:CheckStuckGameOver(s)
    end

    @ExecSpace("Server")
    method void RequestSellItem()
        -- 판매 확정(1단계) 진입점. (cube_scratch_system §11, 2단계 판매)
        local s = self:GetSession(senderUserId)
        self:DoSellItem(s)
        self:PushState(senderUserId)
    end

    @ExecSpace("ServerOnly")
    method void DoSellItem(table s)
        -- 판매 확정(1단계): 즉시 지급하지 않고 '수령 대기(IsSalePending)'로 전환한다.
        --   실제 메소 지급·아이템 정리는 판매 결과 창의 '수령하기'(RequestCollectSale)에서 처리한다.
        if self:IsSessionEndedOf(s) then
            log_warning(self:Tag(s) .. "sell rejected: session ended")
            return
        end
        if s.CurrentItemId == "" then
            log_warning(self:Tag(s) .. "sell rejected: no item")
            return
        end
        -- 파괴된 아이템은 판매할 수 없다. (flow §12·§14)
        if s.IsCurrentDestroyed then
            log_warning(self:Tag(s) .. "sell rejected: item destroyed")
            return
        end
        -- 큐브 미사용 상태(잠재 없음)에서는 판매 불가(서버 권위 방어 — 클라 버튼 비활성화와 정합).
        --   큐브를 한 번이라도 써야 판매 가능. 기본가 판매(데드락 탈출)는 폐지 → 스턱은 게임오버로 처리.
        if not s.HasPotential then
            log_warning(self:Tag(s) .. "sell rejected: no cube used (potential required)")
            return
        end
        -- 이미 수령 대기 중이면 중복 요청 무시.
        if s.IsSalePending then
            log_warning(self:Tag(s) .. "sell rejected: already pending collect")
            return
        end
        -- 수령 대기 상태로 전환(아이템/잠재 상태는 유지 → 결과 창 표시 + 수령 흐름). (2단계 판매)
        s.IsSalePending = true
        s.PendingSalePrice = s.CurrentPrice
        s.PendingSaleItemId = s.CurrentItemId
        log(self:Tag(s) .. "sale pending '" .. s.CurrentItemId .. "' price="
            .. tostring(s.PendingSalePrice) .. " (awaiting collect)")
    end

    @ExecSpace("Server")
    method void RequestCollectSale()
        -- 판매 수령(2단계) 진입점. (cube_scratch_system §11)
        local s = self:GetSession(senderUserId)
        self:DoCollectSale(s)
        self:PushState(senderUserId)
    end

    @ExecSpace("ServerOnly")
    method void DoCollectSale(table s)
        -- 판매 수령(2단계): 수령 대기 금액을 지급하고 아이템/잠재 상태를 정리한다.
        if self:IsSessionEndedOf(s) then
            log_warning(self:Tag(s) .. "collect rejected: session ended")
            return
        end
        if not s.IsSalePending then
            log_warning(self:Tag(s) .. "collect rejected: no pending sale")
            return
        end
        local gain = s.PendingSalePrice
        local soldId = s.PendingSaleItemId
        s.Meso = s.Meso + gain
        -- 판매 통계 갱신(게임오버 기록용, Phase 1).
        s.TotalSellCount = s.TotalSellCount + 1
        if gain > s.MaxSellPrice then s.MaxSellPrice = gain end
        s.TotalSellAmount = (s.TotalSellAmount or 0) + gain  -- 시즌 패스: 누적 판매 금액(totalSale 미션)
        -- 수령 대기 상태 해제 후 아이템 정리(순서 무관하나 pending 먼저 내려야 클라 에지 감지가 깔끔).
        s.IsSalePending = false
        s.PendingSalePrice = 0
        s.PendingSaleItemId = ""
        self:ClearItem(s)
        self:UpdateCanLoan(s)
        self:CheckSeasonMissions(s)  -- 시즌 패스: sell1/bigSale/totalSale 판정(통계 갱신 직후)
        log(self:Tag(s) .. "collected sale '" .. soldId .. "' (+" .. tostring(gain)
            .. "), meso=" .. tostring(s.Meso)
            .. ", totalSells=" .. tostring(s.TotalSellCount) .. ", maxPrice=" .. tostring(s.MaxSellPrice))
        -- 스턱(weapon) 판정은 상점 화면 표시 시점(RequestShopStuckCheck)으로 연기.
    end

    @ExecSpace("Server")
    method void RequestConfirmDestroy()
        -- 파괴 확인 진입점. (flow §14-7·8)
        local s = self:GetSession(senderUserId)
        self:DoConfirmDestroy(s)
        self:PushState(senderUserId)
    end

    @ExecSpace("ServerOnly")
    method void DoConfirmDestroy(table s)
        -- 파괴 확인: 파괴된 아이템을 제거하고 아이템 선택 상태로 되돌린다.
        if s.CurrentItemId == "" then
            log_warning(self:Tag(s) .. "confirm rejected: no item")
            return
        end
        if not s.IsCurrentDestroyed then
            log_warning(self:Tag(s) .. "confirm rejected: item not destroyed")
            return
        end
        local lostId = s.CurrentItemId
        self:ClearItem(s)
        self:UpdateCanLoan(s)
        log(self:Tag(s) .. "destroyed item '" .. lostId .. "' removed")
        -- 스턱(weapon) 판정은 상점 화면 표시 시점(RequestShopStuckCheck)으로 연기.
    end

    @ExecSpace("Server")
    method void RequestSettleDebt()
        -- 빚 상환 진입점. (flow §15·§16 — UI는 다음주 정산 팝업(NextWeekManager)이 로비 복귀 시 호출)
        local s = self:GetSession(senderUserId)
        self:DoSettleDebt(s)
        self:PushState(senderUserId)
    end

    @ExecSpace("ServerOnly")
    method void DoSettleDebt(table s)
        -- 빚 상환: 상환 시점 도달 시 메소 차감, 부족하면 게임오버.
        if self:IsSessionEndedOf(s) then return end
        if not s.IsRepaymentDue then
            log_warning(self:Tag(s) .. "settle rejected: no repayment due")
            return
        end

        -- 상환 필요 메소 + 대출로 누적된 빚을 전부 갚아야 다음 주로 진행한다(finance §, 유저 확정).
        local amount = s.PendingRepayment + s.Debt
        if s.Meso >= amount then
            s.Meso = s.Meso - amount
            s.Debt = 0
            s.DebtStage = s.DebtStage + 1
            s.WeekCubeCount = 0   -- 새 주 시작 — 이번 주 큐브 카운터 리셋(카운트다운은 새 주기의 값으로 재계산)
            s.IsRepaymentDue = false
            s.PendingRepayment = 0
            self:UpdateRepaymentCountdown(s)
            self:UpdateCanLoan(s)
            -- 시즌 패스: debt1 판정. 승리 early return보다 앞 — 승리하는 5주차 상환에서도 놓치지 않게.
            self:CheckSeasonMissions(s)
            log(self:Tag(s) .. "debt settled: stage=" .. tostring(s.DebtStage)
                .. ", -" .. tostring(amount) .. ", meso=" .. tostring(s.Meso)
                .. ", nextRepayIn=" .. tostring(s.CubesUntilRepayment))
            -- 승리 판정: winStage회(5주) 상환 성공 시 승리 (finance_management.md 승리 조건).
            local winStage = _BlacksmithConfig:GetData().winStage
            if s.DebtStage >= winStage then
                s.IsVictory = true
                self:UpdateCanLoan(s)
                log(self:Tag(s) .. "VICTORY: " .. tostring(s.DebtStage) .. "주 상환 완료. meso="
                    .. tostring(s.Meso) .. ", cubes=" .. tostring(s.CubeUseCount))
                return
            end
            -- (증강은 상환 보상이 아니라 골드 구매형 — RollAugmentChoices는 여기서 호출하지 않는다.
            --  구매형 전환: 3택은 세션 시작 시 1회 롤 + 구매 성공(RequestSelectAugment) 시 재추첨. blacksmith_upgrade.md §3·§4)
            log(self:Tag(s) .. "NEXT WEEK: day=" .. tostring(self:GetCurrentDayOf(s))
                .. "주차, nextRepay=" .. tostring(self:GetCurrentRepaymentOf(s)))
            -- ⚠ 여기서 스턱(weapon) 판정을 하지 않는다 — 판정은 플레이어가 무기 상점 화면을 열어
            --   슬롯이 표시된 시점(RequestShopStuckCheck)에만 수행한다(유저 확정: 로비에서 즉사 금지).
        else
            -- 상환 실패 → 게임 오버 (flow §16). 원인: 상환액 자체가 부족 vs 빚까지는 부족.
            --   메소는 차감하지 않는다(게임오버 기록의 finalMeso 보존, 차감 연출은 클라 표시 전용).
            s.GameOverReason = (s.Meso < s.PendingRepayment) and "repayment" or "debt"
            s.IsGameOver = true
            self:UpdateCanLoan(s)
            self:RecordGameOver(s)
            log(self:Tag(s) .. "GAME OVER(" .. s.GameOverReason .. "): cannot repay "
                .. tostring(amount) .. " (meso=" .. tostring(s.Meso) .. ")")
        end
    end

    @ExecSpace("Server")
    method void RequestShopStuckCheck()
        -- 무기 상점 화면에 슬롯이 표시된 시점에 클라(WeaponShopManager)가 호출하는 판정 트리거.
        -- 클라 입력이 없고(타이밍 신호만) 판정은 전부 서버 권위(CheckStuckGameOver)라 위조 위험 없음.
        -- weapon 스턱 판정은 이 경로로만 발동한다 — 로비/정산 직후에는 판정하지 않음(유저 확정).
        local s = self:GetSession(senderUserId)
        if not self:IsSessionEndedOf(s) and not s.IsRepaymentDue and s.CurrentItemId == "" then
            self:CheckStuckGameOver(s)
        end
        self:PushState(senderUserId)
    end

    @ExecSpace("Server")
    method void RequestSelectAugment(string augmentKey)
        -- 증강 구매 진입점. (blacksmith_upgrade.md §3·§4)
        local s = self:GetSession(senderUserId)
        self:DoSelectAugment(s, augmentKey)
        self:PushState(senderUserId)
    end

    @ExecSpace("ServerOnly")
    method void DoSelectAugment(table s, string augmentKey)
        -- 증강 구매: 제시된 3택 중 하나를 골드로 구매(도달 단계 기준 비용 차감). 중복이면 단계 상승.
        --   클라 입력 불신: 선택지 포함 여부·비용·단계 상한 모두 서버 권위 검증. 구매 성공 시 창을 재추첨한다(§4-4 새로고침).
        if self:IsSessionEndedOf(s) then return end
        if not s.IsAugmentPending then
            log_warning(self:Tag(s) .. "augment buy rejected: none pending")
            return
        end
        -- 상환 미납(5/5) 상태면 정산이 우선.
        if s.IsRepaymentDue then
            log_warning(self:Tag(s) .. "augment buy rejected: repayment due (settle first)")
            return
        end
        -- 서버 권위 선택지 검증(위조 차단).
        local offered = false
        for token in string.gmatch(s.AugmentChoicesData, "([^,]+)") do
            if token == augmentKey then offered = true break end
        end
        if not offered then
            log_warning(self:Tag(s) .. "augment buy rejected: '" .. tostring(augmentKey) .. "' not offered")
            return
        end
        local def = _BlacksmithConfig:GetAugment(augmentKey)
        if def == nil then
            log_warning(self:Tag(s) .. "augment buy rejected: unknown '" .. tostring(augmentKey) .. "'")
            return
        end
        local maxStage = _BlacksmithConfig:GetData().augmentMaxStage
        local cur = self:GetAugmentStageOf(s, augmentKey)
        if cur >= maxStage then
            log_warning(self:Tag(s) .. "augment buy rejected: already max '" .. augmentKey .. "'")
            return
        end
        -- 구매 비용(도달할 단계 기준) 검증·차감. (blacksmith_upgrade.md §3)
        local cost = _BlacksmithConfig:GetAugmentCost(cur + 1)
        if s.Meso < cost then
            log_warning(self:Tag(s) .. "augment buy rejected: not enough meso (" .. tostring(s.Meso)
                .. " < " .. tostring(cost) .. ")")
            return
        end
        s.Meso = s.Meso - cost
        if s.OwnedAugments == nil then s.OwnedAugments = {} end
        s.OwnedAugments[augmentKey] = cur + 1
        self:SerializeAugments(s)
        self:UpdateCanLoan(s)  -- 가격 협상 등 구매가에 영향 → 대출 조건 재평가.
        log(self:Tag(s) .. "augment bought: " .. augmentKey .. " -> stage " .. tostring(cur + 1)
            .. " (-" .. tostring(cost) .. ", meso=" .. tostring(s.Meso) .. "), owned=" .. s.AugmentsData)
        -- 구매 완료 → 창 새로고침(재추첨). 3단계 소진 증강은 다음 풀에서 제외된다. (§4-4)
        self:RollAugmentChoices(s)
    end

    @ExecSpace("Server")
    method void RequestLoan()
        -- 메소 대출 진입점. (finance §2~§4)
        local s = self:GetSession(senderUserId)
        self:DoLoan(s)
        self:PushState(senderUserId)
    end

    @ExecSpace("ServerOnly")
    method void DoLoan(table s)
        -- 메소 대출: 위기 대응. 조건 충족 시 즉시 지급 + 갚아야 할 빚 누적 + 사용 횟수 증가.
        --   금액 규칙(유저 확정): 지급 메소 = 현재 상환 필요 메소만큼, 빚도 그만큼 증가.
        --   즉 상환 시점에 '상환 필요 메소 + 빚'을 한 번에 갚아야 한다(예: 상환 45,000이면 45,000 받고 빚 45,000 → 정산 90,000).
        if self:IsSessionEndedOf(s) then
            log_warning(self:Tag(s) .. "loan rejected: session ended")
            return
        end
        self:UpdateCanLoan(s)
        if not s.CanLoan then
            log_warning(self:Tag(s) .. "loan rejected: conditions not met (meso=" .. tostring(s.Meso)
                .. ", uses=" .. tostring(s.LoanUseCount) .. ")")
            return
        end
        local amount = self:GetCurrentRepaymentOf(s)
        s.Meso = s.Meso + amount
        s.Debt = s.Debt + amount
        s.LoanUseCount = s.LoanUseCount + 1
        self:UpdateCanLoan(s)
        log(self:Tag(s) .. "LOAN granted: +" .. tostring(amount) .. ", uses=" .. tostring(s.LoanUseCount)
            .. ", meso=" .. tostring(s.Meso) .. ", debt=" .. tostring(s.Debt))
    end

    @ExecSpace("Server")
    method void RequestDebugAddMeso()
        -- [DEBUG] 로비 디버그 버튼용 — 메소 1,000,000 즉시 지급(서버 권위). 밸런스 테스트 전용.
        local s = self:GetSession(senderUserId)
        self:DoDebugAddMeso(s)
        self:PushState(senderUserId)
    end

    @ExecSpace("ServerOnly")
    method void DoDebugAddMeso(table s)
        -- [DEBUG] 메소 +1,000,000. 대출/구매 게이팅에 영향 → 조건 재평가.
        s.Meso = s.Meso + 1000000
        self:UpdateCanLoan(s)
        log(self:Tag(s) .. "DEBUG +1,000,000 meso -> " .. tostring(s.Meso))
    end

    -- ═══════════════ 로비 상태 전이 API (Phase 5) ═══════════════

    @ExecSpace("Server")
    method void EnterActivity(string activity)
        -- 로비 → 활동 진입 전이. 허용된 활동만("cube"/"augment"/"finance"/"seasonpass"). UI/맵이 이 상태로 화면 전환. (lobby_hub.md §5)
        local s = self:GetSession(senderUserId)
        if self:IsSessionEndedOf(s) then
            self:PushState(senderUserId)
            return
        end
        if activity ~= "cube" and activity ~= "augment" and activity ~= "finance" and activity ~= "seasonpass" then
            log_warning(self:Tag(s) .. "enter rejected: bad activity '" .. tostring(activity) .. "'")
        else
            s.CurrentActivity = activity
            log(self:Tag(s) .. "activity -> " .. activity)
        end
        self:PushState(senderUserId)
    end

    @ExecSpace("Server")
    method void ReturnToLobby()
        -- 활동 종료 → 로비 복귀. (lobby_hub.md §5-7)
        local s = self:GetSession(senderUserId)
        s.CurrentActivity = "lobby"
        log(self:Tag(s) .. "activity -> lobby")
        self:PushState(senderUserId)
    end
end
