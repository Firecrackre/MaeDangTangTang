@Logic
script GameManager extends Logic
    -- 커닝시티 뒷골목 대장장이 — 플레이어 상태 관리자(서버 권위).
    -- 메커톤 범위: 단일 플레이어 세션을 가정한 전역 상태.
    --   (멀티플레이로 확장 시 userId별 상태 테이블 + @TargetUserSync로 교체)
    -- 모든 상태 변경은 서버에서만 일어나고, @Sync로 클라이언트에 반영된다.

    @Sync property integer Meso = 0            -- 보유 메소
    @Sync property string CurrentItemId = ""   -- 현재 보유 아이템(장비 id). 없으면 ""
    @Sync property integer CubeUseCount = 0    -- 누적 큐브 사용 횟수 ([6])
    @Sync property integer DebtStage = 0       -- 완료한 상환 단계 ([7])
    @Sync property boolean IsGameOver = false  -- 게임 오버 여부 ([7])
    -- 게임오버 원인(게임오버 UI '사망 원인' 표시용). "" = 게임오버 아님.
    --   "repayment"=상환액 미지불 / "debt"=빚 미지불 / "weapon"=무기 살 돈 부족 / "cube"=큐브 살 돈 부족
    @Sync property string GameOverReason = ""
    -- 승리 여부: 상환 winStage회(5주) 성공 시 true. (finance_management.md 승리 조건)
    @Sync property boolean IsVictory = false

    -- 빚 상환 상태 (concept §6-3, flow §15·§16)
    @Sync property integer CubesUntilRepayment = 0 -- 다음 상환까지 남은 큐브 횟수 ([6] HUD 표시용)
    @Sync property boolean IsRepaymentDue = false  -- 상환 시점 도달(미납) 여부
    @Sync property integer PendingRepayment = 0    -- 이번에 갚아야 할 금액

    -- 상점(무기 구매 UI) 상태.
    --   ShopSlots: 서버 권위 슬롯 배열 {{equipId, grade}, ...} (중첩이라 @Sync 불가 → 서버 보관).
    --   ShopSlotsData: 위 배열을 직렬화한 @Sync 문자열 "equipId:grade,equipId:grade,...". 클라가 파싱해 렌더.
    property any ShopSlots = nil
    @Sync property string ShopSlotsData = ""

    -- 구매한 아이템의 무기 등급 정보(상점 등급 = 기본 판매가 티어). 판매가 계산의 base로 사용.
    @Sync property integer CurrentBasePrice = 0    -- 현재 아이템의 기본 판매가(구매 등급 basePrice)
    @Sync property string CurrentWeaponGrade = ""  -- 현재 아이템의 무기 등급 key(Common/Rare/Epic/Unique/Legendary)

    -- 현재 아이템의 잠재 결과 요약(@Sync로 HUD가 읽음). 옵션 3줄 전체는 아래 CurrentPotential에 보관. (flow §8)
    @Sync property boolean HasPotential = false      -- 현재 아이템에 큐브를 1회 이상 사용했는지
    @Sync property string CurrentGrade = ""          -- 현재 잠재 등급(Rare/Epic/Unique/Legendary)
    @Sync property string CurrentResultType = ""     -- 조합 판정 결과(연출용 RAW 문자열)
    @Sync property integer CurrentPrice = 0          -- 현재 예상 판매가(파괴 시 0)
    @Sync property boolean IsCurrentDestroyed = false -- 현재 아이템 파괴 여부 (flow §14)
    -- 현재 판매가가 어떤 계산으로 나왔는지 사람이 읽는 수식 문자열(디버그/로그용). 파괴 시 "".
    --   서버가 RequestUseCube에서 PricingCalculator breakdown으로 1회 조립 → @Sync로 클라(스크래치 로그)에 전달.
    @Sync property string CurrentPriceFormula = ""

    -- 잠재 결과 전체(등급+옵션 3줄). 중첩 테이블이라 @Sync 불가 → 서버 권위 보관용.
    property any CurrentPotential = nil

    -- 옵션 3줄을 클라(스크래치 UI)에 전달하기 위한 @Sync 직렬화 문자열(ShopSlotsData와 동일 패턴).
    --   포맷: "grade;line;line;line", line = "label|value|unit|optionType|isBonus|isDestroy|isValid".
    --   isValid는 서버가 IsValidMain(현재장비, optionName)으로 계산(클라 신뢰 안 함). 없으면 "".
    @Sync property string CurrentPotentialData = ""

    -- ── 판매 통계(게임오버 기록용, flow §게임 오버 표시 정보) ──
    @Sync property integer TotalSellCount = 0   -- 판매 성공 누적 횟수
    @Sync property integer MaxSellPrice = 0     -- 한 번에 가장 비싸게 판 금액

    -- ── 일차(A안): 별도 시간 시스템 없이 DebtStage로 표시. 일차 = DebtStage + 1 ──
    --   (@Sync 불필요 — 클라가 DebtStage로 직접 계산. 서버 헤더 주석으로만 규약 고정.)

    -- ── 대장 기술(증강) 상태 (blacksmith_upgrade.md) ──
    --   OwnedAugments: 서버 권위 {key = stage} 테이블(중첩이라 @Sync 불가 → 서버 보관).
    --   AugmentsData: "key:stage,key:stage,..." 직렬화(@Sync, ShopSlotsData 패턴).
    property any OwnedAugments = nil
    @Sync property string AugmentsData = ""
    -- 획득 시 제시하는 3택 선택지(key CSV) + 대기 여부. 선택 전까지 유지.
    @Sync property string AugmentChoicesData = ""
    @Sync property boolean IsAugmentPending = false

    -- ── 재정 관리: 메소 대출 (finance_management.md) ──
    @Sync property integer LoanUseCount = 0      -- 사용한 대출 횟수
    @Sync property boolean CanLoan = false       -- 현재 대출 가능 여부(서버 판정, HUD/버튼 게이팅용)
    -- 대출로 누적된 갚아야 할 빚. 대출 1회당 원금×repayMultiplier(=원금의 2배) 증가.
    --   상환 시점(5/5)에 '상환 필요 메소 + 이 빚'을 전부 갚아야 다음 라운드로 진행한다. HUD '현재 빚' 별도 표시.
    @Sync property integer Debt = 0

    -- ── 로비 상태(전이 API) ──
    --   현재 어떤 활동에 있는지 서버 권위 상태. UI/맵이 이 값을 읽어 전환. (lobby_hub.md)
    --   "lobby" / "cube" / "augment" / "finance"
    @Sync property string CurrentActivity = "lobby"

    -- 게임오버 누적 기록용 DataStorage 핸들(OnBeginPlay에서 획득). Credit 절약 위해 게임오버 시에만 접근.
    property any recordStorage = nil

    @ExecSpace("ServerOnly")
    method void OnBeginPlay()
        -- 게임오버 기록용 영구 저장 핸들 준비(월드 전역 누적 기록). Get*DataStorage는 ServerOnly.
        --   handle 획득 자체는 Credit 0(None 그룹). 실제 Set/Get는 게임오버 시점에만.
        self.recordStorage = _DataStorageService:GetGlobalDataStorage("BlacksmithRecords")
        self:ResetSession()  -- 세션 시작값 세팅 (flow §5). 재시작도 동일 경로 재사용.
        log("[GameManager] session start. meso=" .. tostring(self.Meso)
            .. ", nextRepayIn=" .. tostring(self.CubesUntilRepayment))
    end

    @ExecSpace("ServerOnly")
    method void ResetSession()
        -- 한 판의 전체 상태를 시작값으로 초기화한다. OnBeginPlay + RequestRestart 공용 (flow §5, 재시작=전체 리셋).
        -- 설정은 BlacksmithConfig가 SSOT. DataStorage 누적 기록(recordStorage)은 여기서 건드리지 않는다.
        local d = _BlacksmithConfig:GetData()
        self.Meso = d.startMeso
        self.CurrentItemId = ""
        self.CubeUseCount = 0
        self.DebtStage = 0
        self.IsGameOver = false
        self.GameOverReason = ""
        self.IsVictory = false
        self.IsRepaymentDue = false
        self.PendingRepayment = 0
        -- 판매 통계 리셋 (Phase 1)
        self.TotalSellCount = 0
        self.MaxSellPrice = 0
        -- 증강 상태 리셋 (Phase 6·7)
        self.OwnedAugments = {}
        self.AugmentsData = ""
        self.AugmentChoicesData = ""
        self.IsAugmentPending = false
        -- 대출 상태 리셋 (Phase 9)
        self.LoanUseCount = 0
        self.Debt = 0
        self.CanLoan = false
        -- 로비 상태 리셋 (Phase 5)
        self.CurrentActivity = "lobby"
        self:UpdateRepaymentCountdown()  -- 시작 시 '다음 상환까지 남은 큐브' 표시 (flow §5-4)
        self:ResetPotentialState()
        self:RollShop()  -- 시작 시 상점 슬롯 구성 (concept §6-1)
        self:RollAugmentChoices()  -- 시작부터 대장 기술 3택 준비(구매형 상시 진입). blacksmith_upgrade.md §4
        self:UpdateCanLoan()
    end

    method boolean IsSessionEnded()
        -- 게임오버 또는 승리로 이번 판이 끝났는지(공용 가드). ExecSpace 없음 — 서버·클라 각자 로컬 판정.
        return self.IsGameOver or self.IsVictory
    end

    @ExecSpace("Server")
    method void RequestRestart()
        -- 재시작: 게임오버/승리 상태에서만 허용. 현재 판 전체 리셋(누적 기록은 보존). (flow §게임오버 §7)
        if not self:IsSessionEnded() then
            log_warning("[GameManager] restart rejected: session not ended")
            return
        end
        self:ResetSession()
        log("[GameManager] RESTART -> new session. meso=" .. tostring(self.Meso))
    end

    @ExecSpace("ServerOnly")
    method void RollShop()
        -- 상점 슬롯을 무작위로 재구성한다(서버 권위). 각 슬롯 = 무작위 무기 종류 + 무작위 무기 등급.
        -- 확률·등급은 BlacksmithConfig가 SSOT. 결과는 @Sync 문자열로 직렬화해 클라에 전달.
        -- 한 상점 내에서 동일 (무기종류+등급) 조합은 중복되지 않는다(같은 종류라도 등급이 다르면 허용).
        local d = _BlacksmithConfig:GetData()
        local order = d.equipmentOrder
        -- 증강 '더 좋은 물품 들여오기': 보유 단계의 절대 확률표 사용(0=기본표). (blacksmith_upgrade.md §6)
        local bgStage = self:GetAugmentStage("betterGoods")
        local probTable = _BlacksmithConfig:GetShopGradeProbTable(bgStage)
        local slots = {}
        local parts = {}
        local seen = {}
        for i = 1, d.shopSlotCount do
            local equipId, grade, rollValue, key
            local tries = 0
            repeat
                equipId = order[_UtilLogic:RandomIntegerRange(1, #order)]
                local rolled = _BlacksmithConfig:RollWeaponGradeDetail(bgStage)
                grade = rolled.grade
                rollValue = rolled.roll
                key = equipId .. ":" .. grade
                tries = tries + 1
            until seen[key] == nil or tries >= 50  -- 중복이면 재추첨(20조합이라 상한 도달 사실상 없음)
            seen[key] = true
            slots[i] = { equipId = equipId, grade = grade, roll = rollValue }
            parts[i] = key
        end
        self.ShopSlots = slots
        self.ShopSlotsData = table.concat(parts, ",")
        -- 상점 확률 로그(상시): 적용 중인 전체 확률표(누적 구간 포함) 1줄 + 슬롯별 무기·확률·실제 roll 값 1줄.
        --   roll은 0~100 랜덤 값 — 누적 구간(~60=커먼, ~90=레어 …)에 떨어진 위치가 곧 등급 판정 근거다.
        local tableParts = {}
        local acc = 0
        for _, gk in ipairs(d.weaponGradeOrder) do
            acc = acc + probTable[gk]
            table.insert(tableParts, d.weaponGrades[gk].label .. tostring(probTable[gk]) .. "%(~" .. tostring(acc) .. ")")
        end
        log("[RollShop] 등급 확률표(더좋은물품 " .. tostring(bgStage) .. "단계): " .. table.concat(tableParts, " "))
        local slotParts = {}
        for i, s in ipairs(slots) do
            local eqLabel = d.equipment[s.equipId].label
            local grLabel = d.weaponGrades[s.grade].label
            local rollStr = tostring(math.floor(s.roll * 10 + 0.5) / 10)
            table.insert(slotParts, "slot" .. tostring(i) .. "=" .. grLabel .. " " .. eqLabel
                .. "(" .. tostring(probTable[s.grade]) .. "%, roll=" .. rollStr .. ")")
        end
        log("[RollShop] " .. table.concat(slotParts, " "))
    end

    @ExecSpace("Server")
    method void RequestRefreshShop()
        -- '새로고침' 버튼: 메소 차감 없이 상점을 재추첨한다(개발/테스트 편의 + concept §6-1 선택 갱신).
        if self:IsSessionEnded() then
            log_warning("[GameManager] refresh rejected: session ended")
            return
        end
        self:RollShop()
    end

    @ExecSpace("Server")
    method void RequestBuyItem(integer slotIndex)
        -- 아이템 구매: 슬롯 인덱스 검증 → 등급 가격 차감 → 현재 아이템 등록 → 상점 재추첨 (flow §6).
        -- 클라 입력(slotIndex)은 신뢰하지 않고, 서버 자신의 ShopSlots에서 등급/가격을 읽어 검증한다(위조 차단).
        if self:IsSessionEnded() then
            log_warning("[GameManager] buy rejected: session ended")
            return
        end

        -- 상환 미납(5/5) 상태면 정산이 먼저 — sync 갭 프레임의 상점 구매 방지
        if self.IsRepaymentDue then
            log_warning("[GameManager] buy rejected: repayment due (settle first)")
            return
        end

        -- 현재 아이템이 있으면 새로 구매 불가 (flow §6 실패 처리)
        if self.CurrentItemId ~= "" then
            log_warning("[GameManager] buy rejected: already holding '" .. self.CurrentItemId .. "'")
            return
        end

        -- 슬롯 인덱스 유효성 검증 (서버 권위 ShopSlots 기준)
        if self.ShopSlots == nil or slotIndex < 1 or slotIndex > #self.ShopSlots then
            log_warning("[GameManager] buy rejected: invalid slot " .. tostring(slotIndex))
            return
        end
        local slot = self.ShopSlots[slotIndex]
        local eq = _BlacksmithConfig:GetEquipment(slot.equipId)
        local grade = _BlacksmithConfig:GetWeaponGrade(slot.grade)
        if eq == nil or grade == nil then
            log_warning("[GameManager] buy rejected: bad slot data " .. tostring(slot.equipId)
                .. "/" .. tostring(slot.grade))
            return
        end

        -- 증강 '가격 협상': 구매가 % 감소(미보유면 0%). (Phase 8)
        local buyCost = self:GetEffectiveBuyCost(grade.buyCost)

        -- 보유 메소 부족 시 구매 불가
        if self.Meso < buyCost then
            log_warning("[GameManager] buy rejected: not enough meso (" .. tostring(self.Meso)
                .. " < " .. tostring(buyCost) .. ")")
            return
        end

        self.Meso = self.Meso - buyCost
        self.CurrentItemId = slot.equipId
        self.CurrentBasePrice = grade.basePrice   -- 구매 등급의 기본 판매가(판매가 계산 base)
        self.CurrentWeaponGrade = slot.grade
        self:ResetPotentialState()  -- 새 아이템은 잠재 미사용 상태에서 시작
        self:RollShop()             -- 구매한 무기는 작업대로 가져갔으므로 상점을 새로 채운다
        self:UpdateCanLoan()
        log("[GameManager] bought '" .. grade.label .. " " .. eq.label .. "' (-"
            .. tostring(buyCost) .. " base=" .. tostring(grade.buyCost)
            .. "), basePrice=" .. tostring(self.CurrentBasePrice)
            .. ", meso=" .. tostring(self.Meso) .. ", item=" .. self.CurrentItemId)
        self:CheckStuckGameOver()
    end

    @ExecSpace("Server")
    method void RequestUseCube(string cubeType)
        -- 큐브 사용: 비용 차감 → 횟수 증가 → 잠재 판정 → 판매가 계산 → 결과 보관. (flow §7·§13)
        -- 최초 사용과 '한 번 더 사용하기'는 둘 다 "현재 아이템에 큐브 사용"이라 이 메서드로 함께 처리한다.
        -- cubeType: "weird"(이상한, 파괴 가능) / "master"(장인, 파괴 없음). 알 수 없으면 weird 폴백(클라 입력 불신).
        if self:IsSessionEnded() then
            log_warning("[GameManager] cube rejected: session ended")
            return
        end
        -- 상환 미납 상태면 먼저 갚아야 다음 큐브 사용 가능 (flow §15 "상환 먼저 처리 후 진행")
        if self.IsRepaymentDue then
            log_warning("[GameManager] cube rejected: repayment due (settle first)")
            return
        end
        -- 큐브 사용은 현재 아이템이 있을 때만 가능 (flow §7 기준)
        if self.CurrentItemId == "" then
            log_warning("[GameManager] cube rejected: no item")
            return
        end
        -- 파괴된 아이템에는 다시 큐브를 사용할 수 없다. 먼저 확인(파괴 정리)이 필요. (flow §14)
        if self.IsCurrentDestroyed then
            log_warning("[GameManager] cube rejected: item destroyed (confirm first)")
            return
        end

        local d = _BlacksmithConfig:GetData()
        -- 큐브 종류 해석(클라 입력 불신 → 서버가 config에서 비용/파괴여부 확정). 알 수 없으면 weird 폴백.
        local cube = _BlacksmithConfig:GetCube(cubeType)
        if cube == nil then
            cube = _BlacksmithConfig:GetCube("weird")
        end
        if self.Meso < cube.cost then
            log_warning("[GameManager] cube rejected: not enough meso (" .. tostring(self.Meso)
                .. " < " .. tostring(cube.cost) .. ")")
            return
        end

        -- 비용 차감 + 큐브 사용 횟수 1 증가 (flow §7-4·5).
        -- '한 번 더 사용하기' 시 기존 잠재/판매가는 새 결과로 덮어쓴다 (flow §13).
        self.Meso = self.Meso - cube.cost
        self.CubeUseCount = self.CubeUseCount + 1

        -- 상환 주기(기본 5회) 경계 도달 시 상환 예정 상태로 전환 (concept §6-3, flow §15).
        -- 실제 차감/게임오버는 RequestSettleDebt에서 처리(스크래치 결과 완료 후 호출).
        if self.CubeUseCount % d.debtCycle == 0 then
            local stage = self.CubeUseCount // d.debtCycle
            self.IsRepaymentDue = true
            -- 위험 거래(이자 증가)를 반영한 실효 상환금. 대출 빚(self.Debt)은 상환 시점에 별도 합산. (Phase 8·9)
            self.PendingRepayment = self:ComputeRepayment(stage)
            log("[GameManager] repayment DUE: stage=" .. tostring(stage)
                .. ", amount=" .. tostring(self.PendingRepayment))
        end
        self:UpdateRepaymentCountdown()

        -- 잠재능력 판정(서버 권위) → 판매가 계산(파괴면 Destroyed).
        -- 기본 판매가는 구매한 무기 등급(CurrentBasePrice)을 baseOverride로 넘긴다(상점 등급 = 기본 판매가).
        -- 파괴 허용 여부는 큐브 종류로 결정(장인의 큐브는 파괴 없음).
        -- 증강 '대장장이의 눈': 현재 무기 유효 옵션 강제 확률(%)을 판정 컨텍스트로 넘긴다. (Phase 8)
        local validForce = self:GetAugmentStageValueFor("smithEye")
        local pr = _PotentialService:RollPotential(cube.allowDestroy, self.CurrentItemId, validForce)
        pr.baseOverride = self.CurrentBasePrice
        local calc = _PricingCalculator:Calculate(self.CurrentItemId, pr)
        -- 증강 '위험 거래': 판매가 % 증가(파괴가 아닐 때만). (Phase 8)
        -- 계산식 로그용: riskyDeal 적용 전 가격(prePrice)과 증가율(riskPct)을 캡처해 둔다.
        local prePrice = calc.price
        local riskPct = 0
        if not calc.destroyed then
            riskPct = self:GetAugmentStageValueFor("riskyDeal")
            if riskPct > 0 then
                calc.price = math.floor((calc.price * (1 + riskPct / 100)) / 1000 + 0.5) * 1000
            end
        end

        -- 서버 권위 전체 결과 보관(옵션 3줄 포함) + 클라 전달용 직렬화.
        self.CurrentPotential = pr
        self.CurrentGrade = pr.grade
        self.CurrentResultType = pr.resultType
        self.CurrentPotentialData = self:SerializePotential(pr)
        self.HasPotential = true

        if calc.destroyed then
            -- 파괴: 판매가 0, 파괴 상태로 전환. 실제 아이템 제거는 확인(RequestConfirmDestroy) 시. (flow §14)
            self.IsCurrentDestroyed = true
            self.CurrentPrice = 0
            self.CurrentPriceFormula = ""
            log("[GameManager] cube used -> DESTROYED. item=" .. self.CurrentItemId
                .. ", cubeCount=" .. tostring(self.CubeUseCount) .. ", meso=" .. tostring(self.Meso))
        else
            self.IsCurrentDestroyed = false
            self.CurrentPrice = calc.price
            -- 판매가 계산식 문자열 조립(@Sync로 클라 스크래치 로그에 전달).
            self.CurrentPriceFormula = self:BuildPriceFormula(calc, prePrice, riskPct)
            log("[GameManager] cube used -> grade=" .. pr.grade .. ", type=" .. pr.resultType
                .. ", price=" .. tostring(calc.price) .. ", cubeCount=" .. tostring(self.CubeUseCount)
                .. ", meso=" .. tostring(self.Meso))
            log("[GameManager] price formula: " .. self.CurrentPriceFormula)
        end
        self:UpdateCanLoan()
        self:CheckStuckGameOver()
    end

    method string BuildPriceFormula(any calc, number prePrice, number riskPct)
        -- 판매가 계산식을 사람이 읽는 문자열로 조립(디버그/로그용, 파괴 아닐 때만 호출).
        --   형식: (기본 B + 옵션 O + 조합 C[key]) × 등급 G × 이탈 E = prePrice [× 위험거래(1+R%) = finalPrice]
        --   수치는 라인 로그와 동일하게 raw. 판매가 공식은 pricing_calculation.md §4.
        local comboStr = ""
        if calc.comboBonus ~= nil and calc.comboBonus > 0 then
            comboStr = " + 조합 " .. tostring(calc.comboBonus)
            if calc.comboKey ~= nil and calc.comboKey ~= "" then
                comboStr = comboStr .. "[" .. calc.comboKey .. "]"
            end
        end
        local f = "(기본 " .. tostring(calc.base) .. " + 옵션 " .. tostring(calc.optionBonusSum)
            .. comboStr .. ") x 등급 " .. tostring(calc.gradeMult)
            .. " x 이탈 " .. tostring(calc.bonusMult)
            .. " = " .. tostring(prePrice)
        if riskPct ~= nil and riskPct > 0 then
            f = f .. " x 위험거래(1+" .. tostring(riskPct) .. "%) = " .. tostring(calc.price)
        end
        return f
    end

    @ExecSpace("Server")
    method void RequestSellItem()
        -- 판매: 현재 예상 판매가만큼 메소 획득 → 아이템/잠재 상태 정리 → 아이템 선택 상태로. (flow §12)
        if self:IsSessionEnded() then
            log_warning("[GameManager] sell rejected: session ended")
            return
        end
        if self.CurrentItemId == "" then
            log_warning("[GameManager] sell rejected: no item")
            return
        end
        -- 파괴된 아이템은 판매할 수 없다. (flow §12·§14)
        if self.IsCurrentDestroyed then
            log_warning("[GameManager] sell rejected: item destroyed")
            return
        end
        -- 큐브 사용 여부에 따라 판매가를 서버가 권위 결정(클라 입력 불신):
        --   사용함 → 계산된 예상 판매가(CurrentPrice).
        --   미사용 → 기본 판매가(CurrentBasePrice)만 — 배수/보너스 없이. (데드락 탈출용 기본가 판매)
        local gain
        if self.HasPotential then
            gain = self.CurrentPrice
        else
            gain = self.CurrentBasePrice
        end
        local soldId = self.CurrentItemId
        self.Meso = self.Meso + gain
        -- 판매 통계 갱신(게임오버 기록용, Phase 1).
        self.TotalSellCount = self.TotalSellCount + 1
        if gain > self.MaxSellPrice then self.MaxSellPrice = gain end
        self:ClearItem()
        self:UpdateCanLoan()
        log("[GameManager] sold '" .. soldId .. "' (+" .. tostring(gain)
            .. "), potential=" .. tostring(self.HasPotential) .. ", meso=" .. tostring(self.Meso)
            .. ", totalSells=" .. tostring(self.TotalSellCount) .. ", maxPrice=" .. tostring(self.MaxSellPrice))
        -- 스턱(weapon) 판정은 상점 화면 표시 시점(RequestShopStuckCheck)으로 연기.
    end

    @ExecSpace("Server")
    method void RequestConfirmDestroy()
        -- 파괴 확인: 파괴된 아이템을 제거하고 아이템 선택 상태로 되돌린다. (flow §14-7·8)
        if self.CurrentItemId == "" then
            log_warning("[GameManager] confirm rejected: no item")
            return
        end
        if not self.IsCurrentDestroyed then
            log_warning("[GameManager] confirm rejected: item not destroyed")
            return
        end
        local lostId = self.CurrentItemId
        self:ClearItem()
        self:UpdateCanLoan()
        log("[GameManager] destroyed item '" .. lostId .. "' removed")
        -- 스턱(weapon) 판정은 상점 화면 표시 시점(RequestShopStuckCheck)으로 연기.
    end

    @ExecSpace("ServerOnly")
    method void ClearItem()
        -- 현재 아이템 제거 + 잠재 상태 초기화(판매·파괴 후 공통). (flow §12-5·§14-8)
        self.CurrentItemId = ""
        self.CurrentBasePrice = 0
        self.CurrentWeaponGrade = ""
        self:ResetPotentialState()
    end

    @ExecSpace("ServerOnly")
    method void ResetPotentialState()
        -- 잠재 결과/판매가 관련 상태를 초기값으로 되돌린다.
        self.CurrentPotential = nil
        self.HasPotential = false
        self.CurrentGrade = ""
        self.CurrentResultType = ""
        self.CurrentPotentialData = ""
        self.CurrentPrice = 0
        self.CurrentPriceFormula = ""
        self.IsCurrentDestroyed = false
    end

    @ExecSpace("ServerOnly")
    method string SerializePotential(any pr)
        -- 잠재 결과(등급+옵션 3줄)를 @Sync 문자열로 직렬화한다(클라 스크래치 UI가 파싱해 표시).
        --   포맷: "cubeCount;grade;line;line;line", line = "label|value|unit|optionType|isBonus|isDestroy|isValid".
        --   맨 앞 cubeCount는 매 큐브 사용마다 값이 달라지게 해 클라가 동일 결과 재추첨도 변화로 감지하게 한다.
        --   isValid는 주요 옵션의 장비 유효성(서버 판정). 비주요(잡옵/파괴)는 0.
        local parts = { tostring(self.CubeUseCount), pr.grade }
        for _, o in ipairs(pr.options) do
            local isValid = 0
            if o.optionType == "Main" and _BlacksmithConfig:IsValidMain(self.CurrentItemId, o.optionName) then
                isValid = 1
            end
            local line = o.label .. "|" .. tostring(o.value) .. "|" .. o.unit .. "|" .. o.optionType
                .. "|" .. (o.isBonusValue and "1" or "0")
                .. "|" .. (o.isDestroy and "1" or "0")
                .. "|" .. tostring(isValid)
            table.insert(parts, line)
        end
        return table.concat(parts, ";")
    end

    @ExecSpace("Server")
    method void RequestSettleDebt()
        -- 빚 상환: 상환 시점 도달 시 메소 차감, 부족하면 게임오버. (flow §15·§16)
        -- UI는 다음주 정산 팝업(NextWeekManager)이 로비 복귀 시 호출한다 (flow §15).
        if self:IsSessionEnded() then return end
        if not self.IsRepaymentDue then
            log_warning("[GameManager] settle rejected: no repayment due")
            return
        end

        -- 상환 필요 메소 + 대출로 누적된 빚을 전부 갚아야 다음 주로 진행한다(finance §, 유저 확정).
        local amount = self.PendingRepayment + self.Debt
        if self.Meso >= amount then
            self.Meso = self.Meso - amount
            self.Debt = 0
            self.DebtStage = self.DebtStage + 1
            self.IsRepaymentDue = false
            self.PendingRepayment = 0
            self:UpdateRepaymentCountdown()
            self:UpdateCanLoan()
            log("[GameManager] debt settled: stage=" .. tostring(self.DebtStage)
                .. ", -" .. tostring(amount) .. ", meso=" .. tostring(self.Meso)
                .. ", nextRepayIn=" .. tostring(self.CubesUntilRepayment))
            -- 승리 판정: winStage회(5주) 상환 성공 시 승리 (finance_management.md 승리 조건).
            local winStage = _BlacksmithConfig:GetData().winStage
            if self.DebtStage >= winStage then
                self.IsVictory = true
                self:UpdateCanLoan()
                log("[GameManager] VICTORY: " .. tostring(self.DebtStage) .. "주 상환 완료. meso="
                    .. tostring(self.Meso) .. ", cubes=" .. tostring(self.CubeUseCount))
                return
            end
            -- (증강은 상환 보상이 아니라 골드 구매형 — RollAugmentChoices는 여기서 호출하지 않는다.
            --  구매형 전환: 3택은 ResetSession에서 1회 롤 + 구매 성공(RequestSelectAugment) 시 재추첨. blacksmith_upgrade.md §3·§4)
            log("[GameManager] NEXT WEEK: day=" .. tostring(self:GetCurrentDay())
                .. "주차, nextRepay=" .. tostring(self:GetCurrentRepayment()))
            -- ⚠ 여기서 스턱(weapon) 판정을 하지 않는다 — 판정은 플레이어가 무기 상점 화면을 열어
            --   슬롯이 표시된 시점(RequestShopStuckCheck)에만 수행한다(유저 확정: 로비에서 즉사 금지).
        else
            -- 상환 실패 → 게임 오버 (flow §16). 원인: 상환액 자체가 부족 vs 빚까지는 부족.
            --   메소는 차감하지 않는다(게임오버 기록의 finalMeso 보존, 차감 연출은 클라 표시 전용).
            self.GameOverReason = (self.Meso < self.PendingRepayment) and "repayment" or "debt"
            self.IsGameOver = true
            self:UpdateCanLoan()
            self:RecordGameOver()
            log("[GameManager] GAME OVER(" .. self.GameOverReason .. "): cannot repay "
                .. tostring(amount) .. " (meso=" .. tostring(self.Meso) .. ")")
        end
    end

    @ExecSpace("Server")
    method void RequestShopStuckCheck()
        -- 무기 상점 화면에 슬롯이 표시된 시점에 클라(WeaponShopManager)가 호출하는 판정 트리거.
        -- 클라 입력이 없고(타이밍 신호만) 판정은 전부 서버 권위(CheckStuckGameOver)라 위조 위험 없음.
        -- weapon 스턱 판정은 이 경로로만 발동한다 — 로비/정산 직후에는 판정하지 않음(유저 확정).
        if self:IsSessionEnded() then return end
        if self.IsRepaymentDue then return end     -- 정산이 우선
        if self.CurrentItemId ~= "" then return end -- 상점 컨텍스트(아이템 미보유)에서만
        self:CheckStuckGameOver()
    end

    @ExecSpace("ServerOnly")
    method void CheckStuckGameOver()
        -- 스턱 게임오버 판정: 대출까지 소진했는데 다음 행동(무기/큐브 구매)이 완전히 막히면 게임오버.
        --   (weapon_shop/finance 기획 — 대출 유도 팝업이 떴던 상황이 대출 소진 후 재발하면 게임오버)
        -- ⚠ UpdateCanLoan 내부에서 호출 금지 — ResetSession 경유 시작 시점 오발동 위험.
        -- 호출 지점: weapon(미보유) = RequestShopStuckCheck(상점 화면 표시 시점) /
        --            cube(보유)   = RequestUseCube·RequestBuyItem 말미.
        if self:IsSessionEnded() then return end
        if self.IsRepaymentDue then return end  -- 정산이 우선(정산 결과에서 별도 판정)
        local loan = _BlacksmithConfig:GetLoanConfig()
        if self.LoanUseCount < loan.maxUses then return end  -- 대출 여지가 남아 있으면 스턱 아님
        local reason = ""
        if self.CurrentItemId == "" then
            -- 아이템 미보유: 현재 상점 3슬롯 전부 실효 구매가 초과 → 무기를 살 수 없음(새로고침은 디버그 전용).
            local minBuy = -1
            if self.ShopSlots ~= nil then
                for _, slot in ipairs(self.ShopSlots) do
                    local g = _BlacksmithConfig:GetWeaponGrade(slot.grade)
                    if g ~= nil then
                        local c = self:GetEffectiveBuyCost(g.buyCost)
                        if minBuy < 0 or c < minBuy then minBuy = c end
                    end
                end
            end
            if minBuy < 0 or self.Meso < minBuy then
                reason = "weapon"
            end
        elseif not self.IsCurrentDestroyed then
            -- 아이템 보유: 큐브도 못 사고, 지금 팔아도 상점 최저가에 못 미치면 완전 스턱.
            --   (판매로 살아날 수 있으면 게임오버 아님 — 판 뒤 미보유 판정("weapon")이 이어서 잡는다.)
            local weird = _BlacksmithConfig:GetCube("weird")
            local cubeCost = (weird ~= nil) and weird.cost or 0
            if self.Meso < cubeCost then
                local sellGain = self.HasPotential and self.CurrentPrice or self.CurrentBasePrice
                local minBuy = -1
                if self.ShopSlots ~= nil then
                    for _, slot in ipairs(self.ShopSlots) do
                        local g = _BlacksmithConfig:GetWeaponGrade(slot.grade)
                        if g ~= nil then
                            local c = self:GetEffectiveBuyCost(g.buyCost)
                            if minBuy < 0 or c < minBuy then minBuy = c end
                        end
                    end
                end
                if minBuy >= 0 and (self.Meso + sellGain) < minBuy then
                    reason = "cube"
                end
            end
        end
        if reason == "" then return end
        self.GameOverReason = reason
        self.IsGameOver = true
        self:UpdateCanLoan()
        self:RecordGameOver()
        log("[GameManager] GAME OVER(" .. reason .. "): stuck with no loan left. meso="
            .. tostring(self.Meso) .. ", item=" .. tostring(self.CurrentItemId))
    end

    @ExecSpace("ServerOnly")
    method void UpdateRepaymentCountdown()
        -- 다음 상환까지 남은 큐브 횟수 갱신. 미납 상태면 0으로 표시. (concept §6-4, [6])
        local d = _BlacksmithConfig:GetData()
        if self.IsRepaymentDue then
            self.CubesUntilRepayment = 0
            return
        end
        self.CubesUntilRepayment = d.debtCycle - (self.CubeUseCount % d.debtCycle)
    end

    method any GetCurrentEquipment()
        -- 현재 보유 아이템의 장비 정의 반환. 없으면 nil. (후속 단계/UI에서 사용)
        if self.CurrentItemId == "" then return nil end
        return _BlacksmithConfig:GetEquipment(self.CurrentItemId)
    end

    method integer GetCurrentDay()
        -- 일차 = 완료 상환 단계 + 1 (A안). 로비/HUD '현재 날짜' 표시용 계산 규약. (lobby_hub.md §4)
        return self.DebtStage + 1
    end

    method integer GetCurrentRepayment()
        -- 현재 '상환 필요 메소' 단일 진실값(서버·클라 공용, ExecSpace 없음).
        --   상환 미납(5/5)이면 실효 상환금 PendingRepayment, 아니면 다음 단계 원본 상환금 미리보기.
        --   HUD 표시·대출 금액·재정 정보가 모두 이 값을 SSOT로 쓴다(드리프트 방지).
        if self.PendingRepayment > 0 then return self.PendingRepayment end
        return _BlacksmithConfig:GetDebtAmount(self.DebtStage + 1)
    end

    -- ═══════════════ 대장 기술(증강) — 상태/선택 (Phase 6·7) ═══════════════

    method integer GetAugmentStage(string key)
        -- 보유 증강의 현재 단계(0=미보유).
        if self.OwnedAugments == nil then return 0 end
        return self.OwnedAugments[key] or 0
    end

    method number GetAugmentStageValueFor(string key)
        -- 보유 중인 증강의 현재 단계 효과 수치. 미보유면 0. (효과 배선 공용 진입점)
        local stage = self:GetAugmentStage(key)
        if stage <= 0 then return 0 end
        return _BlacksmithConfig:GetAugmentStageValue(key, stage)
    end

    method integer GetSyncedAugmentStage(string key)
        -- @Sync AugmentsData("key:stage,...")에서 증강 단계 파싱. 미보유면 0.
        -- ⚠ OwnedAugments(서버전용 중첩테이블, @Sync 불가)를 읽는 GetAugmentStage와 달리, @Sync 문자열만
        --    파싱하므로 클라이언트 UI에서도 서버와 동일한 결과를 낸다(구매가 표시 정합용). ShopSlotsData 파싱 패턴.
        if self.AugmentsData == nil or self.AugmentsData == "" then return 0 end
        for token in string.gmatch(self.AugmentsData, "([^,]+)") do
            local k = string.match(token, "([^:]+):")
            local s = string.match(token, ":([^:]+)")
            if k == key then return tonumber(s) or 0 end
        end
        return 0
    end

    @ExecSpace("ServerOnly")
    method void SerializeAugments()
        -- OwnedAugments를 "key:stage,..." @Sync 문자열로 직렬화(augmentOrder 순서 유지). ShopSlotsData 패턴.
        local parts = {}
        local order = _BlacksmithConfig:GetAugmentOrder()
        for _, key in ipairs(order) do
            local stage = self:GetAugmentStage(key)
            if stage > 0 then
                table.insert(parts, key .. ":" .. tostring(stage))
            end
        end
        self.AugmentsData = table.concat(parts, ",")
    end

    @ExecSpace("ServerOnly")
    method void RollAugmentChoices()
        -- 3택 무작위 선택지 구성: 아직 최대 단계에 도달하지 않은 증강만 후보(3단계 소진 제외). (blacksmith_upgrade.md §5·§4)
        local d = _BlacksmithConfig:GetData()
        local pool = {}
        for _, key in ipairs(d.augmentOrder) do
            if self:GetAugmentStage(key) < d.augmentMaxStage then
                table.insert(pool, key)
            end
        end
        if #pool == 0 then
            -- 모든 증강 소진 → 대기 없음.
            self.AugmentChoicesData = ""
            self.IsAugmentPending = false
            log("[GameManager] no augment choices (all maxed)")
            return
        end
        -- Fisher-Yates 셔플 후 앞에서 choiceCount개 선택(중복 없음).
        for i = #pool, 2, -1 do
            local j = _UtilLogic:RandomIntegerRange(1, i)
            pool[i], pool[j] = pool[j], pool[i]
        end
        local n = math.min(d.augmentChoiceCount, #pool)
        local chosen = {}
        for i = 1, n do chosen[i] = pool[i] end
        self.AugmentChoicesData = table.concat(chosen, ",")
        self.IsAugmentPending = true
        log("[GameManager] augment choices: " .. self.AugmentChoicesData)
    end

    @ExecSpace("Server")
    method void RequestSelectAugment(string augmentKey)
        -- 증강 구매: 제시된 3택 중 하나를 골드로 구매(도달 단계 기준 비용 차감). 중복이면 단계 상승. (blacksmith_upgrade.md §3·§4)
        --   클라 입력 불신: 선택지 포함 여부·비용·단계 상한 모두 서버 권위 검증. 구매 성공 시 창을 재추첨한다(§4-4 새로고침).
        if self:IsSessionEnded() then return end
        if not self.IsAugmentPending then
            log_warning("[GameManager] augment buy rejected: none pending")
            return
        end
        -- 상환 미납(5/5) 상태면 정산이 우선.
        if self.IsRepaymentDue then
            log_warning("[GameManager] augment buy rejected: repayment due (settle first)")
            return
        end
        -- 서버 권위 선택지 검증(위조 차단).
        local offered = false
        for token in string.gmatch(self.AugmentChoicesData, "([^,]+)") do
            if token == augmentKey then offered = true break end
        end
        if not offered then
            log_warning("[GameManager] augment buy rejected: '" .. tostring(augmentKey) .. "' not offered")
            return
        end
        local def = _BlacksmithConfig:GetAugment(augmentKey)
        if def == nil then
            log_warning("[GameManager] augment buy rejected: unknown '" .. tostring(augmentKey) .. "'")
            return
        end
        local maxStage = _BlacksmithConfig:GetData().augmentMaxStage
        local cur = self:GetAugmentStage(augmentKey)
        if cur >= maxStage then
            log_warning("[GameManager] augment buy rejected: already max '" .. augmentKey .. "'")
            return
        end
        -- 구매 비용(도달할 단계 기준) 검증·차감. (blacksmith_upgrade.md §3)
        local cost = _BlacksmithConfig:GetAugmentCost(cur + 1)
        if self.Meso < cost then
            log_warning("[GameManager] augment buy rejected: not enough meso (" .. tostring(self.Meso)
                .. " < " .. tostring(cost) .. ")")
            return
        end
        self.Meso = self.Meso - cost
        if self.OwnedAugments == nil then self.OwnedAugments = {} end
        self.OwnedAugments[augmentKey] = cur + 1
        self:SerializeAugments()
        self:UpdateCanLoan()  -- 가격 협상 등 구매가에 영향 → 대출 조건 재평가.
        log("[GameManager] augment bought: " .. augmentKey .. " -> stage " .. tostring(cur + 1)
            .. " (-" .. tostring(cost) .. ", meso=" .. tostring(self.Meso) .. "), owned=" .. self.AugmentsData)
        -- 구매 완료 → 창 새로고침(재추첨). 3단계 소진 증강은 다음 풀에서 제외된다. (§4-4)
        self:RollAugmentChoices()
    end

    -- ═══════════════ 증강 효과 계산 헬퍼 (Phase 8) ═══════════════

    method integer GetEffectiveBuyCost(integer baseCost)
        -- 증강 '가격 협상' 구매가 감소(%) 적용. 1000단위 반올림. 미보유면 원가.
        -- @Sync AugmentsData 기반(GetSyncedAugmentStage)이라 서버 차감액과 클라 표시값이 항상 일치한다.
        local stage = self:GetSyncedAugmentStage("priceNego")
        if stage <= 0 then return baseCost end
        local pct = _BlacksmithConfig:GetAugmentStageValue("priceNego", stage)
        if pct <= 0 then return baseCost end
        local reduced = baseCost * (1 - pct / 100)
        return math.floor(reduced / 1000 + 0.5) * 1000
    end

    method integer ComputeRepayment(integer stage)
        -- 실효 상환금 = 기본 상환금 × (1 + 위험거래 이자%). 1000단위 반올림. (Phase 8)
        --   대출 빚(self.Debt)은 이 상환금과 별개로 상환 시점(RequestSettleDebt)에 합산한다.
        local base = _BlacksmithConfig:GetDebtAmount(stage)
        local riskPct = self:GetAugmentStageValueFor("riskyDeal")
        local amount = base * (1 + riskPct / 100)
        return math.floor(amount / 1000 + 0.5) * 1000
    end

    -- ═══════════════ 재정 관리 — 메소 대출 (Phase 9) ═══════════════

    @ExecSpace("ServerOnly")
    method void UpdateCanLoan()
        -- 대출 가능 여부 재계산: 게임오버 아님 + 사용 횟수 남음 + '다음 행동이 막힘'. (finance §2)
        --   현재 화면 상황(아이템 보유 여부)에 따라 '막힘'을 판정해 HUD 대출 유도 팝업 조건과 정합화한다.
        --     · 아이템 미보유(상점 화면): 상점 무기를 하나도 살 수 없음 = 막힘.
        --     · 아이템 보유(스크래치 화면): 이상한 큐브를 살 수 없음 = 막힘(판매 탈출은 조건에서 제외, §2 문구).
        --   (아이템이 없으면 큐브를 쓸 대상 자체가 없으므로 큐브 비용은 무기 구매 불가만으로 판정한다.)
        local loan = _BlacksmithConfig:GetLoanConfig()
        if self:IsSessionEnded() or self.LoanUseCount >= loan.maxUses then
            self.CanLoan = false
            return
        end
        local stuck
        if self.CurrentItemId ~= "" then
            local weird = _BlacksmithConfig:GetCube("weird")
            local cubeCost = (weird ~= nil) and weird.cost or 0
            stuck = self.Meso < cubeCost
        else
            local minBuy = -1
            if self.ShopSlots ~= nil then
                for _, slot in ipairs(self.ShopSlots) do
                    local g = _BlacksmithConfig:GetWeaponGrade(slot.grade)
                    if g ~= nil then
                        local c = self:GetEffectiveBuyCost(g.buyCost)
                        if minBuy < 0 or c < minBuy then minBuy = c end
                    end
                end
            end
            stuck = (minBuy < 0) or (self.Meso < minBuy)
        end
        self.CanLoan = stuck
    end

    @ExecSpace("Server")
    method void RequestLoan()
        -- 메소 대출: 위기 대응. 조건 충족 시 즉시 지급 + 갚아야 할 빚 누적 + 사용 횟수 증가. (finance §2~§4)
        --   금액 규칙(유저 확정): 지급 메소 = 현재 상환 필요 메소만큼, 빚도 그만큼 증가.
        --   즉 상환 시점에 '상환 필요 메소 + 빚'을 한 번에 갚아야 한다(예: 상환 45,000이면 45,000 받고 빚 45,000 → 정산 90,000).
        if self:IsSessionEnded() then
            log_warning("[GameManager] loan rejected: session ended")
            return
        end
        self:UpdateCanLoan()
        if not self.CanLoan then
            log_warning("[GameManager] loan rejected: conditions not met (meso=" .. tostring(self.Meso)
                .. ", uses=" .. tostring(self.LoanUseCount) .. ")")
            return
        end
        local amount = self:GetCurrentRepayment()
        self.Meso = self.Meso + amount
        self.Debt = self.Debt + amount
        self.LoanUseCount = self.LoanUseCount + 1
        self:UpdateCanLoan()
        log("[GameManager] LOAN granted: +" .. tostring(amount) .. ", uses=" .. tostring(self.LoanUseCount)
            .. ", meso=" .. tostring(self.Meso) .. ", debt=" .. tostring(self.Debt))
    end

    -- ═══════════════ 로비 상태 전이 API (Phase 5) ═══════════════

    @ExecSpace("Server")
    method void EnterActivity(string activity)
        -- 로비 → 활동 진입 전이. 허용된 활동만("cube"/"augment"/"finance"). UI/맵이 이 상태로 화면 전환. (lobby_hub.md §5)
        if self:IsSessionEnded() then return end
        if activity ~= "cube" and activity ~= "augment" and activity ~= "finance" then
            log_warning("[GameManager] enter rejected: bad activity '" .. tostring(activity) .. "'")
            return
        end
        self.CurrentActivity = activity
        log("[GameManager] activity -> " .. activity)
    end

    @ExecSpace("Server")
    method void ReturnToLobby()
        -- 활동 종료 → 로비 복귀. (lobby_hub.md §5-7)
        self.CurrentActivity = "lobby"
        log("[GameManager] activity -> lobby")
    end

    -- ═══════════════ 게임오버 기록 (Phase 2) ═══════════════

    @ExecSpace("ServerOnly")
    method void RecordGameOver()
        -- 게임오버 시 최종 결과 5개 항목을 영구 저장. (flow §게임오버 표시 정보)
        -- ⚠ DataStorage는 Credit 과금 → 게임오버 1회성 이벤트에서만 호출(OnUpdate/타이머 금지). datastorage.md 준수.
        if self.recordStorage == nil then
            log_warning("[GameManager] record skip: no storage handle")
            return
        end
        local record = {
            finalMeso = self.Meso,
            totalCubes = self.CubeUseCount,
            totalSells = self.TotalSellCount,
            maxSellPrice = self.MaxSellPrice,
            finalDebtStage = self.DebtStage,
        }
        -- 마지막 판 기록(단일 키, 값 4KB 미만 → 1 Credit). 비동기 저장(프레임 보호).
        self.recordStorage:SetAsync("lastRun", _UtilLogic:TableToString(record), nil)
        log("[GameManager] game over recorded: meso=" .. tostring(record.finalMeso)
            .. ", cubes=" .. tostring(record.totalCubes) .. ", sells=" .. tostring(record.totalSells)
            .. ", maxPrice=" .. tostring(record.maxSellPrice) .. ", debtStage=" .. tostring(record.finalDebtStage))
    end
end
