@Component
script ScratchTicketManager extends Component
    -- 큐브 스크래치 UI (InGameMap). WeaponShop에서 무기 구매 → 큐브 선택/사용 → 은박 3줄 긁기 →
    -- 옵션 공개(등급/유효 색·무지개) → 판매가 표시 → 판매/재사용. 모든 판정은 서버(GameManager) 권위,
    -- 여기서는 표시/연출만 한다. (cube_scratch_system.md / potential_determination.md / concept.md)

    -- ===== Tunable (scratch mechanic) =====
    property integer GridWidth = 40           -- foil pixel-grid width per line
    property integer GridHeight = 8           -- foil pixel-grid height per line
    property number BrushRadius = 2.0         -- erase circle radius (pixel units)
    property number EraseStrength = 30        -- 0~100. 잡옵/일반 줄의 per-touch 알파 감소량(=강도/100). 특수 줄은 아래 값 사용.
    @DisplayName("특수옵션 긁기 강도(유효/이탈/파괴)")
    property number EraseStrengthSpecial = 9  -- 유효옵션/이탈/파괴 줄의 per-touch 강도(낮을수록 여러 번 긁어야 공개).
    property number CompletionThreshold = 0.7 -- 완료(공개) 기준 = 벗겨진 알파 비율. 잡옵/파괴 줄 기본값.
    @DisplayName("완료 기준: 긍정옵션(유효/이탈)")
    property number CompletionThresholdPositive = 0.6 -- 긍정 옵션(유효/이탈, 파괴 제외) 줄은 더 많이 긁어야 공개.
    property string TargetMapName = "InGameMap" -- gate the popup to this map
    property string ConfigDataSetName = "ScratchTicketConfig" -- grid/brush tuning data table
    property boolean UseConfigDataSet = false -- true면 CSV가 위 인스펙터 값을 덮어씀. false(기본)면 인스펙터가 SSOT.

    -- ===== Bound entities (UUIDs: existing preserved / new injected by UI builder) =====
    property Entity board = "7efccaf4-7947-4708-bb07-6a1aba564e1f"
    property Entity foil1 = "137cf37d-4610-46f1-bbcb-70a9b9fca425"
    property Entity foil2 = "a753c45e-fd5c-4840-a680-dab6c1e7edfd"
    property Entity foil3 = "f2274449-74b4-40be-a4e2-64fed4e6e72e"
    property Entity crumbLayer = "1da37c45-f05c-46c7-9ffa-0d9463c4e880"

    -- option line rows (show/hide) + reveal background (Prize) + option text (Label)
    property Entity ticket1 = "11fe1100-5975-4526-b3a6-9d5626f22dcf"
    property Entity ticket2 = "056716d0-067b-43e9-8423-449b65c19c20"
    property Entity ticket3 = "8d8db640-2bac-4e53-bcd6-95b8dadb1bc1"
    property SpriteGUIRendererComponent prize1 = "84efc92a-c8de-45ff-8bf3-245df42cd57f"
    property SpriteGUIRendererComponent prize2 = "7140993a-ccaa-4e26-9992-c1f5cdc7a211"
    property SpriteGUIRendererComponent prize3 = "1844ca64-6848-404f-a50e-0611449afdef"
    property TextComponent label1 = "983951a4-8e31-4fb7-9d7a-08f74dac26fc"
    property TextComponent label2 = "2a9c1ccf-6aee-4898-b442-01e3c3d82317"
    property TextComponent label3 = "d898eb75-1c65-48c9-8ab4-912b0ce643b7"

    -- center cube icon + bottom buttons (재사용 버튼 폐지 → 재굴림은 좌측 구매창 큐브 클릭)
    property Entity centerCube = "fb64e4b9-cff2-4105-ba21-2e8ca5d6b86d"
    property Entity sellButton = "c4912f88-2d35-4e7e-a1e2-b017fc3aa5e9"

    -- left cube selection
    property Entity cubeSelect = "e6cf1fe6-1ae7-4210-a570-d184ab37c929"
    property Entity cubeIconWeird = "bf940d39-30d2-461e-950d-628d6f09e300"
    property Entity cubeIconMaster = "d470d6e5-7882-4114-9835-d870e86ee22e"
    property Entity weirdBuyButton = "a7b556a9-bf0b-48e2-b0a3-35acd579dbe1"
    property Entity masterBuyButton = "f15c2ada-ee42-4391-b49e-2d0bb3bbdb6b"
    property TextComponent weirdBuyText = "a7b556a9-bf0b-48e2-b0a3-35acd579dbe1"
    property TextComponent masterBuyText = "f15c2ada-ee42-4391-b49e-2d0bb3bbdb6b"

    -- right price window
    property Entity priceWindow = "626f0e14-b1d2-455c-96b4-9f60e373e960"
    property TextComponent priceText = "18c964d8-d113-4dc4-84a4-308589167166"

    -- 실시간 판매가 상승 연출용(신규 UIBuilder → TextGUIRendererComponent). UUID는 UIBuilder가 주입.
    property TextGUIRendererComponent priceDelta = "b8cdf5d2-f5a6-4014-9c84-f3116f5d4c97"   -- "+15,000" 상승 델타 팝업

    -- 코인 낙하 풀(특별 수치 연출). CrumbLayer 패턴. UUID는 UIBuilder가 주입.
    property Entity coinLayer = "721cd088-6a34-4312-87e6-86af26b4ad8b"

    -- 포커스 스포트라이트 어둠 레이어(이탈/파괴 줄 긁는 중 — Top/Bottom/Left/Right 스트립 4장 컨테이너). UUID는 UIBuilder가 주입.
    property Entity focusDimLayer = "25627d38-9de1-4f77-b0dc-811d9632ecda"

    -- 이탈(유효+보너스) 줄 공개 순간 1회 터지는 폭죽 파티클(UIBasicParticle Firework). UUID는 UIBuilder가 주입.
    property Entity fireworkFX = "a9adaf51-6ac0-4086-87d1-4b3d80ef0149"
    @DisplayName("폭죽 위치 오프셋 Y(px)")
    property number FireworkOffsetY = 0   -- 공개된 줄 중심 기준 폭죽 발사 위치 보정(+위)

    -- 판매 결과 창(수령하기) — 판매 확정 → 무기 아이콘+판매가 표시 → 수령. UUID는 UIBuilder가 주입.
    property Entity saleResultGroup = "d0722bc8-8d08-41a3-8ec8-e15a2073f457"
    property Entity saleWeaponIcon = "1fdbda69-49f4-4637-98fe-4c8c927366b0"
    property TextGUIRendererComponent saleSoldText = "56ebc2fd-edd4-405e-8ad0-39ac5cc398ec"
    property Entity collectButton = "72cd7dfb-f8a0-4f8d-b03b-f14b71c8f499"

    -- 큐브 미사용 판매 확인 팝업 (UUID는 UIBuilder가 주입)
    property Entity confirmSellGroup = "4b0df76c-0733-4acc-9ebf-475ef86dd4d8"
    property TextComponent confirmMsgText = "8ecefcb6-39bc-4c16-9969-f40543a69141"
    property Entity confirmYesButton = "dcf518b3-d4fb-4727-8428-e63abaa3ccb5"
    property Entity confirmNoButton = "034fc2ae-2db4-48de-a6af-55eba6db0eec"

    -- ===== Silver crumb tuning =====
    property number CrumbSpawnChance = 0.4
    property number CrumbGravity = 1600
    property number CrumbFloorY = -540
    property number CrumbSize = 10

    -- ===== 실시간 판매가 카운트업 / 연출 튜닝 (인스펙터 SSOT) =====
    property number PriceScrollTime = 0.55      -- 판매가 숫자가 목표까지 올라가는 시간(초, ease-out)
    property number PricePunchScale = 1.22      -- 유효/이탈 공개 시 판매가창 펀치 최대 배율
    property number PricePunchTime = 0.35       -- 펀치 지속(초)
    property number PriceFlashTime = 0.5        -- 플래시 지속(초)
    property number DeltaRiseTime = 0.9         -- "+n" 델타 팝업 상승·페이드 시간(초)
    property number DeltaRiseDist = 46          -- 델타 팝업이 떠오르는 거리(px)

    -- ===== 큐브 구매창(CubeSelect) 슬라이드 전환 튜닝 (인스펙터 SSOT) =====
    property number CubeSlideOffset = 480       -- 큐브 사용 시 구매창이 보드 뒤로 밀려들어갈 X 거리(px, +=보드 방향). 도달 시 숨김.
    property number CubeSlideSpeed = 2400       -- 슬라이드 속도(px/s). 목표까지 선형 이동 후 스냅.

    -- ===== 복권 낙하 연출 튜닝 (인스펙터 SSOT) =====
    property number BoardDropOffsetY = 1000     -- 복권이 제자리 위에서 시작하는 높이(px). 이 높이에서 제자리로 낙하.
    property number BoardDropTime = 0.5         -- 낙하 지속(초, ease-out).
    property number BoardLandPunch = 1.08       -- 착지 시 board 살짝 팝 배율(1 이하면 팝 없음).

    -- ===== 등급별 복권 배경 RUID (인스펙터 SSOT, CubeBG_*) =====
    @DisplayName("배경 RUID: 커먼")     property string CubeBGCommon    = "03ed06c26f574137b79d1cbcd6727f7e"
    @DisplayName("배경 RUID: 레어")     property string CubeBGRare      = "01d770f859b44ac98136268a81cec2f8"
    @DisplayName("배경 RUID: 에픽")     property string CubeBGEpic      = "c20153c7284045f49bfc5d56ae8e5fdd"
    @DisplayName("배경 RUID: 유니크")   property string CubeBGUnique    = "b2ebd9cc51094c0f9360fa11480ef994"
    @DisplayName("배경 RUID: 레전더리") property string CubeBGLegendary = "917341095dbc43a691bf83d62c699783"

    -- ===== 등급 텍스트 라벨(TicketGradeText) — Board 상단, 등급명 + 상위 등급 애니메이션 =====
    property TextGUIRendererComponent ticketGradeText = "7df00a45-1e95-475e-890c-421013938033"
    -- Epic: 둥실둥실 부유
    property number GradeFloatAmp = 5           -- 부유 진폭(px)
    property number GradeFloatPeriod = 2.6      -- 부유 한 사이클 주기(초)
    -- Unique: 발광(소프트 헤일로 펄스 + 미세 브리딩)
    property number GradeGlowPeriod = 1.1       -- 발광 펄스 주기(초)
    property Color GradeGlowColor = Color(1, 0.95, 0.55, 1)  -- 헤일로 색(금빛)
    property number GradeGlowDilateMin = 0.0    -- 헤일로 두께 최소
    property number GradeGlowDilateMax = 0.45   -- 헤일로 두께 최대
    property number GradeGlowSoftness = 1.0     -- 헤일로 번짐(소프트니스)
    property number GradeGlowScaleMax = 1.05    -- 발광 브리딩 최대 배율
    -- Legendary: 물결(수직 사인 + Z회전 진동)
    property number GradeWaveAmp = 14           -- 물결 수직 진폭(px)
    property number GradeWavePeriod = 1.3       -- 물결 주기(초)
    property number GradeWaveRotDeg = 8         -- 물결 Z회전 진폭(도)

    -- ===== 옵션 라벨 공개 tweening 튜닝 (인스펙터 SSOT) =====
    property number LabelPunchTime = 0.45       -- 라벨 팝 지속(초)
    property number LabelPunchJunk = 1.10       -- 잡옵/비유효 팝 최대 배율
    property number LabelPunchValid = 1.35      -- 유효 팝 최대 배율
    property number LabelPunchBonus = 1.55      -- 이탈 팝 최대 배율
    property number LabelWobbleDeg = 8          -- 이탈 팝 시 Z회전 흔들림 최대 각(도)
    property number LabelShakeAmp = 6           -- 파괴 라벨 X 흔들림 진폭(px)

    -- ===== Prize 배경 이미지 RUID (인스펙터 SSOT) =====
    @DisplayName("Prize 기본(공개 전) 이미지") property string PrizeImgDefault = "d827c63248df4cfa9013fd87e0813233"
    @DisplayName("Prize 유효옵션 이미지")      property string PrizeImgValid   = "f6301348c0494d9e9e03911651371c5d"
    @DisplayName("Prize 이탈옵션 이미지")      property string PrizeImgBonus   = "9f6001ed507d443c9cb17963edd76728"
    @DisplayName("Prize 파괴옵션 이미지")      property string PrizeImgDestroy = "033bd0564f494ceea75192e443a79687"

    -- ===== Prize 박스 긍정 공개 강조(시소) 튜닝 (인스펙터 SSOT) =====
    property number PrizePunchTime  = 0.5   -- 강조 지속(초)
    property number PrizePunchScale = 1.12  -- 살짝 커지는 최대 배율(은은하게)
    property number PrizeSeesawDeg  = 6      -- 시소 Z회전 최대 각(도)
    property number PrizeSwayX      = 4      -- 좌우 흔들림 진폭(px)
    property number PrizeSwayY      = 4      -- 위아래 흔들림 진폭(px)

    -- ===== 이탈 옵션 별 파티클 (인스펙터 SSOT) =====
    @DisplayName("별 스프라이트/클립 RUID") property string StarRUID = "6bda1ce4971840bfa0f867e27aa75426"
    @DisplayName("별이 자체 애니메이션 클립인가") property boolean StarSelfAnimated = true  -- true=클립이 스스로 반짝임(코드 트윙클 끔), false=정적 스프라이트 코드 트윙클
    property number StarSpawnInterval = 0.11  -- 새 별 생성 간격(초). 작을수록 화려(동시수↑, 동시개수≈수명/간격)
    property number StarLifeMin = 0.6         -- 한 별 반짝임 지속 최소(초)
    property number StarLifeMax = 1.0         -- 한 별 반짝임 지속 최대(초)
    property number StarSizeMin = 16          -- 별 최소 크기(px)
    property number StarSizeMax = 30          -- 별 최대 크기(px)
    property number StarMarginX = 40          -- 박스 좌우 여백(별이 박스 밖으로 안 나가게)
    property number StarMarginY = 12          -- 박스 상하 여백(px)
    property number StarMaxSpinDeg = 60       -- 반짝이는 동안 회전 최대(도)
    property Color  StarTint = Color(1, 1, 1, 1)  -- 별 색조(원색). 알파는 트윙클로 덮어씀

    -- ===== 코인 낙하 연출 튜닝 =====
    property integer CoinGravity = 1500
    property number CoinFloorY = -560
    property integer CoinSizeW = 36
    property integer CoinSizeH = 31
    property number CoinSfxCooldown = 0.12      -- 코인 짤랑음 연속 재생 최소 간격(초)
    property integer CoinCountValid = 6         -- 유효 옵션 공개 시 방출 코인 수
    property integer CoinCountBonus = 12        -- 이탈 옵션 공개 시 방출 코인 수
    property integer CoinCountFinal = 20        -- 3줄 완료(대박) 시 방출 코인 수

    -- ===== 포커스 스포트라이트 튜닝(이탈/파괴 줄 긁는 중 줌인+어두워짐) (인스펙터 SSOT) =====
    property number FocusMaxZoom = 1.35         -- 완료 직전 최대 줌 배율(보드 가짜 카메라)
    property number FocusDimMaxAlpha = 0.82     -- 완료 직전 주변 어둠 최대 알파
    property number FocusEaseSpeed = 3.0        -- 줌/이동/어둠이 목표로 수렴하는 속도(1/s, 지수 lerp — 천천히 이동)
    property number FocusHolePadding = 26       -- 포커스 줄 주위 밝은 창 여백(px)
    property Color FocusDimColor = Color(0, 0, 0, 1)           -- 이탈 줄 어둠 색(알파는 긁기 진행률이 결정)
    property Color FocusDimColorDestroy = Color(0.06, 0, 0, 1) -- 파괴 줄 어둠 색(불안한 검붉음)

    -- ===== 효과음 RUID (docs/specs/soundlist.md) =====
    -- 옵션 공개 결과음(줄이 모두 공개될 때 1회). 서버 optionGroup(Attack/MainStat)+isValid+isBonus로 5분기.
    property string SfxOptionBad          = "a6f91022d4ca4238bcda3bc9fcafabc3"  -- 잡옵/비유효
    property string SfxOptionGood         = "ce686c2a652744cdbf1aa9f66399c843"  -- 유효 스탯(MainStat)
    property string SfxOptionJackpot      = "756bec092ef6470c98a30dd564219259"  -- 유효 공격계열(Attack: 공/마/보공)
    property string SfxOptionSuperJackpot = "d048171b80bc497292892b37229ca9dc"  -- 유효 스탯 이탈
    property string SfxOptionLegendary    = "f5fb4f53733a4327a6c4ba1445a6fced"  -- 유효 공격계열 이탈
    property string SfxOptionDestroy      = "4d3d9de1b72d48eeb9f76f3a144a9bee"  -- 장비 파괴
    -- 스크래치 루프음(긁는 동안 재생, 손 떼거나 완료 시 정지).
    property string SfxScratchLoop = "5ffcdd8177a943638529749d26627f67"
    property number SfxScratchLoopVolume = 0.8
    -- 무기 판매 결과음(유효 옵션 개수 0/1/2/3 → Low/Normal/High/Jackpot).
    property string SfxSaleLow     = "66f8bbbc1d6a4166973774960d7b1ea1"
    property string SfxSaleNormal  = "d879b6be959b4586b3a428b626605605"
    property string SfxSaleHigh    = "9b6e608ee81043f8bb045b07509f443d"
    property string SfxSaleJackpot = "2ba4a50df8df4b919b5670d48b72159f"
    -- UI 클릭음.
    property string SfxClickDefault = "b2b0b752bf914fb5abd885470c84c8fc"  -- 큐브 사용/수령
    property string SfxClickConfirm = "69f85d65004541db82615459032e1d4a"  -- 판매 확정
    property string SfxCoin = "acb0f70275b7422dbcc8a395cbbd9d28"          -- 코인 짤랑음(동전 낙하)
    property boolean scratchLoopOn = false   -- 스크래치 루프 재생 중 플래그(중복 PlayLoopSound 방지)

    -- ===== 마우스 커서 RUID (인스펙터 SSOT — 사용자가 스프라이트 RUID 입력. 비우면 기본 커서 유지) =====
    @DisplayName("커서: 은박 호버(금색 코인)") property string CursorGoldRUID = "02a489cccff24a139a6c3582a5871f58"     -- 은박 위 hover = 금색 메소 sprite(코인 낙하와 동일 아트)
    @DisplayName("커서: 긁는 중(금색 코인)")   property string CursorCopperRUID = "02a489cccff24a139a6c3582a5871f58"   -- 긁는 중도 금색 메소(사용자 요청). 동색 코인 있으면 인스펙터에서 교체.
    property Vector2 CursorHotspot = Vector2(0, 0)   -- 커서 핫스팟(이미지 기준점 보정)

    -- ===== Runtime state =====
    property any tickets = nil
    property any touchHandler = nil
    property any holdHandler = nil
    property boolean isActive = false
    property boolean scratchReady = false   -- 큐브 사용 후(은박 3줄 표시) 긁기 허용. 대기/맵이탈 시 false → 부스러기 방지.
    property any crumbs = nil
    property integer crumbCursor = 0

    property string lastPotentialData = ""
    property string lastCubeType = "weird"

    property any optionLines = nil       -- parsed 3-line data {label,value,unit,optionType,isBonus,isDestroy,isValid,revealed}
    property integer revealedCount = 0
    property any rainbowLines = nil      -- indices of revealed valid lines (rainbow + wave)
    property number rainbowTime = 0

    property boolean hoverWeird = false
    property boolean hoverMaster = false
    property number hoverTime = 0

    -- 은박 커서 상태: 긁는 중 잔여시간/현재 적용 커서("":기본/"gold"/"copper"). hover는 커서 위치 폴링(IsCursorOverFoil).
    property number scratchTimer = 0
    property string cursorNow = ""

    property boolean destroyPending = false
    property number destroyTimer = 0
    property number boardBaseX = 0

    -- 큐브 구매창 슬라이드 런타임 상태
    property number cubeSelectBaseX = 0      -- 노출(out) 위치 X(OnBeginPlay 캡처)
    property number cubeSelectCurX = 0       -- 현재 X(매 프레임 목표로 이동)
    property boolean cubeShownTarget = true  -- true=노출 위치로, false=보드 뒤(숨김) 위치로
    property boolean cubeBaseCaptured = false -- baseX 캡처 여부

    -- 큐브 구매 연출 중 재클릭 방지 가드(클라 로컬)
    property boolean cubePurchasePending = false  -- 구매 요청~구매창 재노출(또는 타임아웃)까지 클릭 차단
    property number cubePendingTimer = 0
    @MinValue(0.5) property number CubePendingTimeout = 2.5  -- 서버 거부(연출 미발생) 대비 안전 해제(초). 인스펙터 튜닝값(SSOT)

    -- 복권 배경(Bg) 교체 + 낙하 연출 런타임 상태
    property any bgSprite = nil               -- Board/Bg 의 SpriteGUIRendererComponent 캐시
    property any gradeBgMap = nil             -- 등급(Common..Legendary) → 배경 RUID 매핑
    property number boardRestY = 0            -- board 제자리 Y(OnBeginPlay 캡처)
    property number boardDropStartY = 0       -- 이번 낙하 시작 Y(제자리 + offset)
    property number dropT = -1               -- 낙하 경과(-1=비활성)
    property boolean boardLanded = false      -- 이번 낙하 착지 처리 완료 여부(1회 트리거)

    -- 등급 텍스트 라벨/애니 런타임 상태
    property any gradeTextLabel = nil         -- 등급 → 표시 라벨 매핑
    property any gradeTextAnim = nil          -- 등급 → 애니 모드(0 정적/1 부유/2 발광/3 물결) 매핑
    property integer gradeTextMode = 0        -- 현재 애니 모드
    property number gradeTextTime = 0         -- 애니 경과(초)
    property Vector2 gradeTextBasePos = Vector2(0, 0)  -- 텍스트 제자리 위치(캡처)
    property any gradeTextBaseColor = nil     -- 텍스트 기본 FontColor(캡처)
    property boolean gradeTextBaseCaptured = false     -- 베이스 캡처 여부

    -- 5/5(상환 미납) 도달 시 큐브 재사용·구매 잠금 상태 추적(레벨 구동 변화 감지)
    property boolean lastRepayDue = false

    -- 버튼별 저작 알파(투명 배경 버튼을 SetButtonEnabled이 흰색으로 덮지 않도록 기준값 보존). {[buttonEntity]=alpha}
    property any buttonBaseAlpha = nil
    -- 버튼 라벨(TextComponent) 저작 알파 — 비활성 시 글자/외곽선도 배경과 같이 흐려지게(복원용 기준값). {[buttonEntity]=alpha}
    property any buttonBaseFontAlpha = nil
    property any buttonBaseOutlineAlpha = nil

    -- 증강 '귀한 태생' 단계 추적(레벨 구동) — 변화 시 큐브 가격 라벨 재세팅. -1 = 미초기화.
    property integer lastCubeCostStage = -1

    property any clickRecords = nil      -- {entity, eventHandler} list for cube/buy/reuse/sell buttons
    property any enterRecords = nil      -- hover enter/exit handler records

    -- ===== 실시간 판매가 / 코인 / 판매결과 런타임 상태 =====
    property number displayedPrice = 0   -- 화면에 현재 표시 중인 판매가(카운트업 중간값)
    property number priceStart = 0       -- 카운트업 시작값
    property integer priceTarget = 0     -- 카운트업 목표값
    property number priceScrollT = -1    -- 카운트업 경과(-1=비활성)
    property boolean priceFrozen = false -- 파괴 시 카운트업 정지
    property integer revealedBonusSum = 0 -- 공개된 줄의 옵션 보너스 누적(기본가 위에 더함)

    property number priceFlashT = -1     -- 판매가 텍스트 플래시 경과
    property any priceFlashColor = nil   -- 플래시 색
    property number pricePunchT = -1     -- 판매가창 펀치 경과
    property number pricePunchPeak = 1.0 -- 이번 펀치 최대 배율

    property number deltaT = -1          -- 델타 팝업 경과
    property number deltaBaseY = 30      -- 델타 팝업 시작 y(런타임 계산)

    property any coins = nil             -- 코인 낙하 풀
    property integer coinCursor = 0
    property number coinSfxCd = 0        -- 코인음 쿨다운 타이머

    property boolean saleShown = false   -- 판매 결과 창 표시 상태(IsSalePending 에지 감지)

    property any labelFX = nil           -- 인덱스 1~3 옵션 라벨 공개 팝 상태 {t,peak,wobble,shake}
    property any prizeFX = nil           -- 인덱스 1~3 Prize 박스 긍정 공개 시소 상태 {t,baseX,baseY}
    property any prizeStars = nil        -- [박스1~3] = 별 레코드 풀 {entity,ui,sprite,t,dur,active,baseSize,spin}
    property any starEmit = nil          -- [박스1~3] = { active=bool, timer=number } (이탈 박스만 이멧)

    -- 포커스 스포트라이트 런타임 상태(이탈/파괴 줄 긁는 중 줌인+어두워짐).
    property integer focusIndex = 0      -- 0=비활성, 1~3=포커스 중인 줄
    property number focusZoomCur = 1.0   -- 현재 줌(수렴 중간값)
    property number focusDimCur = 0.0    -- 현재 어둠 알파(수렴 중간값)
    property number focusPanX = 0        -- 현재 보드 팬 오프셋 X(수렴 중간값)
    property number focusPanY = 0        -- 현재 보드 팬 오프셋 Y(수렴 중간값)
    property any focusStrips = nil       -- {Top,Bottom,Left,Right} = {ui,sprite} 스트립 캐시

    @ExecSpace("ClientOnly")
    method void OnBeginPlay()
        -- 큐브 스크래치 UI 초기화: 설정 로드 → foil/크럼 구성 → 입력/버튼/호버 연결 → 대기 상태로 숨김.
        -- 기본은 인스펙터 값을 SSOT로 사용(에디터에서 바꾸면 즉시 반영). CSV 구동을 원하면 UseConfigDataSet을 켠다.
        if self.UseConfigDataSet then self:LoadConfig() end
        self.tickets = {}
        self:RegisterTicket(1, self.foil1)
        self:RegisterTicket(2, self.foil2)
        self:RegisterTicket(3, self.foil3)
        self:BuildCrumbPool()
        self:BuildCoinPool()
        self:BuildStarPools()
        self:CacheFocusStrips()

        self.clickRecords = {}
        self.enterRecords = {}
        self.optionLines = {}
        self.rainbowLines = {}
        self:InitLabelFX()
        self:InitPrizeFX()
        self:InitPrizeStars()

        -- 스크린 터치(긁기)
        self.touchHandler = _InputService:ConnectEvent(ScreenTouchEvent, self.OnTouchBegin)
        self.holdHandler = _InputService:ConnectEvent(ScreenTouchHoldEvent, self.OnTouchHold)

        -- 큐브 선택(아이콘/구매버튼) → 사용/재굴림. 판매 버튼. (재사용 버튼 폐지)
        self:WireClick(self.cubeIconWeird, self.OnUseWeird)
        self:WireClick(self.weirdBuyButton, self.OnUseWeird)
        self:WireClick(self.cubeIconMaster, self.OnUseMaster)
        self:WireClick(self.masterBuyButton, self.OnUseMaster)
        self:WireClick(self.sellButton, self.OnSellClicked)
        self:WireClick(self.collectButton, self.OnCollectClicked)
        self:WireClick(self.confirmYesButton, self.OnConfirmSellYes)
        self:WireClick(self.confirmNoButton, self.OnConfirmSellNo)

        -- 큐브 아이콘 호버(부들부들) 연결
        self:WireHover(self.cubeIconWeird, self.OnWeirdEnter, self.OnWeirdExit)
        self:WireHover(self.cubeIconMaster, self.OnMasterEnter, self.OnMasterExit)


        -- 큐브 아이콘/구매 버튼 표시값(아이콘 RUID + 가격 라벨)
        self:InitCubeButtons()

        -- 각 버튼의 저작 알파 캡처(투명 배경 버튼을 SetButtonEnabled이 흰색으로 덮지 않도록 기준값 보존).
        --   ⚠ ResetToWaiting/SetButtonEnabled 호출 이전 시점이라 저작값이 온전하다.
        self.buttonBaseAlpha = {}
        self.buttonBaseFontAlpha = {}
        self.buttonBaseOutlineAlpha = {}
        for _, e in ipairs({ self.sellButton, self.cubeIconWeird, self.cubeIconMaster, self.weirdBuyButton, self.masterBuyButton }) do
            if isvalid(e) and isvalid(e.SpriteGUIRendererComponent) then
                self.buttonBaseAlpha[e] = e.SpriteGUIRendererComponent.Color.a
            end
            -- 라벨이 버튼 엔티티 자신의 TextComponent에 있음(자식 아님) → 저작 알파 캡처(비활성 복원용).
            if isvalid(e) and isvalid(e.TextComponent) then
                self.buttonBaseFontAlpha[e] = e.TextComponent.FontColor.a
                self.buttonBaseOutlineAlpha[e] = e.TextComponent.OutlineColor.a
            end
        end

        if isvalid(self.board) and isvalid(self.board.UITransformComponent) then
            self.boardBaseX = self.board.UITransformComponent.anchoredPosition.x
            self.boardRestY = self.board.UITransformComponent.anchoredPosition.y
        end

        -- 복권 배경(Bg) 스프라이트 캐시 + 등급→배경 RUID 매핑 구성.
        self:CacheGradeBg()

        -- 큐브 구매창 노출 위치(out) 캡처 → 이 위치에서 보드 뒤로 슬라이드.
        if isvalid(self.cubeSelect) and isvalid(self.cubeSelect.UITransformComponent) then
            self.cubeSelectBaseX = self.cubeSelect.UITransformComponent.anchoredPosition.x
            self.cubeSelectCurX = self.cubeSelectBaseX
            self.cubeBaseCaptured = true
        end

        -- 렌더 순서 강제: 흰 배경판은 맨 뒤로, 은색 부스러기는 UI 맨 위로.
        self:FixRenderOrder()

        -- 시작은 숨김(맵 게이팅 gotcha 회피: 명시적으로 끈다).
        -- 델타 팝업 시작 y 캡처(있으면).
        if isvalid(self.priceDelta) and isvalid(self.priceDelta.Entity)
            and isvalid(self.priceDelta.Entity.UITransformComponent) then
            self.deltaBaseY = self.priceDelta.Entity.UITransformComponent.anchoredPosition.y
        end

        self.isActive = false
        self.lastPotentialData = "\0"
        self.saleShown = false
        self:HideConfirmSell()
        self:HideSaleResult()
        self:SetContainersActive(false)
        self:ResetToWaiting()
        log("[ScratchTicket] OnBeginPlay map=" .. self.TargetMapName .. " grid=" .. self.GridWidth .. "x" .. self.GridHeight)
    end

    @ExecSpace("ClientOnly")
    method void WireClick(Entity e, any callback)
        -- 버튼 엔티티의 클릭 이벤트 연결(Entity에서 ConnectEvent). 핸들러는 해제용으로 보관.
        if not isvalid(e) then return end
        local h = e:ConnectEvent(ButtonClickEvent, callback)
        table.insert(self.clickRecords, { entity = e, eventHandler = h })
    end

    @ExecSpace("ClientOnly")
    method void WireHover(Entity e, any onEnter, any onExit)
        -- UI 포인터 진입/이탈 이벤트 연결(PC 호버). 핸들러는 해제용으로 보관.
        if not isvalid(e) then return end
        local he = e:ConnectEvent(UITouchEnterEvent, onEnter)
        local hx = e:ConnectEvent(UITouchExitEvent, onExit)
        table.insert(self.enterRecords, { entity = e, enterH = he, exitH = hx })
    end

    @ExecSpace("ClientOnly")
    method void InitCubeButtons()
        -- 큐브 아이콘 이미지(plain RUID) + 구매 버튼 가격 라벨을 config에서 채운다.
        --   가격은 증강 '귀한 태생' 단계 연동 실효가(GetSyncedCubeCost) — 단계 변화 시 RefreshCubeCost가 재세팅한다.
        local weird = _BlacksmithConfig:GetCube("weird")
        local master = _BlacksmithConfig:GetCube("master")
        if weird ~= nil then
            self:SetIcon(self.cubeIconWeird, weird.icon, Color(1, 1, 1, 1))  -- 실제 큐브 아트 본색
            if isvalid(self.weirdBuyText) then
                self.weirdBuyText.Text = weird.label .. "\n" .. self:Comma(_GameManager:GetSyncedCubeCost("weird")) .. " 메소"
            end
        end
        if master ~= nil then
            self:SetIcon(self.cubeIconMaster, master.icon, Color(1, 1, 1, 1))  -- 실제 큐브 아트 본색
            if isvalid(self.masterBuyText) then
                self.masterBuyText.Text = master.label .. "\n" .. self:Comma(_GameManager:GetSyncedCubeCost("master")) .. " 메소"
            end
        end
        self.lastCubeCostStage = _GameManager:GetSyncedAugmentStage("innateGrade")
    end

    @ExecSpace("ClientOnly")
    method void RefreshCubeCost()
        -- 증강 '귀한 태생' 단계 변화 시 큐브 가격 라벨을 재세팅한다(레벨 구동, InitCubeButtons 재사용).
        local stage = _GameManager:GetSyncedAugmentStage("innateGrade")
        if stage == self.lastCubeCostStage then return end
        self:InitCubeButtons()
    end

    @ExecSpace("ClientOnly")
    method void SetIcon(Entity e, string ruid, any tint)
        -- 엔티티의 SpriteGUIRendererComponent.ImageRUID 설정(plain 스프라이트 RUID) + 틴트(흰색=본색).
        if not isvalid(e) then return end
        local spr = e.SpriteGUIRendererComponent
        if isvalid(spr) then
            spr.ImageRUID = ruid
            if tint ~= nil then spr.Color = tint end
        end
    end

    @ExecSpace("ClientOnly")
    method void LoadConfig()
        -- grid/brush/strength/threshold만 데이터테이블에서 읽는다(맵 이름은 InGameMap 고정 — CSV 무시).
        local ds = _DataService:GetTable(self.ConfigDataSetName)
        if ds == nil then return end
        local row = ds:FindRow("key", "default")
        if row == nil then return end
        self.GridWidth = math.floor(self:ConfigNumber(row, "GridWidth", self.GridWidth))
        self.GridHeight = math.floor(self:ConfigNumber(row, "GridHeight", self.GridHeight))
        self.BrushRadius = self:ConfigNumber(row, "BrushRadius", self.BrushRadius)
        self.EraseStrength = self:ConfigNumber(row, "EraseStrength", self.EraseStrength)
        self.CompletionThreshold = self:ConfigNumber(row, "CompletionThreshold", self.CompletionThreshold)
    end

    @ExecSpace("ClientOnly")
    method number ConfigNumber(any row, string columnName, number fallback)
        -- 문자열 셀 → 숫자. 비었거나 파싱 실패면 fallback.
        local cell = row:GetItem(columnName)
        if cell == nil or cell == "" then return fallback end
        local n = tonumber(cell)
        if n == nil then return fallback end
        return n
    end

    @ExecSpace("ClientOnly")
    method void RegisterTicket(integer index, Entity foilEntity)
        -- 한 줄의 은박 픽셀 그리드를 은색·알파1로 초기화하고 상태를 기록한다.
        if not isvalid(foilEntity) then return end
        local pixel = foilEntity.PixelGUIRendererComponent
        local ui = foilEntity.UITransformComponent
        local W = self.GridWidth
        local H = self.GridHeight
        pixel:ResetWithColor(W, H, Color(0.78, 0.78, 0.82, 1.0))
        local alpha = {}
        for i = 1, W * H do
            alpha[i] = 1.0
        end
        self.tickets[index] = {
            index = index, pixel = pixel, ui = ui, alpha = alpha,
            cleared = 0, total = W * H, completed = false,
        }
    end

    @ExecSpace("ClientOnly")
    method void BuildCrumbPool()
        -- CrumbLayer 아래 미리 만든 은박 조각 스프라이트들을 풀로 수집(전부 비활성 시작).
        self.crumbs = {}
        self.crumbCursor = 0
        if not isvalid(self.crumbLayer) then return end
        for _, c in ipairs(self.crumbLayer.Children:ToTable()) do
            c.Enable = false
            if self.CrumbSize > 0 then
                c.UITransformComponent.RectSize = Vector2(self.CrumbSize, self.CrumbSize)
            end
            table.insert(self.crumbs, { entity = c, ui = c.UITransformComponent, vx = 0, vy = 0, active = false })
        end
    end

    @ExecSpace("ClientOnly")
    method void FixRenderOrder()
        -- UI 형제 렌더 순서는 배열 순서로 결정되므로(.ui displayOrder만으로는 런타임 보장 안 됨)
        -- SetSiblingIndex로 확정한다: 흰 배경판(Board/Bg)은 Board 자식 중 맨 뒤(먼저 그림),
        -- 은색 부스러기(CrumbLayer)는 루트 자식 중 맨 앞(가장 나중에 그림 = UI 최상단).
        if isvalid(self.board) then
            local bg = self.board:GetChildByName("Bg", false)
            if isvalid(bg) and isvalid(bg.UITransformComponent) then
                _UILogic:SetSiblingIndex(bg.UITransformComponent, 0)
            end
        end
        -- 큐브 구매창은 루트 형제 중 맨 뒤(먼저 그림)로 → 슬라이드 인 시 보드에 가려져 "뒤로 들어가" 사라진다.
        if isvalid(self.cubeSelect) and isvalid(self.cubeSelect.UITransformComponent) then
            _UILogic:SetSiblingIndex(self.cubeSelect.UITransformComponent, 0)
        end
        -- 앞으로 끌어올 순서: 포커스 어둠 → 폭죽 → 부스러기 → 코인 → 판매결과 창(마지막 호출이 가장 앞).
        --   FocusDim은 보드 위·부스러기 아래: 긁는 부스러기/코인은 어둠 위에 보인다. 폭죽은 보드 위에서 터진다.
        self:BringToFront(self.focusDimLayer)
        self:BringToFront(self.fireworkFX)
        self:BringToFront(self.crumbLayer)
        self:BringToFront(self.coinLayer)
        self:BringToFront(self.saleResultGroup)
    end

    @ExecSpace("ClientOnly")
    method void BringToFront(Entity e)
        -- 루트 형제 중 가장 뒤(배열 마지막 = 가장 나중에 그림 = 최상단)로 옮긴다.
        if not isvalid(e) or not isvalid(e.UITransformComponent) then return end
        local parent = e.Parent
        if isvalid(parent) then
            local n = #parent.Children:ToTable()
            _UILogic:SetSiblingIndex(e.UITransformComponent, n - 1)
        end
    end

    @ExecSpace("ClientOnly")
    method void OnUpdate(number delta)
        -- 게이팅 + 상태 폴링 + 연출 갱신.
        local lp = _UserService.LocalPlayer
        local onMap = isvalid(lp) and lp.CurrentMapName == self.TargetMapName
        -- 아이템 보유 중일 때만 스크래치 UI 활성(없으면 상점이 보임). 재정 관리 페이지가 열리면 숨긴다.
        local financeOpen = isvalid(_LobbyManager) and _LobbyManager.ActiveScreen == "finance"
        local active = onMap and (_GameManager.CurrentItemId ~= "") and (not financeOpen)
        if active ~= self.isActive then
            self.isActive = active
            self:SetContainersActive(active)
            if active then
                -- 활성 진입 시 현재 서버 상태 기준으로 재평가(다음 폴링이 처리하도록 sentinel).
                self.lastPotentialData = "\0"
                self.destroyPending = false
                self.lastRepayDue = _GameManager.IsRepaymentDue
                self.cubePurchasePending = false   -- 활성 진입 시 구매 가드 초기화(맵 재진입 대비)
                self:RefreshCubeLock()
            end
        end
        if not active then
            -- 비활성(맵 이탈/상점 화면/재정 열림) 진입 시 코인 커서가 남지 않도록 기본 커서로 원복(1회, 디듀프).
            if self.cursorNow ~= "" then
                self:ApplyCursor("")
            end
            return
        end

        -- 5/5(상환 미납) 상태 변화 감지 → 큐브 재사용·구매 버튼 잠금/해제 (팔기만 가능).
        -- IsRepaymentDue는 5번째 큐브 RPC 후 @Sync로 뒤늦게 켜지므로 레벨 구동으로 폴링한다.
        if _GameManager.IsRepaymentDue ~= self.lastRepayDue then
            self.lastRepayDue = _GameManager.IsRepaymentDue
            self:RefreshCubeLock()
        end

        -- 구매 가드 안전 해제: 서버가 요청을 거부(연출 미발생)하면 SetCubeSelectShown(true) 전이가 없어
        -- 플래그가 유지되므로, 타임아웃으로 재구매를 다시 허용한다(스턱 방지).
        if self.cubePurchasePending then
            self.cubePendingTimer = self.cubePendingTimer + delta
            if self.cubePendingTimer >= self.CubePendingTimeout then
                self.cubePurchasePending = false
            end
        end

        -- 증강 '귀한 태생' 단계 변화 감지 → 큐브 가격 라벨 갱신(구매로 큐브가가 오르면 즉시 반영).
        self:RefreshCubeCost()

        -- 잠재 데이터 변화 감지 → 대기/스크래치 세팅 전환.
        local pdata = _GameManager.CurrentPotentialData
        if pdata ~= self.lastPotentialData then
            self.lastPotentialData = pdata
            if pdata == "" then
                self:ResetToWaiting()
            else
                self:SetupScratch(pdata)
            end
        end

        -- 판매 확정(수령 대기) 에지 감지 → 판매 결과 창 표시/숨김.
        if _GameManager.IsSalePending and not self.saleShown then
            self:ShowSaleResult()
        elseif not _GameManager.IsSalePending and self.saleShown then
            self:HideSaleResult()
        end

        self:UpdateHoverFX(delta)
        self:UpdateFocus(delta)
        self:UpdateRainbow(delta)
        self:UpdateLabelFX(delta)
        self:UpdatePrizeFX(delta)
        self:UpdatePrizeStars(delta)
        self:UpdateDestroy(delta)
        self:UpdateCrumbs(delta)
        self:UpdatePriceScroll(delta)
        self:UpdatePriceFX(delta)
        self:UpdateCoins(delta)
        self:UpdateCubeSlide(delta)
        self:UpdateBoardDrop(delta)
        self:UpdateGradeTextFX(delta)
        self:UpdateCursor(delta)
    end

    @ExecSpace("ClientOnly")
    method void SetContainersActive(boolean on)
        -- 루트 직속 컨테이너들을 한꺼번에 토글(큐브선택/HUD). 판매가창은 별도(공개 완료 시만).
        -- board(복권)는 큐브 사용(낙하) 전까지 숨김 — 활성 진입 시에도 켜지 않는다(구매창만 노출).
        if not on then
            if isvalid(self.board) then self.board.Enable = false end
            self.dropT = -1   -- 진행 중 낙하 취소
        end
        -- 큐브 구매창은 슬라이드 상태로 관리(진입/이탈은 즉시 스냅). SetupScratch/OnAllRevealed이 인/아웃 애니메이션.
        self:SetCubeSelectShown(on, true)
        if not on and isvalid(self.priceWindow) then self.priceWindow.Enable = false end
        if not on then self:HideConfirmSell() end
        if not on then self:HideSaleResult() end
        if not on then self:StopCoins() end
        if not on then self:EndFocus() end             -- 포커스 스포트라이트 잔상 방지(줌/어둠 원복).
        if not on then self.scratchReady = false end   -- 맵 이탈/아이템 없음 → 긁기 차단.
        -- 비활성 후에는 OnUpdate가 early return하여 UpdateCursor(루프 정지 에지)가 안 돌므로 여기서 명시 정지.
        if not on then self:SetScratchLoop(false) end
    end

    @ExecSpace("ClientOnly")
    method void SetCubeSelectShown(boolean shown, boolean instant)
        -- 큐브 구매창 노출/숨김 목표 설정. shown=true면 노출 위치(baseX)로, false면 보드 뒤(baseX+offset)로 슬라이드.
        -- instant=true면 즉시 스냅(진입/이탈 게이팅). 노출 시작 시 Enable=true, 숨김 도달 시 Enable=false.
        -- 5/5(상환 미납)이면 큐브 구매창을 절대 노출하지 않는다(판매만 가능). 판매 버튼은 Board 소속이라 영향 없음.
        --   모든 노출 경로(진입/대기/공개완료)를 이 한 곳에서 차단한다.
        if shown and _GameManager.IsRepaymentDue then shown = false end
        -- 구매창이 실제로 다시 노출되는 시점 = 재구매 허용(연출 종료/대기 복귀/재굴림 노출/활성 진입 공통 경로).
        if shown then self.cubePurchasePending = false end
        if not isvalid(self.cubeSelect) or not isvalid(self.cubeSelect.UITransformComponent) then return end
        if not self.cubeBaseCaptured then
            self.cubeSelectBaseX = self.cubeSelect.UITransformComponent.anchoredPosition.x
            self.cubeSelectCurX = self.cubeSelectBaseX
            self.cubeBaseCaptured = true
        end
        self.cubeShownTarget = shown
        if shown then self.cubeSelect.Enable = true end   -- 노출은 먼저 켜고 슬라이드
        if instant then
            local targetX = shown and self.cubeSelectBaseX or (self.cubeSelectBaseX + self.CubeSlideOffset)
            self.cubeSelectCurX = targetX
            local p = self.cubeSelect.UITransformComponent.anchoredPosition
            self.cubeSelect.UITransformComponent.anchoredPosition = Vector2(targetX, p.y)
            if not shown then self.cubeSelect.Enable = false end
        end
    end

    @ExecSpace("ClientOnly")
    method void UpdateCubeSlide(number delta)
        -- 큐브 구매창을 목표 X로 선형 이동(슬라이드). 숨김 목표 도달 시 Enable=false.
        if not isvalid(self.cubeSelect) or not isvalid(self.cubeSelect.UITransformComponent) then return end
        local targetX = self.cubeShownTarget and self.cubeSelectBaseX or (self.cubeSelectBaseX + self.CubeSlideOffset)
        if self.cubeSelectCurX == targetX then
            if (not self.cubeShownTarget) and self.cubeSelect.Enable then self.cubeSelect.Enable = false end
            return
        end
        local step = self.CubeSlideSpeed * delta
        local dx = targetX - self.cubeSelectCurX
        if math.abs(dx) <= step then
            self.cubeSelectCurX = targetX
        else
            self.cubeSelectCurX = self.cubeSelectCurX + (dx > 0 and step or -step)
        end
        local p = self.cubeSelect.UITransformComponent.anchoredPosition
        self.cubeSelect.UITransformComponent.anchoredPosition = Vector2(self.cubeSelectCurX, p.y)
        if (not self.cubeShownTarget) and self.cubeSelectCurX == targetX then
            self.cubeSelect.Enable = false
        end
    end

    @ExecSpace("ClientOnly")
    method void CacheGradeBg()
        -- Board/Bg 스프라이트 컴포넌트 캐시 + 등급→배경 RUID 매핑 테이블 구성(OnBeginPlay 1회).
        self.gradeBgMap = {
            Common = self.CubeBGCommon,
            Rare = self.CubeBGRare,
            Epic = self.CubeBGEpic,
            Unique = self.CubeBGUnique,
            Legendary = self.CubeBGLegendary,
        }
        if isvalid(self.board) then
            local bg = self.board:GetChildByName("Bg", false)
            if isvalid(bg) and isvalid(bg.SpriteGUIRendererComponent) then
                self.bgSprite = bg.SpriteGUIRendererComponent
            end
        end
        -- 등급 텍스트: 라벨/애니 모드 매핑 + 베이스(위치·색) 캡처.
        self.gradeTextLabel = {
            Common = "Common Cube", Rare = "Rare Cube", Epic = "Epic Cube",
            Unique = "Unique Cube", Legendary = "Legendary Cube",
        }
        -- Epic·Unique·Legendary 모두 발광(mode 2)으로 통일(부유/물결 폐기).
        self.gradeTextAnim = { Common = 0, Rare = 0, Epic = 2, Unique = 2, Legendary = 2 }
        if isvalid(self.ticketGradeText) and isvalid(self.ticketGradeText.Entity)
            and isvalid(self.ticketGradeText.Entity.UITransformComponent) then
            self.gradeTextBasePos = self.ticketGradeText.Entity.UITransformComponent.anchoredPosition
            self.gradeTextBaseColor = self.ticketGradeText.FontColor
            self.gradeTextBaseCaptured = true
        end
    end

    @ExecSpace("ClientOnly")
    method void ApplyGradeBg(string grade)
        -- 잠재 등급(Common/Rare/Epic/Unique/Legendary)에 맞는 복권 배경으로 교체. 미지 등급이면 기존 배경 유지.
        if not isvalid(self.bgSprite) or self.gradeBgMap == nil then return end
        local ruid = self.gradeBgMap[grade]
        if ruid == nil or ruid == "" then
            log_warning("[ScratchTicket] unknown grade for Bg: " .. tostring(grade))
            return
        end
        self.bgSprite.ImageRUID = ruid
        log("[ScratchTicket] grade Bg applied: " .. grade)
    end

    @ExecSpace("ClientOnly")
    method void ApplyGradeText(string grade)
        -- 등급 텍스트 라벨을 '<Grade> Cube'로 세팅 + 애니 모드 선택(Epic 부유/Unique 발광/Legendary 물결).
        if not isvalid(self.ticketGradeText) then return end
        self:RestoreGradeText()   -- 등급 전환 시 이전 애니 잔상 원복
        if self.gradeTextLabel ~= nil then
            local label = self.gradeTextLabel[grade]
            if label ~= nil then
                self.ticketGradeText.Text = label
            else
                log_warning("[ScratchTicket] unknown grade for text: " .. tostring(grade))
            end
        end
        self.gradeTextMode = 0
        if self.gradeTextAnim ~= nil and self.gradeTextAnim[grade] ~= nil then
            self.gradeTextMode = self.gradeTextAnim[grade]
        end
        self.gradeTextTime = 0
        log("[ScratchTicket] grade Text applied: " .. grade .. " mode=" .. tostring(self.gradeTextMode))
    end

    @ExecSpace("ClientOnly")
    method void RestoreGradeText()
        -- 등급 텍스트를 베이스(위치·회전·스케일·색·발광 off)로 원복(애니 정지 시).
        if not isvalid(self.ticketGradeText) then return end
        if isvalid(self.ticketGradeText.Entity) and isvalid(self.ticketGradeText.Entity.UITransformComponent) then
            local ui = self.ticketGradeText.Entity.UITransformComponent
            if self.gradeTextBaseCaptured then ui.anchoredPosition = self.gradeTextBasePos end
            ui.UIRotation = Vector3(0, 0, 0)
            ui.UIScale = Vector3(1, 1, 1)
        end
        if self.gradeTextBaseColor ~= nil then self.ticketGradeText.FontColor = self.gradeTextBaseColor end
        self.ticketGradeText.Underlay = false
    end

    @ExecSpace("ClientOnly")
    method void UpdateGradeTextFX(number delta)
        -- 등급별 텍스트 애니: 1=부유(Epic) / 2=발광(Unique) / 3=물결(Legendary). 0이면 정적(무동작).
        if self.gradeTextMode == 0 then return end
        if not isvalid(self.ticketGradeText) or not isvalid(self.ticketGradeText.Entity)
            or not isvalid(self.ticketGradeText.Entity.UITransformComponent) then return end
        self.gradeTextTime = self.gradeTextTime + delta
        local ui = self.ticketGradeText.Entity.UITransformComponent
        local base = self.gradeTextBasePos
        local t = self.gradeTextTime
        if self.gradeTextMode == 1 then
            -- Epic: 수직 사인 부유(둥실둥실).
            local period = self.GradeFloatPeriod > 0 and self.GradeFloatPeriod or 2.6
            local offY = math.sin(t * 2 * math.pi / period) * self.GradeFloatAmp
            ui.anchoredPosition = Vector2(base.x, base.y + offY)
        elseif self.gradeTextMode == 2 then
            -- Unique: 발광(소프트 헤일로 펄스 + 미세 브리딩).
            local period = self.GradeGlowPeriod > 0 and self.GradeGlowPeriod or 1.1
            local k = (math.sin(t * 2 * math.pi / period) + 1) * 0.5
            local g = self.GradeGlowColor
            self.ticketGradeText.Underlay = true
            self.ticketGradeText.UnderlayOffsetX = 0
            self.ticketGradeText.UnderlayOffsetY = 0
            self.ticketGradeText.UnderlaySoftness = self.GradeGlowSoftness
            self.ticketGradeText.UnderlayColor = Color(g.r, g.g, g.b, 0.35 + 0.65 * k)
            self.ticketGradeText.UnderlayDilate = self.GradeGlowDilateMin + (self.GradeGlowDilateMax - self.GradeGlowDilateMin) * k
            local s = 1 + (self.GradeGlowScaleMax - 1) * k
            ui.UIScale = Vector3(s, s, 1)
        elseif self.gradeTextMode == 3 then
            -- Legendary: 물결(수직 사인 + 위상차 Z회전 진동).
            local period = self.GradeWavePeriod > 0 and self.GradeWavePeriod or 1.3
            local w = 2 * math.pi / period
            local offY = math.sin(t * w) * self.GradeWaveAmp
            local rot = math.sin(t * w + 0.6) * self.GradeWaveRotDeg
            ui.anchoredPosition = Vector2(base.x, base.y + offY)
            ui.UIRotation = Vector3(0, 0, rot)
        end
    end

    @ExecSpace("ClientOnly")
    method void StartBoardDrop()
        -- 복권(=board)을 제자리 위(offset)에서 제자리로 낙하시킨다(매 큐브 사용마다 재낙하).
        if not isvalid(self.board) or not isvalid(self.board.UITransformComponent) then return end
        self.board.Enable = true
        self.boardDropStartY = self.boardRestY + self.BoardDropOffsetY
        local ui = self.board.UITransformComponent
        ui.anchoredPosition = Vector2(self.boardBaseX, self.boardDropStartY)
        ui.UIScale = Vector3(1, 1, 1)
        self.dropT = 0
        self.boardLanded = false
        self.scratchReady = false   -- 낙하 중 긁기 금지(착지 시 허용)
        log("[ScratchTicket] board drop start y=" .. tostring(self.boardDropStartY) .. " -> " .. tostring(self.boardRestY))
    end

    @ExecSpace("ClientOnly")
    method void UpdateBoardDrop(number delta)
        -- 낙하: ease-out으로 제자리로 내려오고, 착지 순간 OnBoardLanded 1회 트리거 후 짧은 팝.
        if self.dropT < 0 then return end
        if not isvalid(self.board) or not isvalid(self.board.UITransformComponent) then self.dropT = -1 return end
        self.dropT = self.dropT + delta
        local ui = self.board.UITransformComponent
        local fallDur = self.BoardDropTime
        if fallDur <= 0 then fallDur = 0.01 end
        if self.dropT < fallDur then
            local t = self.dropT / fallDur
            local e = 1 - (1 - t) * (1 - t)   -- ease-out quad
            local y = self.boardDropStartY + (self.boardRestY - self.boardDropStartY) * e
            ui.anchoredPosition = Vector2(self.boardBaseX, y)
            return
        end
        -- 착지 지점 스냅.
        ui.anchoredPosition = Vector2(self.boardBaseX, self.boardRestY)
        if not self.boardLanded then
            self.boardLanded = true
            self:OnBoardLanded()
        end
        -- 착지 팝(선택). 끝나면 낙하 종료.
        local popDur = 0.18
        if self.BoardLandPunch > 1 and self.dropT < fallDur + popDur then
            local k = (self.dropT - fallDur) / popDur
            local s = 1 + (self.BoardLandPunch - 1) * math.sin(k * math.pi)
            ui.UIScale = Vector3(s, s, 1)
        else
            ui.UIScale = Vector3(1, 1, 1)
            self.dropT = -1
        end
    end

    @ExecSpace("ClientOnly")
    method void OnBoardLanded()
        -- 복권 착지 시점: 좌하단 구매창을 우측으로 슬라이드 아웃(사라짐) + 긁기 허용.
        self:SetCubeSelectShown(false, false)
        self.scratchReady = true
        log("[ScratchTicket] board landed -> slide out cube window, scratch enabled")
    end

    @ExecSpace("ClientOnly")
    method void ResetToWaiting()
        -- 큐브 사용 전 대기 상태: 복권(board) 숨김 + 중앙 큐브/옵션 3줄/판매가 숨김, 재사용·판매 비활성, 큐브 선택만 노출.
        -- board는 큐브 선택(낙하) 전까지 감춰 둔다(처음엔 숨김 요구사항).
        if isvalid(self.board) then self.board.Enable = false end
        self.dropT = -1   -- 진행 중 낙하 취소
        self:EndFocus()   -- 포커스 스포트라이트 원복(줌/팬/어둠)
        self.gradeTextMode = 0
        self:RestoreGradeText()   -- 등급 텍스트 애니 정지 + 베이스 원복
        if isvalid(self.centerCube) then self.centerCube.Enable = false end
        if isvalid(self.ticket1) then self.ticket1.Enable = false end
        if isvalid(self.ticket2) then self.ticket2.Enable = false end
        if isvalid(self.ticket3) then self.ticket3.Enable = false end
        if isvalid(self.priceWindow) then self.priceWindow.Enable = false end
        -- 대기 상태(큐브 미사용): 좌측 구매창 노출(활성 중일 때만 슬라이드; OnBeginPlay 비활성 시엔 게이팅 유지).
        if self.isActive then self:SetCubeSelectShown(true, false) end
        -- 큐브 사용 전에는 판매 불가(재사용 버튼과 함께 비활성화). 판매는 큐브 사용 후 3줄 공개(OnAllRevealed) 시에만 활성.
        self:SetButtonEnabled(self.sellButton, false)
        self.revealedCount = 0
        self.rainbowLines = {}
        self:InitLabelFX()
        self:InitPrizeFX()
        self:InitPrizeStars()
        self.destroyPending = false
        self.scratchReady = false   -- 대기 상태에서는 긁기 차단(큐브 사용 전 부스러기 방지).
        -- 판매가 카운트업/델타 상태 초기화(창은 숨김 유지).
        self.revealedBonusSum = 0
        self.priceScrollT = -1
        self.priceFrozen = false
        self.priceFlashT = -1
        self.pricePunchT = -1
        self.deltaT = -1
        if isvalid(self.priceDelta) and isvalid(self.priceDelta.Entity) then
            self.priceDelta.Entity.Enable = false
        end
    end

    @ExecSpace("ClientOnly")
    method void SetupScratch(string pdata)
        -- 큐브 사용 결과를 받아 옵션 3줄을 은박으로 덮어 표시(긁기 시작 가능 상태). 잠재 데이터 파싱.
        -- pdata = "cubeCount;grade;line;line;line", line = "label|value|unit|optionType|isBonus|isDestroy|isValid|bonus|optionGroup"
        self:EndFocus()   -- 재굴림 시 이전 포커스 스포트라이트 잔상 원복
        local fields = self:Split(pdata, ";")
        if #fields < 5 then return end
        -- fields[1]=cubeCount, fields[2]=grade, fields[3..5]=lines
        self.optionLines = {}
        for i = 1, 3 do
            local parts = self:Split(fields[2 + i], "|")
            self.optionLines[i] = {
                label = parts[1] or "",
                value = tonumber(parts[2]) or 0,
                unit = parts[3] or "",
                optionType = parts[4] or "Junk",
                isBonus = (parts[5] == "1"),
                isDestroy = (parts[6] == "1"),
                isValid = (parts[7] == "1"),
                bonus = tonumber(parts[8]) or 0,   -- 서버 권위 줄별 판매가 보너스(실시간 상승분)
                optionGroup = parts[9] or "Junk",  -- 옵션 계열(Attack=공/마/보공, MainStat=스탯) — 결과음 5분기용
                revealed = false,
            }
        end

        -- 등급별 복권 배경(용지) 교체 + 등급 텍스트 라벨/애니 — 낙하 전에 세팅해 올바른 등급으로 떨어지게 한다.
        self:ApplyGradeBg(fields[2])
        self:ApplyGradeText(fields[2])

        -- 중앙 큐브 아이콘 표시(마지막 선택 큐브). 실제 큐브 아트 본색.
        local cube = _BlacksmithConfig:GetCube(self.lastCubeType)
        if cube ~= nil then
            self:SetIcon(self.centerCube, cube.icon, Color(1, 1, 1, 1))
        end
        if isvalid(self.centerCube) then self.centerCube.Enable = true end

        local prizes = { self.prize1, self.prize2, self.prize3 }
        local labels = { self.label1, self.label2, self.label3 }
        local foils = { self.foil1, self.foil2, self.foil3 }
        local rows = { self.ticket1, self.ticket2, self.ticket3 }
        for i = 1, 3 do
            local o = self.optionLines[i]
            if isvalid(rows[i]) then rows[i].Enable = true end
            -- 옵션 텍스트(은박 아래). 초기 글자색 흰색, 위치/스케일/회전 원복.
            if isvalid(labels[i]) then
                labels[i].Text = self:FormatOption(o)
                labels[i].FontColor = Color(1, 1, 1, 1)
                if isvalid(labels[i].Entity) and isvalid(labels[i].Entity.UITransformComponent) then
                    local lui = labels[i].Entity.UITransformComponent
                    lui.anchoredPosition = Vector2(0, 0)
                    lui.UIScale = Vector3(1, 1, 1)
                    lui.UIRotation = Vector3(0, 0, 0)
                end
            end
            -- 바탕: 처음엔 Default 이미지(공개 전). 공개 시 종류별 이미지로 전환.
            if isvalid(prizes[i]) then
                prizes[i].ImageRUID = self.PrizeImgDefault
                prizes[i].Color = Color(1, 1, 1, 1)   -- 이미지 원색 표시(틴트 제거)
            end
            -- 은박 다시 덮기.
            self:RegisterTicket(i, foils[i])
        end

        self.revealedCount = 0
        self.rainbowLines = {}
        self:InitLabelFX()
        self:InitPrizeFX()
        self:InitPrizeStars()
        self.destroyPending = false
        -- 판매가 창을 큐브 사용 즉시 '기본 판매가'부터 표시(줄 공개마다 실시간 상승). (pricing §14)
        self.revealedBonusSum = 0
        self.priceFrozen = false
        self:ResetPriceDisplay(_GameManager.CurrentBasePrice)
        self:SetButtonEnabled(self.sellButton, false)
        -- 큐브 사용 → 복권을 하늘에서 낙하시킨다. 착지 시(OnBoardLanded) 구매창 슬라이드 아웃 + 긁기 허용.
        self:StartBoardDrop()
        log("[ScratchTicket] setup scratch: grade=" .. (fields[2] or "?") .. " cube=" .. self.lastCubeType
            .. " base=" .. tostring(_GameManager.CurrentBasePrice))
    end

    @ExecSpace("ClientOnly")
    method void SpawnCrumb(Vector2 touchPoint)
        -- 긁는 지점에 은박 조각 1개를 확률적으로 방출.
        if self.crumbs == nil or #self.crumbs == 0 then return end
        if not isvalid(self.crumbLayer) then return end
        if _UtilLogic:RandomDouble() > self.CrumbSpawnChance then return end
        local n = #self.crumbs
        local rec = nil
        for step = 1, n do
            self.crumbCursor = (self.crumbCursor % n) + 1
            local candidate = self.crumbs[self.crumbCursor]
            if not candidate.active then rec = candidate break end
        end
        if rec == nil then return end
        local p = _UILogic:ScreenToLocalUIPosition(touchPoint, self.crumbLayer.UITransformComponent)
        rec.ui.anchoredPosition = p
        rec.vx = -70 + _UtilLogic:RandomDouble() * 140
        rec.vy = -40 + _UtilLogic:RandomDouble() * 60
        rec.active = true
        rec.entity.Enable = true
    end

    @ExecSpace("ClientOnly")
    method void UpdateCrumbs(number delta)
        -- 활성 조각을 중력으로 낙하시키고 바닥 도달 시 회수.
        if self.crumbs == nil then return end
        for i = 1, #self.crumbs do
            local rec = self.crumbs[i]
            if rec.active then
                rec.vy = rec.vy - self.CrumbGravity * delta
                local pos = rec.ui.anchoredPosition
                local nx = pos.x + rec.vx * delta
                local ny = pos.y + rec.vy * delta
                if ny <= self.CrumbFloorY then
                    rec.active = false
                    rec.entity.Enable = false
                else
                    rec.ui.anchoredPosition = Vector2(nx, ny)
                end
            end
        end
    end

    @ExecSpace("ClientOnly")
    method void ResetPriceDisplay(integer base)
        -- 판매가 창을 base(기본 판매가)로 즉시 표시(카운트업 없이). 큐브 사용 직후 호출.
        if isvalid(self.priceWindow) then self.priceWindow.Enable = true end
        self.displayedPrice = base
        self.priceStart = base
        self.priceTarget = base
        self.priceScrollT = -1
        if isvalid(self.priceText) then
            self.priceText.Text = self:Comma(base) .. " 메소"
            self.priceText.FontColor = Color(1, 1, 1, 1)
        end
    end

    @ExecSpace("ClientOnly")
    method void StartPriceScroll(integer target)
        -- 현재 표시값에서 target까지 ease-out 카운트업 시작(파괴 정지 상태면 무시).
        if self.priceFrozen then return end
        self.priceStart = self.displayedPrice
        self.priceTarget = target
        self.priceScrollT = 0
    end

    @ExecSpace("ClientOnly")
    method void UpdatePriceScroll(number delta)
        -- 판매가 숫자를 목표까지 ease-out으로 카운트업한다.
        if self.priceScrollT < 0 then return end
        if self.priceFrozen then self.priceScrollT = -1 return end
        self.priceScrollT = self.priceScrollT + delta
        local dur = self.PriceScrollTime
        local t = 1.0
        if dur > 0 then t = self.priceScrollT / dur end
        if t > 1.0 then t = 1.0 end
        local ease = 1 - (1 - t) * (1 - t)   -- ease-out quad
        local cur = self.priceStart + (self.priceTarget - self.priceStart) * ease
        self.displayedPrice = cur
        if isvalid(self.priceText) then
            self.priceText.Text = self:Comma(math.floor(cur + 0.5)) .. " 메소"
        end
        if t >= 1.0 then
            self.displayedPrice = self.priceTarget
            self.priceScrollT = -1
            if isvalid(self.priceText) then
                self.priceText.Text = self:Comma(self.priceTarget) .. " 메소"
            end
        end
    end

    @ExecSpace("ClientOnly")
    method void FlashPrice(any color, number punchScale)
        -- 판매가 텍스트 플래시 + 판매가창 펀치 트리거.
        self.priceFlashT = 0
        self.priceFlashColor = color
        self.pricePunchT = 0
        self.pricePunchPeak = punchScale
    end

    @ExecSpace("ClientOnly")
    method void ShowDelta(integer amount, any color)
        -- 상승분 "+n" 델타 팝업을 판매가 창 위에 띄운다(UpdatePriceFX가 상승·페이드).
        if not isvalid(self.priceDelta) or not isvalid(self.priceDelta.Entity) then return end
        self.priceDelta.Text = "+" .. self:Comma(amount)
        self.priceDelta.FontColor = Color(color.r, color.g, color.b, 1)
        local ui = self.priceDelta.Entity.UITransformComponent
        if isvalid(ui) then ui.anchoredPosition = Vector2(0, self.deltaBaseY) end
        self.priceDelta.Entity.Enable = true
        self.deltaT = 0
    end

    @ExecSpace("ClientOnly")
    method void UpdatePriceFX(number delta)
        -- 판매가 텍스트 플래시 색 복귀 + 판매가창 펀치 스케일 + 델타 팝업 상승/페이드.
        if self.priceFlashT >= 0 and not self.priceFrozen then
            self.priceFlashT = self.priceFlashT + delta
            local dur = self.PriceFlashTime
            local k = 1.0
            if dur > 0 then k = self.priceFlashT / dur end
            if k >= 1.0 then
                self.priceFlashT = -1
                if isvalid(self.priceText) then self.priceText.FontColor = Color(1, 1, 1, 1) end
            elseif isvalid(self.priceText) and self.priceFlashColor ~= nil then
                local c = self.priceFlashColor
                local w = k  -- 0=지정색, 1=흰색
                self.priceText.FontColor = Color(c.r + (1 - c.r) * w, c.g + (1 - c.g) * w, c.b + (1 - c.b) * w, 1)
            end
        end
        if self.pricePunchT >= 0 then
            self.pricePunchT = self.pricePunchT + delta
            local dur = self.PricePunchTime
            local k = 1.0
            if dur > 0 then k = self.pricePunchT / dur end
            local ui = nil
            if isvalid(self.priceWindow) then ui = self.priceWindow.UITransformComponent end
            if k >= 1.0 then
                self.pricePunchT = -1
                if isvalid(ui) then ui.UIScale = Vector3(1, 1, 1) end
            elseif isvalid(ui) then
                local s = 1 + (self.pricePunchPeak - 1) * math.sin(k * math.pi)
                ui.UIScale = Vector3(s, s, 1)
            end
        end
        if self.deltaT >= 0 and isvalid(self.priceDelta) and isvalid(self.priceDelta.Entity) then
            self.deltaT = self.deltaT + delta
            local dur = self.DeltaRiseTime
            local k = 1.0
            if dur > 0 then k = self.deltaT / dur end
            if k >= 1.0 then
                self.deltaT = -1
                self.priceDelta.Entity.Enable = false
            else
                local ui = self.priceDelta.Entity.UITransformComponent
                if isvalid(ui) then ui.anchoredPosition = Vector2(0, self.deltaBaseY + self.DeltaRiseDist * k) end
                local fc = self.priceDelta.FontColor
                self.priceDelta.FontColor = Color(fc.r, fc.g, fc.b, 1 - k)
            end
        end
    end

    @ExecSpace("ClientOnly")
    method void BuildCoinPool()
        -- CoinLayer 아래 미리 만든 코인 스프라이트들을 풀로 수집(전부 비활성 시작).
        self.coins = {}
        self.coinCursor = 0
        self.coinSfxCd = 0
        if not isvalid(self.coinLayer) then return end
        for _, c in ipairs(self.coinLayer.Children:ToTable()) do
            c.Enable = false
            if isvalid(c.UITransformComponent) then
                c.UITransformComponent.RectSize = Vector2(self.CoinSizeW, self.CoinSizeH)
            end
            table.insert(self.coins, { entity = c, ui = c.UITransformComponent, vx = 0, vy = 0, spin = 0, active = false })
        end
        log("[ScratchTicket] coin pool built: " .. tostring(#self.coins))
    end

    @ExecSpace("ClientOnly")
    method void SpawnCoins(integer count, boolean strong)
        -- 판매가 창 상단에서 코인을 pop-up 후 후두둑 낙하시킨다(+짤랑음, 쿨다운).
        if self.coins == nil or #self.coins == 0 then return end
        if not isvalid(self.coinLayer) or not isvalid(self.priceWindow) then return end
        local originX, originY = 0, 0
        if isvalid(self.priceWindow.UITransformComponent) then
            local p = self.priceWindow.UITransformComponent.anchoredPosition
            originX = p.x
            originY = p.y + 120
        end
        local n = #self.coins
        local spawned = 0
        local spread = strong and 240 or 140
        local pop = strong and 300 or 180
        for step = 1, n do
            if spawned >= count then break end
            self.coinCursor = (self.coinCursor % n) + 1
            local rec = self.coins[self.coinCursor]
            if not rec.active then
                rec.ui.anchoredPosition = Vector2(originX + (_UtilLogic:RandomDouble() - 0.5) * 90,
                    originY + (_UtilLogic:RandomDouble() - 0.5) * 30)
                rec.vx = (_UtilLogic:RandomDouble() - 0.5) * spread
                rec.vy = pop + _UtilLogic:RandomDouble() * 160
                rec.spin = (_UtilLogic:RandomDouble() - 0.5) * 720
                rec.active = true
                rec.entity.Enable = true
                spawned = spawned + 1
            end
        end
        if spawned > 0 then self:PlayCoinSfx() end
        log("[ScratchTicket] coins spawned: " .. tostring(spawned) .. " (strong=" .. tostring(strong) .. ")")
    end

    @ExecSpace("ClientOnly")
    method void PlayCoinSfx()
        -- 코인 짤랑음 재생(연속 방출 시 쿨다운으로 중복 제한).
        if self.coinSfxCd > 0 then return end
        _SoundService:PlaySound(self.SfxCoin, 1)
        self.coinSfxCd = self.CoinSfxCooldown
    end

    @ExecSpace("ClientOnly")
    method void UpdateCoins(number delta)
        -- 활성 코인을 중력으로 낙하 + 회전시키고 바닥 도달 시 회수.
        if self.coinSfxCd > 0 then self.coinSfxCd = self.coinSfxCd - delta end
        if self.coins == nil then return end
        for i = 1, #self.coins do
            local rec = self.coins[i]
            if rec.active then
                rec.vy = rec.vy - self.CoinGravity * delta
                local pos = rec.ui.anchoredPosition
                local nx = pos.x + rec.vx * delta
                local ny = pos.y + rec.vy * delta
                if ny <= self.CoinFloorY then
                    rec.active = false
                    rec.entity.Enable = false
                else
                    rec.ui.anchoredPosition = Vector2(nx, ny)
                    if isvalid(rec.ui) then
                        local rot = rec.ui.UIRotation
                        rec.ui.UIRotation = Vector3(0, 0, rot.z + rec.spin * delta)
                    end
                end
            end
        end
    end

    @ExecSpace("ClientOnly")
    method void StopCoins()
        -- 모든 코인 회수(맵 이탈/아이템 없음 시).
        if self.coins == nil then return end
        for i = 1, #self.coins do
            local rec = self.coins[i]
            rec.active = false
            if isvalid(rec.entity) then rec.entity.Enable = false end
        end
    end

    @ExecSpace("ClientOnly")
    method void BuildStarPools()
        -- 각 Prize 박스 아래 미리 만든 'Stars' 컨테이너의 별 스프라이트들을 박스별 풀로 수집(전부 비활성 시작).
        -- 코인 풀(BuildCoinPool) 패턴 이식. 이탈 줄 공개 시 해당 박스만 이멧한다.
        self.prizeStars = {}
        self.starEmit = {}
        local prizes = { self.prize1, self.prize2, self.prize3 }
        for i = 1, 3 do
            self.prizeStars[i] = {}
            self.starEmit[i] = { active = false, timer = 0 }
            local pr = prizes[i]
            if isvalid(pr) and isvalid(pr.Entity) then
                local cont = pr.Entity:GetChildByName("Stars", false)
                if isvalid(cont) then
                    for _, s in ipairs(cont.Children:ToTable()) do
                        s.Enable = false
                        local sprite = s.SpriteGUIRendererComponent
                        if isvalid(sprite) and self.StarRUID ~= "" then sprite.ImageRUID = self.StarRUID end
                        table.insert(self.prizeStars[i],
                            { entity = s, ui = s.UITransformComponent, sprite = sprite,
                              t = -1, dur = 1, active = false, baseSize = 24, spin = 0 })
                    end
                end
            end
        end
        log("[ScratchTicket] star pools built")
    end

    @ExecSpace("ClientOnly")
    method void InitPrizeStars()
        -- 전 별 비활성+숨김, 이멧 정지(대기/재스크래치 시 리셋). InitPrizeFX 패턴.
        if self.prizeStars == nil then return end
        for i = 1, 3 do
            if self.starEmit ~= nil and self.starEmit[i] ~= nil then
                self.starEmit[i].active = false
                self.starEmit[i].timer = 0
            end
            for _, rec in ipairs(self.prizeStars[i]) do
                rec.active = false
                rec.t = -1
                if isvalid(rec.entity) then rec.entity.Enable = false end
            end
        end
    end

    @ExecSpace("ClientOnly")
    method void StartPrizeStars(integer index)
        -- 해당 박스의 별 이멧 시작(이탈 줄 공개 시). 이후 UpdatePrizeStars가 계속 생성.
        if self.starEmit == nil or self.starEmit[index] == nil then return end
        self.starEmit[index].active = true
        log("[ScratchTicket] star emit start i=" .. tostring(index))
    end

    @ExecSpace("ClientOnly")
    method void EmitOneStar(integer index, any pr, any pool)
        -- 풀에서 비활성 별 1개를 박스 내부 랜덤 위치·크기·수명·회전으로 켠다.
        if pool == nil or not isvalid(pr) or not isvalid(pr.Entity) then return end
        local box = pr.Entity.UITransformComponent
        if not isvalid(box) then return end
        local rs = box.RectSize
        local halfX = math.max(0, rs.x * 0.5 - self.StarMarginX)
        local halfY = math.max(0, rs.y * 0.5 - self.StarMarginY)
        for _, rec in ipairs(pool) do
            if not rec.active and isvalid(rec.ui) then
                local rx = (_UtilLogic:RandomDouble() - 0.5) * 2 * halfX
                local ry = (_UtilLogic:RandomDouble() - 0.5) * 2 * halfY
                rec.ui.anchoredPosition = Vector2(rx, ry)
                rec.baseSize = self.StarSizeMin + _UtilLogic:RandomDouble() * (self.StarSizeMax - self.StarSizeMin)
                rec.dur = self.StarLifeMin + _UtilLogic:RandomDouble() * (self.StarLifeMax - self.StarLifeMin)
                rec.spin = (_UtilLogic:RandomDouble() - 0.5) * 2 * self.StarMaxSpinDeg
                rec.t = 0
                rec.active = true
                rec.entity.Enable = true
                if self.StarSelfAnimated and isvalid(rec.sprite) then
                    -- 자체 애니 클립: 고정 크기 + 원색 풀알파(코드 페이드 안 함) + 클립 재대입으로 프레임0부터 재생(별마다 desync).
                    rec.ui.RectSize = Vector2(rec.baseSize, rec.baseSize)
                    rec.ui.UIRotation = Vector3(0, 0, 0)
                    rec.sprite.Color = Color(self.StarTint.r, self.StarTint.g, self.StarTint.b, 1)
                    rec.sprite.ImageRUID = self.StarRUID
                end
                return
            end
        end
    end

    @ExecSpace("ClientOnly")
    method void UpdatePrizeStars(number delta)
        -- 이멧 중인 박스는 간격마다 별 1개 생성 + 각 활성 별을 수명 만료 시 회수.
        -- 자체 애니 클립(StarSelfAnimated)이면 클립이 스스로 반짝이므로 코드 트윙클 스킵, 정적 스프라이트면 알파 sin+스케일 팝+회전.
        if self.prizeStars == nil then return end
        local prizes = { self.prize1, self.prize2, self.prize3 }
        for i = 1, 3 do
            local pool = self.prizeStars[i]
            local emit = self.starEmit[i]
            if emit ~= nil and emit.active and self.StarSpawnInterval > 0 then
                emit.timer = emit.timer + delta
                while emit.timer >= self.StarSpawnInterval do
                    emit.timer = emit.timer - self.StarSpawnInterval
                    self:EmitOneStar(i, prizes[i], pool)
                end
            end
            for _, rec in ipairs(pool) do
                if rec.active and rec.t >= 0 then
                    rec.t = rec.t + delta
                    local k = 1.0
                    if rec.dur > 0 then k = rec.t / rec.dur end
                    if k >= 1.0 then
                        rec.active = false
                        rec.t = -1
                        if isvalid(rec.entity) then rec.entity.Enable = false end
                    elseif not self.StarSelfAnimated and isvalid(rec.ui) then
                        -- 정적 스프라이트 전용 코드 트윙클(알파 sin + 스케일 팝 + 회전).
                        local a = math.sin(k * math.pi)
                        local sc = rec.baseSize * (0.45 + 0.55 * a)
                        rec.ui.RectSize = Vector2(sc, sc)
                        rec.ui.UIRotation = Vector3(0, 0, rec.spin * k)
                        if isvalid(rec.sprite) then
                            rec.sprite.Color = Color(self.StarTint.r, self.StarTint.g, self.StarTint.b, a)
                        end
                    end
                    -- StarSelfAnimated면 클립이 스스로 페이드/반짝임 → 여기서 알파·스케일 손대지 않음.
                end
            end
        end
    end

    @ExecSpace("ClientOnly")
    method void OnTouchBegin(ScreenTouchEvent event)
        -- 클릭 시작: 터치 지점에서 긁기.
        self:Scratch(event.TouchPoint, event.TouchId)
    end

    @ExecSpace("ClientOnly")
    method void OnTouchHold(ScreenTouchHoldEvent event)
        -- 드래그/홀드: 누르는 동안 연속 긁기.
        self:Scratch(event.TouchPoint, event.TouchId)
    end

    @ExecSpace("ClientOnly")
    method void Scratch(Vector2 touchPoint, integer touchId)
        -- 터치를 각 줄 사각형(게임 월드 좌표)에 히트테스트해 브러시 반경 내 알파를 깎는다.
        if not self.isActive then return end
        if not self.scratchReady then return end  -- 큐브 사용 전(은박 미표시)에는 긁기/부스러기 차단.
        if touchId < 1 then return end
        if self.tickets == nil then return end
        if self.revealedCount >= 3 then return end  -- 모두 공개되면 긁기 불필요
        if self.destroyPending then return end  -- 파괴 연출 중에는 나머지 줄 긁기 차단
        local worldPt = _UILogic:ScreenToWorldPosition(touchPoint)
        for i = 1, #self.tickets do
            local t = self.tickets[i]
            if t ~= nil and (not t.completed) and isvalid(t.ui) then
                local ui = t.ui
                local rs = ui.RectSize
                local bl = _UILogic:LocalUIToWorldPosition(Vector2(-rs.x * 0.5, -rs.y * 0.5), ui)
                local tr = _UILogic:LocalUIToWorldPosition(Vector2(rs.x * 0.5, rs.y * 0.5), ui)
                local w = tr.x - bl.x
                local h = tr.y - bl.y
                if w ~= 0 and h ~= 0 then
                    local u = (worldPt.x - bl.x) / w
                    local v = (worldPt.y - bl.y) / h
                    if u >= 0 and u <= 1 and v >= 0 and v <= 1 then
                        -- 포커스 스포트라이트 중에는 포커스 줄만 긁기 허용(다른 줄은 어둠에 가려 있음).
                        if self.focusIndex > 0 and self.focusIndex ~= t.index then return end
                        -- 이탈(유효+보너스)/파괴 줄 첫 긁기 → 스포트라이트(줌인+어두워짐) 시작.
                        if self.focusIndex == 0 and self:IsFocusLine(t.index) then
                            self:StartFocus(t.index)
                        end
                        self:ApplyBrush(t, u, v)
                        self:SpawnCrumb(touchPoint)
                        self.scratchTimer = 0.12   -- "지금 은박을 눌러 긁는 중" 표시(드래그 프레임마다 갱신 → 동색 유지)
                        return
                    end
                end
            end
        end
    end

    @ExecSpace("ClientOnly")
    method boolean IsSpecialLine(integer index)
        -- 유효옵션/파괴 줄이면 true(여러 번 긁어야 하는 특수 줄). 잡옵/일반은 false.
        -- 이탈(isBonus)은 단독 조건이 아니다: 유효+이탈은 isValid로 자연히 포함되고,
        --   비유효 이탈(isValid=0/isBonus=1)은 평범한 잡옵과 동일하게 긁힌다.
        -- 조합 보너스는 결과 단위라 줄 플래그와 무관 → 자동 제외(평소대로 긁힘).
        if self.optionLines == nil then return false end
        local o = self.optionLines[index]
        if o == nil then return false end
        return o.isValid or o.isDestroy
    end

    @ExecSpace("ClientOnly")
    method boolean IsPositiveLine(integer index)
        -- 긍정(유효) 옵션 줄이면 true. 유효+이탈은 isValid로 포함되고, 비유효 이탈은 잡옵과
        --   동일 완료 기준을 쓰도록 제외한다. 파괴도 제외(파괴는 완료 기준을 올리지 않는다).
        if self.optionLines == nil then return false end
        local o = self.optionLines[index]
        if o == nil then return false end
        return o.isValid and (not o.isDestroy)
    end

    @ExecSpace("ClientOnly")
    method boolean IsFocusLine(integer index)
        -- 포커스 스포트라이트 대상 줄: 이탈(유효+보너스) 또는 파괴. 일반 유효/잡옵은 제외.
        if self.optionLines == nil then return false end
        local o = self.optionLines[index]
        if o == nil then return false end
        return (o.isValid and o.isBonus) or o.isDestroy
    end

    @ExecSpace("ClientOnly")
    method void CacheFocusStrips()
        -- FocusDim 자식 스트립 4장(Top/Bottom/Left/Right)의 ui/sprite 캐시 + 시작은 레이어 숨김.
        --   .ui에서 켜진 채 저작(꺼진 자식은 GetChildByName 캐시 누락 위험) → 여기서 끈다(SparkleFX 패턴).
        self.focusStrips = nil
        if not isvalid(self.focusDimLayer) then return end
        local strips = {}
        local found = 0
        for _, nm in ipairs({ "Top", "Bottom", "Left", "Right" }) do
            local e = self.focusDimLayer:GetChildByName(nm, false)
            if isvalid(e) then
                strips[nm] = { ui = e.UITransformComponent, sprite = e.SpriteGUIRendererComponent }
                found = found + 1
            end
        end
        self.focusStrips = strips
        self.focusDimLayer.Enable = false
        log("[ScratchTicket] focus strips cached: " .. tostring(found))
    end

    @ExecSpace("ClientOnly")
    method void StartFocus(integer index)
        -- 포커스 스포트라이트 시작(이탈/파괴 줄 첫 긁기). 어둠은 알파 0에서 시작해 긁기 진행률 따라 짙어진다.
        self.focusIndex = index
        self.focusZoomCur = 1.0
        self.focusDimCur = 0.0
        self.focusPanX = 0
        self.focusPanY = 0
        -- 첫 프레임 검은 화면 플래시 방지: 스트립 알파 0으로 초기화 후 레이어를 켠다.
        if self.focusStrips ~= nil then
            local c = self.FocusDimColor
            for _, nm in ipairs({ "Top", "Bottom", "Left", "Right" }) do
                local rec = self.focusStrips[nm]
                if rec ~= nil and isvalid(rec.sprite) then
                    rec.sprite.Color = Color(c.r, c.g, c.b, 0)
                end
            end
        end
        if isvalid(self.focusDimLayer) then self.focusDimLayer.Enable = true end
        log("[ScratchTicket] focus start i=" .. tostring(index))
    end

    @ExecSpace("ClientOnly")
    method void EndFocus()
        -- 포커스 스포트라이트 즉시 원상복구: 어둠 레이어 숨김 + (포커스 중이었으면) 보드 줌/팬 원위치.
        -- OnLineRevealed 맨 앞에서 호출 → 이후 시소/파괴 연출이 원위치 기준으로 재생된다.
        if isvalid(self.focusDimLayer) and self.focusDimLayer.Enable then
            self.focusDimLayer.Enable = false
        end
        if self.focusIndex == 0 then return end
        self.focusIndex = 0
        self.focusZoomCur = 1.0
        self.focusDimCur = 0.0
        self.focusPanX = 0
        self.focusPanY = 0
        if isvalid(self.board) and isvalid(self.board.UITransformComponent) then
            local bui = self.board.UITransformComponent
            bui.UIScale = Vector3(1, 1, 1)
            bui.anchoredPosition = Vector2(self.boardBaseX, self.boardRestY)
        end
        log("[ScratchTicket] focus end -> restored")
    end

    @ExecSpace("ClientOnly")
    method void PlayFirework(integer index)
        -- 이탈(유효+보너스) 줄 공개 순간 폭죽 1회 발사: FX를 해당 줄 위치로 옮기고 Play.
        -- (Loop=false·PlayOnEnable=false 저작 → Play() 호출 시에만 한 번 터진다. 프리셋/크기 튜닝은 .ui 엔티티 인스펙터.)
        if not isvalid(self.fireworkFX) then return end
        local p = self.fireworkFX.UIBasicParticleComponent
        if not isvalid(p) then return end
        local rows = { self.ticket1, self.ticket2, self.ticket3 }
        local row = rows[index]
        if isvalid(row) and isvalid(row.UITransformComponent) and isvalid(self.fireworkFX.UITransformComponent) then
            local lp = row.UITransformComponent.anchoredPosition
            -- 공개 시점은 EndFocus 직후라 보드는 원위치(줌 1) — 줄의 그룹 좌표 = base + 로컬.
            self.fireworkFX.UITransformComponent.anchoredPosition =
                Vector2(self.boardBaseX + lp.x, self.boardRestY + lp.y + self.FireworkOffsetY)
        end
        self.fireworkFX.Enable = true
        p:Play()
        log("[ScratchTicket] firework at line " .. tostring(index))
    end

    @ExecSpace("ClientOnly")
    method void UpdateFocus(number delta)
        -- 포커스 스포트라이트: 보드(가짜 카메라)를 포커스 줄 중심으로 천천히 팬/줌 + 주변 어둠 스트립 갱신.
        -- 줌·어둠 목표는 긁기 진행률(완료 기준 대비 벗겨진 비율)에 비례 → 긁을수록 점점 줌인.
        if self.focusIndex == 0 then return end
        if self.dropT >= 0 or self.destroyPending then return end   -- 낙하/파괴 연출과 보드 transform 경합 방지
        local t = nil
        if self.tickets ~= nil then t = self.tickets[self.focusIndex] end
        local o = nil
        if self.optionLines ~= nil then o = self.optionLines[self.focusIndex] end
        local rows = { self.ticket1, self.ticket2, self.ticket3 }
        local row = rows[self.focusIndex]
        if t == nil or o == nil or not isvalid(row) or not isvalid(row.UITransformComponent)
            or not isvalid(self.board) or not isvalid(self.board.UITransformComponent) then return end
        -- 진행률 0~1: 줄 타입별 완료 기준 재사용(ApplyBrush와 동일 분기 — 이탈=Positive, 파괴=기본).
        local threshold = self.CompletionThreshold
        if self:IsPositiveLine(self.focusIndex) then threshold = self.CompletionThresholdPositive end
        local p = 0
        if threshold > 0 and t.total > 0 then p = (t.cleared / t.total) / threshold end
        if p > 1 then p = 1 end
        -- 목표: 줌/어둠(진행률 비례) + 팬(포커스 줄이 화면 중앙으로).
        local localPos = row.UITransformComponent.anchoredPosition
        local zoomT = 1 + (self.FocusMaxZoom - 1) * p
        local dimT = self.FocusDimMaxAlpha * p
        local panTX = -zoomT * localPos.x
        local panTY = -zoomT * localPos.y
        -- 지수 lerp 수렴("천천히 이동").
        local k = self.FocusEaseSpeed * delta
        if k > 1 then k = 1 end
        self.focusZoomCur = self.focusZoomCur + (zoomT - self.focusZoomCur) * k
        self.focusDimCur = self.focusDimCur + (dimT - self.focusDimCur) * k
        self.focusPanX = self.focusPanX + (panTX - self.focusPanX) * k
        self.focusPanY = self.focusPanY + (panTY - self.focusPanY) * k
        -- 보드(가짜 카메라) 적용.
        local bui = self.board.UITransformComponent
        bui.UIScale = Vector3(self.focusZoomCur, self.focusZoomCur, 1)
        bui.anchoredPosition = Vector2(self.boardBaseX + self.focusPanX, self.boardRestY + self.focusPanY)
        -- 스포트라이트 창: 포커스 줄 사각형(그룹 좌표 = 보드위치 + 줌×로컬) 주위를 스트립 4장이 감싼다.
        local cx = self.boardBaseX + self.focusPanX + self.focusZoomCur * localPos.x
        local cy = self.boardRestY + self.focusPanY + self.focusZoomCur * localPos.y
        local rs = row.UITransformComponent.RectSize
        local halfW = rs.x * 0.5 * self.focusZoomCur + self.FocusHolePadding
        local halfH = rs.y * 0.5 * self.focusZoomCur + self.FocusHolePadding
        self:ApplyFocusStrips(cx, cy, halfW, halfH, o.isDestroy)
    end

    @ExecSpace("ClientOnly")
    method void ApplyFocusStrips(number cx, number cy, number halfW, number halfH, boolean isDestroy)
        -- 화면(1920×1080, 중앙 원점) 전체를 덮되 포커스 줄 사각형만 뚫린 창이 되도록 스트립 4장 배치.
        if self.focusStrips == nil then return end
        local col = self.FocusDimColor
        if isDestroy then col = self.FocusDimColorDestroy end
        local a = self.focusDimCur
        local top = cy + halfH
        local bottom = cy - halfH
        local left = cx - halfW
        local right = cx + halfW
        self:SetStrip(self.focusStrips.Top, 0, (top + 540) * 0.5, 1920, 540 - top, col, a)
        self:SetStrip(self.focusStrips.Bottom, 0, (bottom - 540) * 0.5, 1920, bottom + 540, col, a)
        self:SetStrip(self.focusStrips.Left, (left - 960) * 0.5, cy, left + 960, halfH * 2, col, a)
        self:SetStrip(self.focusStrips.Right, (right + 960) * 0.5, cy, 960 - right, halfH * 2, col, a)
    end

    @ExecSpace("ClientOnly")
    method void SetStrip(any rec, number cx, number cy, number w, number h, any col, number alpha)
        -- 스트립 1장 배치+색 적용. 음수 크기는 0으로 클램프(창이 화면 밖으로 나갈 때).
        if rec == nil or not isvalid(rec.ui) then return end
        if w < 0 then w = 0 end
        if h < 0 then h = 0 end
        rec.ui.anchoredPosition = Vector2(cx, cy)
        rec.ui.RectSize = Vector2(w, h)
        if isvalid(rec.sprite) then
            rec.sprite.Color = Color(col.r, col.g, col.b, alpha)
        end
    end

    @ExecSpace("ClientOnly")
    method void ApplyBrush(any t, number u, number v)
        -- 브러시 원 내 모든 픽셀 알파를 EraseStrength/100 만큼 감소(점진적 벗겨짐).
        local W = self.GridWidth
        local H = self.GridHeight
        local cx = math.floor(u * W) + 1
        local cy = math.floor(v * H) + 1
        local R = self.BrushRadius
        local r2 = R * R
        -- 줄 타입별 강도: 특수 옵션(유효/이탈/파괴)은 약하게 벗겨져 여러 번 긁어야 공개(잡옵은 기본 강도).
        local strength = self.EraseStrength
        if self:IsSpecialLine(t.index) then strength = self.EraseStrengthSpecial end
        local dec = strength / 100.0
        if dec <= 0 then return end
        local fromX = math.max(1, math.floor(cx - R))
        local toX = math.min(W, math.ceil(cx + R))
        local fromY = math.max(1, math.floor(cy - R))
        local toY = math.min(H, math.ceil(cy + R))
        for py = fromY, toY do
            for px = fromX, toX do
                local ddx = px - cx
                local ddy = py - cy
                if (ddx * ddx + ddy * ddy) <= r2 then
                    local idx = (py - 1) * W + px
                    local a = t.alpha[idx]
                    if a > 0 then
                        local prev = a
                        a = a - dec
                        if a < 0 then a = 0 end
                        t.alpha[idx] = a
                        t.pixel:SetPixel(px, py, Color(0.78, 0.78, 0.82, a))
                        -- 부분 제거도 즉시 누적: cleared = 제거된 알파 총량, total = W*H(전체 알파량).
                        -- 따라서 cleared/total = "전체 은박 알파의 제거 비율" → CompletionThreshold가 직관적으로 동작.
                        t.cleared = t.cleared + (prev - a)
                    end
                end
            end
        end
        -- 줄 타입별 완료 기준: 긍정 옵션(유효/이탈)은 더 많이 긁어야 공개(파괴/잡옵은 기본값).
        local threshold = self.CompletionThreshold
        if self:IsPositiveLine(t.index) then threshold = self.CompletionThresholdPositive end
        if (not t.completed) and (t.cleared / t.total) >= threshold then
            self:CompleteTicket(t)
        end
    end

    @ExecSpace("ClientOnly")
    method void CompleteTicket(any t)
        -- 남은 은박을 완전 투명으로 지우고 줄 공개 처리.
        t.completed = true
        t.pixel:FillColor(Color(0, 0, 0, 0))
        self:OnLineRevealed(t.index)
    end

    @ExecSpace("ClientOnly")
    method void OnLineRevealed(integer index)
        -- 한 줄 공개: 종류별 바탕색 전환 + 유효옵션이면 무지개/출렁 등록. 3줄 완료 시 최종 처리.
        -- 포커스 스포트라이트 즉시 원상복구(줌아웃+어둠 해제) — 이후 시소(StartPrizeFX)/파괴 연출이
        -- 원위치 기준으로 재생되도록 반드시 이 시점(연출 시작 전)에 복구한다.
        self:EndFocus()
        self:SetScratchLoop(false)   -- 줄 공개 시 스크래치 루프 정지(결과음과 겹침 방지)
        local o = nil
        if self.optionLines ~= nil then o = self.optionLines[index] end
        local prizes = { self.prize1, self.prize2, self.prize3 }
        local pr = prizes[index]
        if o ~= nil and isvalid(pr) then
            if o.isDestroy then
                pr.ImageRUID = self.PrizeImgDestroy             -- 파괴
            elseif o.isValid and o.isBonus then
                pr.ImageRUID = self.PrizeImgBonus              -- 이탈
            elseif o.isValid then
                pr.ImageRUID = self.PrizeImgValid              -- 유효
            else
                pr.ImageRUID = self.PrizeImgDefault            -- 잡옵/비유효: Default 유지
            end
            pr.Color = Color(1, 1, 1, 1)                        -- 이미지 원색 표시(틴트 제거)
            if o.isValid then
                table.insert(self.rainbowLines, index)          -- 무지개 글씨 대상
            end
            -- 유효 옵션(장비에 유효한 옵션 — 일반 유효 + 유효 이탈)만 시소 강조.
            -- 비유효 이탈(예: 스태프+STR+12%, isValid=0/isBonus=1)은 제외.
            if o.isValid and not o.isDestroy then
                self:StartPrizeFX(index)
            end
            -- 이탈(제일 좋은 옵션)만 계속 반짝이는 별 이멧 시작 + 공개 순간 폭죽 1회.
            if o.isValid and o.isBonus and not o.isDestroy then
                self:StartPrizeStars(index)
                self:PlayFirework(index)
            end
        end
        self.revealedCount = self.revealedCount + 1
        log("[ScratchTicket] line " .. index .. " revealed (" .. self.revealedCount .. "/3)")

        -- 실시간 판매가: 공개된 줄의 옵션 보너스만큼 목표가 상승 + 타입별 차별 연출. (pricing §14)
        if o ~= nil then
            if o.isDestroy then
                -- 파괴: 카운트업 정지 + 판매가 자리에 "파괴" 빨강.
                self.priceFrozen = true
                self.priceScrollT = -1
                if isvalid(self.priceText) then
                    self.priceText.Text = "파괴"
                    self.priceText.FontColor = Color(0.95, 0.25, 0.22, 1.0)
                end
                -- 파괴 줄 글자도 빨강 + 흔들림으로 강조(무지개 대상 아님 → 위치 충돌 없음).
                local pl = { self.label1, self.label2, self.label3 }
                if isvalid(pl[index]) then pl[index].FontColor = Color(0.95, 0.25, 0.22, 1.0) end
                self:StartLabelFX(index, 1.2, 0, true)
                _SoundService:PlaySound(self.SfxOptionDestroy, 1)
                log("[ScratchTicket] price FROZEN (destroy line)")
            else
                o.revealed = true
                self.revealedBonusSum = self.revealedBonusSum + o.bonus
                self:StartPriceScroll(_GameManager.CurrentBasePrice + self.revealedBonusSum)
                self:PlayRevealFX(o)
                self:StartLabelReveal(index, o)
                log("[ScratchTicket] price target=" .. tostring(_GameManager.CurrentBasePrice + self.revealedBonusSum)
                    .. " (+" .. tostring(o.bonus) .. ", valid=" .. tostring(o.isValid)
                    .. ", bonus=" .. tostring(o.isBonus) .. ")")
            end
        end

        if o ~= nil and o.isDestroy then
            -- 파괴 줄 공개 즉시: 나머지 줄을 기다리지 않고 바로 흔들림 연출 → 메인메뉴 복귀. (cube_scratch_system §9)
            self:StartDestroySequence()
            return
        end
        if self.revealedCount >= 3 then
            self:OnAllRevealed()
        end
    end

    @ExecSpace("ClientOnly")
    method void PlayRevealFX(any o)
        -- 공개 결과별 판매가 상승 연출(잡옵/유효/이탈 차별화) + 델타 팝업 + 코인. 사운드는 PlayOptionSound가 담당.
        self:PlayOptionSound(o)
        if o.isValid and o.isBonus then
            -- 이탈: 보라 플래시 + 큰 펀치 + 다량 코인.
            self:FlashPrice(Color(0.72, 0.45, 1.0, 1.0), self.PricePunchScale)
            self:SpawnCoins(self.CoinCountBonus, true)
            self:ShowDelta(o.bonus, Color(0.82, 0.58, 1.0, 1.0))
        elseif o.isValid then
            -- 유효: 노랑 플래시 + 중간 펀치 + 소량 코인.
            self:FlashPrice(Color(1.0, 0.9, 0.35, 1.0), (self.PricePunchScale + 1.0) * 0.5)
            self:SpawnCoins(self.CoinCountValid, false)
            self:ShowDelta(o.bonus, Color(1.0, 0.88, 0.3, 1.0))
        else
            -- 잡옵/비유효: 소폭 상승, 회색 델타(코인 없음).
            self:FlashPrice(Color(0.75, 0.78, 0.85, 1.0), 1.06)
            self:ShowDelta(o.bonus, Color(0.72, 0.74, 0.8, 1.0))
        end
    end

    @ExecSpace("ClientOnly")
    method void PlayOptionSound(any o)
        -- 옵션 공개 결과음 5분기(soundlist.md). 파괴는 OnLineRevealed 별도 경로라 여기 도달 불가.
        --   이탈(공격계열=Legendary/스탯=SuperJackpot) > 유효(공격계열=Jackpot/스탯=Good) > 잡옵/비유효(Bad).
        local atk = (o.optionGroup == "Attack")
        if o.isValid and o.isBonus then
            _SoundService:PlaySound(atk and self.SfxOptionLegendary or self.SfxOptionSuperJackpot, 1)
        elseif o.isValid then
            _SoundService:PlaySound(atk and self.SfxOptionJackpot or self.SfxOptionGood, 1)
        else
            _SoundService:PlaySound(self.SfxOptionBad, 1)
        end
    end

    @ExecSpace("ClientOnly")
    method void StartDestroySequence()
        -- 파괴 확정: 흔들림 연출 시작(UpdateDestroy가 이어받아 ~1.2초 후 RequestConfirmDestroy→상점 복귀).
        if self.destroyPending then return end   -- 중복 트리거 방지
        self.destroyPending = true
        self.destroyTimer = 0
        self:SetButtonEnabled(self.sellButton, false)
        log("[ScratchTicket] destroy sequence started")
    end

    @ExecSpace("ClientOnly")
    method void OnAllRevealed()
        -- 3줄 공개 완료: 파괴면 즉시 복귀 연출, 아니면 별도 축하 피날레 없이
        -- 판매가만 최종값(등급·이탈 배수 반영)으로 조용히 확정 + 판매/재사용 활성.
        -- (per-line 줄별 공개 연출이 이미 각 줄에서 발동됨 → 중복 피날레 제거. 꽝은 마지막 잡옵 줄이 조용.)
        if _GameManager.IsCurrentDestroyed then
            -- 안전망: 조기 트리거를 놓친 경우에도 파괴 연출 보장.
            self:StartDestroySequence()
            log("[ScratchTicket] all revealed -> DESTROYED, auto-confirm pending")
            return
        end
        if isvalid(self.priceWindow) then self.priceWindow.Enable = true end
        -- 최종 판매가로 카운트업(서버 CurrentPrice가 SSOT — per-line 누적치엔 등급 배수가 없으므로 여기서 확정).
        self:StartPriceScroll(_GameManager.CurrentPrice)
        -- 3줄 공개 완료 → 좌측 구매창을 다시 슬라이드 아웃(노출). 큐브 아이콘 클릭으로 재굴림 가능.
        -- (5/5 상환 미납이면 SetCubeSelectShown 게이트가 노출을 막아 구매창이 안 나오고 판매만 가능.)
        self:SetCubeSelectShown(true, false)
        self:SetButtonEnabled(self.sellButton, true)
        log("[ScratchTicket] all revealed -> price=" .. tostring(_GameManager.CurrentPrice)
            .. " = " .. _GameManager.CurrentPriceFormula
            .. ", repayDue=" .. tostring(_GameManager.IsRepaymentDue))
    end

    @ExecSpace("ClientOnly")
    method void UpdateDestroy(number delta)
        -- 파괴 연출: board를 좌우로 흔들고 ~1.2초 후 서버에 파괴 확인 → 아이템 정리(상점 복귀).
        if not self.destroyPending then return end
        self.destroyTimer = self.destroyTimer + delta
        if isvalid(self.board) and isvalid(self.board.UITransformComponent) then
            local jx = (_UtilLogic:RandomDouble() - 0.5) * 24
            local p = self.board.UITransformComponent.anchoredPosition
            self.board.UITransformComponent.anchoredPosition = Vector2(self.boardBaseX + jx, p.y)
        end
        if self.destroyTimer >= 1.2 then
            self.destroyPending = false
            if isvalid(self.board) and isvalid(self.board.UITransformComponent) then
                local p = self.board.UITransformComponent.anchoredPosition
                self.board.UITransformComponent.anchoredPosition = Vector2(self.boardBaseX, p.y)
            end
            _GameManager:RequestConfirmDestroy()
        end
    end
    @ExecSpace("ClientOnly")
    method void UpdateHoverFX(number delta)
        -- 큐브 아이콘 호버 시 살짝 확대 + Z회전 진동(부들부들). 해제 시 원복.
        self.hoverTime = self.hoverTime + delta
        local wob = math.sin(self.hoverTime * 40) * 4   -- degrees
        local locked = _GameManager.IsRepaymentDue   -- 잠금 중엔 호버 연출도 끔(비활성 시각과 일치)
        self:ApplyHover(self.cubeIconWeird, self.hoverWeird and not locked, wob)
        self:ApplyHover(self.cubeIconMaster, self.hoverMaster and not locked, wob)
    end

    @ExecSpace("ClientOnly")
    method void ApplyHover(Entity e, boolean hovered, number wob)
        -- 단일 큐브 아이콘에 호버 연출 적용/해제.
        if not isvalid(e) or not isvalid(e.UITransformComponent) then return end
        local ui = e.UITransformComponent
        if hovered then
            ui.UIScale = Vector3(1.15, 1.15, 1)
            ui.UIRotation = Vector3(0, 0, wob)
        else
            ui.UIScale = Vector3(1, 1, 1)
            ui.UIRotation = Vector3(0, 0, 0)
        end
    end

    @ExecSpace("ClientOnly")
    method void UpdateRainbow(number delta)
        -- 공개된 유효옵션 줄의 글씨를 무지개색으로 순환 + Y로 출렁이게 한다.
        if self.rainbowLines == nil or #self.rainbowLines == 0 then return end
        self.rainbowTime = self.rainbowTime + delta
        local labels = { self.label1, self.label2, self.label3 }
        for _, idx in ipairs(self.rainbowLines) do
            local lab = labels[idx]
            if isvalid(lab) then
                local hue = (self.rainbowTime * 0.5 + idx * 0.2) % 1.0
                lab.FontColor = self:HsvColor(hue, 0.85, 1.0)
                if isvalid(lab.Entity) and isvalid(lab.Entity.UITransformComponent) then
                    local wy = math.sin(self.rainbowTime * 6 + idx) * 6
                    lab.Entity.UITransformComponent.anchoredPosition = Vector2(0, wy)
                end
            end
        end
    end

    @ExecSpace("ClientOnly")
    method void InitLabelFX()
        -- 옵션 라벨 3줄의 공개 팝 상태를 비활성으로 초기화.
        self.labelFX = {}
        for i = 1, 3 do
            self.labelFX[i] = { t = -1, peak = 1.0, wobble = 0, shake = false }
        end
    end

    @ExecSpace("ClientOnly")
    method void InitPrizeFX()
        -- Prize 박스 3줄의 긍정 공개 강조(시소) 상태를 비활성으로 초기화.
        self.prizeFX = {}
        for i = 1, 3 do
            self.prizeFX[i] = { t = -1, baseX = 0, baseY = 0 }
        end
    end

    @ExecSpace("ClientOnly")
    method void StartPrizeFX(integer index)
        -- 한 줄의 시소 강조 시작. 박스가 (0,0)이 아닐 수 있으므로 base 위치를 캡처해 그 기준으로 복귀한다.
        if self.prizeFX == nil then self:InitPrizeFX() end
        local fx = self.prizeFX[index]
        if fx == nil then return end
        fx.t = 0
        local prizes = { self.prize1, self.prize2, self.prize3 }
        local pr = prizes[index]
        if isvalid(pr) and isvalid(pr.Entity) and isvalid(pr.Entity.UITransformComponent) then
            local p = pr.Entity.UITransformComponent.anchoredPosition
            fx.baseX = p.x
            fx.baseY = p.y
        end
        log("[ScratchTicket] prize FX i=" .. tostring(index))
    end

    @ExecSpace("ClientOnly")
    method void UpdatePrizeFX(number delta)
        -- 활성 Prize 박스의 긍정 공개 강조: sin 펀치(살짝 확대) + 시소(중앙 고정 Z회전) + 좌우/위아래 sway,
        -- 감쇠 envelope(1-k)로 종료 시 base 위치/스케일로 원상복귀.
        if self.prizeFX == nil then return end
        local prizes = { self.prize1, self.prize2, self.prize3 }
        for i = 1, 3 do
            local fx = self.prizeFX[i]
            if fx ~= nil and fx.t >= 0 then
                fx.t = fx.t + delta
                local dur = self.PrizePunchTime
                local k = 1.0
                if dur > 0 then k = fx.t / dur end
                local pr = prizes[i]
                if isvalid(pr) and isvalid(pr.Entity) and isvalid(pr.Entity.UITransformComponent) then
                    local ui = pr.Entity.UITransformComponent
                    if k >= 1.0 then
                        fx.t = -1
                        ui.UIScale = Vector3(1, 1, 1)
                        ui.UIRotation = Vector3(0, 0, 0)
                        ui.anchoredPosition = Vector2(fx.baseX, fx.baseY)
                    else
                        local env = (1 - k)
                        local s = 1 + (self.PrizePunchScale - 1) * math.sin(k * math.pi)
                        ui.UIScale = Vector3(s, s, 1)
                        ui.UIRotation = Vector3(0, 0, self.PrizeSeesawDeg * math.sin(k * math.pi * 3) * env)
                        ui.anchoredPosition = Vector2(
                            fx.baseX + self.PrizeSwayX * math.sin(k * math.pi * 3) * env,
                            fx.baseY + self.PrizeSwayY * math.sin(k * math.pi * 4) * env)
                    end
                end
            end
        end
    end

    @ExecSpace("ClientOnly")
    method void StartLabelFX(integer index, number peak, number wobbleDeg, boolean shake)
        -- 한 줄의 공개 팝 연출 시작(스케일 펀치 + 선택적 회전 흔들림/파괴 지터).
        if self.labelFX == nil then self:InitLabelFX() end
        local fx = self.labelFX[index]
        if fx == nil then return end
        fx.t = 0
        fx.peak = peak
        fx.wobble = wobbleDeg
        fx.shake = shake
        log("[ScratchTicket] label FX i=" .. tostring(index) .. " peak=" .. tostring(peak)
            .. " wobble=" .. tostring(wobbleDeg) .. " shake=" .. tostring(shake))
    end

    @ExecSpace("ClientOnly")
    method void StartLabelReveal(integer index, any o)
        -- 공개 타입별 라벨 팝 강도 매핑: 이탈>유효>잡옵. (파괴는 별도 처리)
        if o.isValid and o.isBonus then
            self:StartLabelFX(index, self.LabelPunchBonus, self.LabelWobbleDeg, false)
        elseif o.isValid then
            self:StartLabelFX(index, self.LabelPunchValid, 0, false)
        else
            self:StartLabelFX(index, self.LabelPunchJunk, 0, false)
        end
    end

    @ExecSpace("ClientOnly")
    method void UpdateLabelFX(number delta)
        -- 활성 라벨의 공개 팝을 sin 대칭으로 보간(스케일/회전/파괴 지터), 종료 시 원복.
        if self.labelFX == nil then return end
        local labels = { self.label1, self.label2, self.label3 }
        for i = 1, 3 do
            local fx = self.labelFX[i]
            if fx ~= nil and fx.t >= 0 then
                fx.t = fx.t + delta
                local dur = self.LabelPunchTime
                local k = 1.0
                if dur > 0 then k = fx.t / dur end
                local lab = labels[i]
                if k >= 1.0 then
                    fx.t = -1
                    if isvalid(lab) and isvalid(lab.Entity) and isvalid(lab.Entity.UITransformComponent) then
                        local ui = lab.Entity.UITransformComponent
                        ui.UIScale = Vector3(1, 1, 1)
                        ui.UIRotation = Vector3(0, 0, 0)
                        if fx.shake then ui.anchoredPosition = Vector2(0, 0) end
                    end
                elseif isvalid(lab) and isvalid(lab.Entity) and isvalid(lab.Entity.UITransformComponent) then
                    local ui = lab.Entity.UITransformComponent
                    local s = 1 + (fx.peak - 1) * math.sin(k * math.pi)
                    ui.UIScale = Vector3(s, s, 1)
                    if fx.wobble ~= 0 then
                        ui.UIRotation = Vector3(0, 0, fx.wobble * math.sin(k * math.pi * 3) * (1 - k))
                    end
                    if fx.shake then
                        local jx = (_UtilLogic:RandomDouble() - 0.5) * 2 * self.LabelShakeAmp
                        ui.anchoredPosition = Vector2(jx, 0)
                    end
                end
            end
        end
    end

    @ExecSpace("ClientOnly")
    method any HsvColor(number h, number s, number v)
        -- HSV(0~1) → Color. 무지개 글씨용.
        local i = math.floor(h * 6)
        local f = h * 6 - i
        local p = v * (1 - s)
        local q = v * (1 - f * s)
        local t = v * (1 - (1 - f) * s)
        local m = i % 6
        local r, g, b = v, t, p
        if m == 1 then r, g, b = q, v, p
        elseif m == 2 then r, g, b = p, v, t
        elseif m == 3 then r, g, b = p, q, v
        elseif m == 4 then r, g, b = t, p, v
        elseif m == 5 then r, g, b = v, p, q end
        return Color(r, g, b, 1)
    end

    @ExecSpace("ClientOnly")
    method void RefreshCubeLock()
        -- 5/5(상환 미납) 잠금 적용: 큐브 구매창 자체를 숨긴다(판매만 가능). 안쪽 버튼 dim은 슬라이드-아웃 짧은 순간의 방어.
        -- 해제 시 큐브 버튼 복원(구매창 재노출은 상태 흐름이 처리 — 여기선 dim만 되돌림).
        local locked = _GameManager.IsRepaymentDue
        self:SetButtonEnabled(self.cubeIconWeird, not locked)
        self:SetButtonEnabled(self.cubeIconMaster, not locked)
        self:SetButtonEnabled(self.weirdBuyButton, not locked)
        self:SetButtonEnabled(self.masterBuyButton, not locked)
        if locked then
            -- 구매창을 보드 뒤로 슬라이드시켜 완전히 숨김(에지에서 이미 노출돼 있던 경우 대비). SetCubeSelectShown 게이트와 정합.
            self:SetCubeSelectShown(false, false)
            log("[ScratchTicket] 5/5 repayment due -> cube panel hidden (sell only)")
        end
    end

    @ExecSpace("ClientOnly")
    method void OnUseWeird()
        -- 이상한 큐브 사용 요청.
        self:UseCube("weird")
    end

    @ExecSpace("ClientOnly")
    method void OnUseMaster()
        -- 장인의 큐브 사용 요청.
        self:UseCube("master")
    end

    @ExecSpace("ClientOnly")
    method void UseCube(string cubeType)
        -- 서버에 큐브 사용 요청(서버가 비용/파괴/판정 확정). 결과는 @Sync로 내려와 SetupScratch가 처리.
        -- 5/5(상환 미납) 상태면 클라에서도 차단(서버도 거부하지만 UX상 즉시 차단).
        if _GameManager.IsRepaymentDue then
            log("[ScratchTicket] cube blocked: repayment due (sell only)")
            return
        end
        -- 구매 요청~연출(복권 낙하 + 구매창 슬라이드아웃) 재생 중에는 재클릭을 차단(중복 구매 방지).
        if self.cubePurchasePending then
            log("[ScratchTicket] cube blocked: purchase/reveal animation in progress")
            return
        end
        self.cubePurchasePending = true
        self.cubePendingTimer = 0
        self.lastCubeType = cubeType
        _SoundService:PlaySound(self.SfxClickDefault, 1)   -- 큐브 사용 클릭음(가드 통과 후)
        log("[ScratchTicket] request use cube: " .. cubeType)
        _GameManager:RequestUseCube(cubeType)
    end

    @ExecSpace("ClientOnly")
    method void OnSellClicked()
        -- 판매 클릭: 판매 버튼은 큐브 사용 후(잠재 보유, OnAllRevealed)에만 활성화되므로 바로 판매 요청.
        -- 큐브 미사용 판매(기본가/확인 팝업)는 폐지 — 대기 상태에선 버튼이 비활성이라 도달하지 않는다.
        if not _GameManager.HasPotential then
            log("[ScratchTicket] sell ignored: no cube used (button should be disabled)")
            return
        end
        -- 판매 확정 요청(서버는 즉시 지급하지 않고 IsSalePending으로 전환 → 결과 창 표시). 중복 클릭 방지.
        _SoundService:PlaySound(self.SfxClickConfirm, 1)   -- 판매 확정음(결과음 Sale_*는 결과 창에서 뒤이어 재생)
        log("[ScratchTicket] request sell (with potential)")
        _GameManager:RequestSellItem()
        self:SetButtonEnabled(self.sellButton, false)
    end

    @ExecSpace("ClientOnly")
    method void OnCollectClicked()
        -- 수령하기: 서버에 판매 수령 요청(메소 지급 + 아이템 정리). 이후 isActive 게이팅이 UI를 닫고 상점 복귀.
        if not _GameManager.IsSalePending then
            log("[ScratchTicket] collect ignored: no pending sale")
            return
        end
        _SoundService:PlaySound(self.SfxClickDefault, 1)   -- 수령 클릭음
        log("[ScratchTicket] request collect sale")
        _GameManager:RequestCollectSale()
    end

    @ExecSpace("ClientOnly")
    method void ShowSaleResult()
        -- 판매 확정(수령 대기) → 결과 창 표시(무기 아이콘 + 판매가). 모달: 긁기/버튼 차단.
        self.saleShown = true
        self.scratchReady = false
        -- 판매 결과음: 유효 옵션 개수(0/1/2/3) → Low/Normal/High/Jackpot. optionLines는 수령 전까지 유지됨.
        local validCount = 0
        if self.optionLines ~= nil then
            for i = 1, 3 do
                local ol = self.optionLines[i]
                if ol ~= nil and ol.isValid then validCount = validCount + 1 end
            end
        end
        local saleSfx = self.SfxSaleLow
        if validCount >= 3 then saleSfx = self.SfxSaleJackpot
        elseif validCount == 2 then saleSfx = self.SfxSaleHigh
        elseif validCount == 1 then saleSfx = self.SfxSaleNormal end
        _SoundService:PlaySound(saleSfx, 1)
        log("[ScratchTicket] sale sfx: validCount=" .. validCount)
        local eq = _BlacksmithConfig:GetEquipment(_GameManager.PendingSaleItemId)
        if eq ~= nil and isvalid(self.saleWeaponIcon) then
            local spr = self.saleWeaponIcon.SpriteGUIRendererComponent
            -- 등급별 아이콘: 판매 확정 시점에도 CurrentWeaponGrade 유효(수령 전까지 유지). GetWeaponIcon SSOT.
            if isvalid(spr) then spr.ImageRUID = "thumbnail://" .. _BlacksmithConfig:GetWeaponIcon(_GameManager.PendingSaleItemId, _GameManager.CurrentWeaponGrade) end
        end
        if isvalid(self.saleSoldText) then
            self.saleSoldText.Text = self:Comma(_GameManager.PendingSalePrice) .. " 메소에\n판매되었습니다!"
        end
        if isvalid(self.saleResultGroup) then self.saleResultGroup.Enable = true end
        log("[ScratchTicket] sale result shown: item=" .. _GameManager.PendingSaleItemId
            .. " price=" .. tostring(_GameManager.PendingSalePrice))
    end

    @ExecSpace("ClientOnly")
    method void HideSaleResult()
        -- 판매 결과 창 숨김.
        self.saleShown = false
        if isvalid(self.saleResultGroup) then self.saleResultGroup.Enable = false end
    end

    @ExecSpace("ClientOnly")
    method void ShowConfirmSell()
        -- 큐브 미사용 판매 확인 팝업 표시 + 기본 판매가 안내 메시지.
        if isvalid(self.confirmMsgText) then
            self.confirmMsgText.Text = "큐브를 사용하지 않았습니다.\n기본 판매가 "
                .. self:Comma(_GameManager.CurrentBasePrice) .. " 메소로 판매할까요?"
        end
        if isvalid(self.confirmSellGroup) then self.confirmSellGroup.Enable = true end
    end

    @ExecSpace("ClientOnly")
    method void HideConfirmSell()
        -- 확인 팝업 숨김.
        if isvalid(self.confirmSellGroup) then self.confirmSellGroup.Enable = false end
    end

    @ExecSpace("ClientOnly")
    method void OnConfirmSellYes()
        -- 확인: 팝업 닫고 서버에 판매 요청(서버가 큐브 미사용 → 기본가로 처리). 이후 상점 복귀(가시성 자동).
        self:HideConfirmSell()
        log("[ScratchTicket] request sell (base price, no cube)")
        _GameManager:RequestSellItem()
    end

    @ExecSpace("ClientOnly")
    method void OnConfirmSellNo()
        -- 취소: 팝업만 닫고 현재 상태 유지.
        self:HideConfirmSell()
    end

    @ExecSpace("ClientOnly")
    method void SetButtonEnabled(Entity e, boolean enabled)
        -- 버튼 활성/비활성(클릭 차단 + 알파 흐리게).
        --   ⚠ 저작 알파(buttonBaseAlpha) 기준으로 조정한다 — 투명 배경(알파 0)은 계속 투명 유지(흰색으로 덮지 않음).
        if not isvalid(e) then return end
        local btn = e.ButtonComponent
        if isvalid(btn) then btn.Enable = enabled end
        local spr = e.SpriteGUIRendererComponent
        if isvalid(spr) then
            local base = (self.buttonBaseAlpha ~= nil and self.buttonBaseAlpha[e]) or 1.0
            local c = spr.Color
            spr.Color = Color(c.r, c.g, c.b, enabled and base or (base * 0.35))
        end
        -- 라벨 글자/외곽선도 배경과 동일 배수(×0.35)로 흐리게 → 비활성 시 버튼 전체가 하나로 페이드.
        --   (외곽선까지 낮춰야 알파만 낮춘 글자가 검은 외곽선만 남는 부작용을 막는다.)
        local txt = e.TextComponent
        if isvalid(txt) then
            local fbase = (self.buttonBaseFontAlpha ~= nil and self.buttonBaseFontAlpha[e]) or 1.0
            local fc = txt.FontColor
            txt.FontColor = Color(fc.r, fc.g, fc.b, enabled and fbase or (fbase * 0.35))
            local obase = (self.buttonBaseOutlineAlpha ~= nil and self.buttonBaseOutlineAlpha[e]) or 1.0
            local oc = txt.OutlineColor
            txt.OutlineColor = Color(oc.r, oc.g, oc.b, enabled and obase or (obase * 0.35))
        end
    end

    @ExecSpace("ClientOnly")
    method void OnWeirdEnter(UITouchEnterEvent event)
        -- 이상한 큐브 호버 시작.
        self.hoverWeird = true
    end

    @ExecSpace("ClientOnly")
    method void OnWeirdExit(UITouchExitEvent event)
        -- 이상한 큐브 호버 종료.
        self.hoverWeird = false
    end

    @ExecSpace("ClientOnly")
    method void OnMasterEnter(UITouchEnterEvent event)
        -- 장인의 큐브 호버 시작.
        self.hoverMaster = true
    end

    @ExecSpace("ClientOnly")
    method void OnMasterExit(UITouchExitEvent event)
        -- 장인의 큐브 호버 종료.
        self.hoverMaster = false
    end

    @ExecSpace("ClientOnly")
    method boolean IsCursorOverFoil()
        -- 마우스 커서가 은박 3장 중 하나 위에 있는지 폴링 판정.
        --   ⚠ 은박(Foil)은 PixelGUIRenderer만 있어 UI 레이캐스트 대상이 아니다 → UITouchEnter/Exit가 안 온다.
        --   그래서 Scratch()와 동일한 좌표변환(스크린→월드 + foil 사각형 정규화)으로 직접 히트테스트한다.
        if self.tickets == nil then return false end
        local cursorPt = _InputService:GetCursorPosition()
        local worldPt = _UILogic:ScreenToWorldPosition(cursorPt)
        for i = 1, #self.tickets do
            local t = self.tickets[i]
            if t ~= nil and isvalid(t.ui) then
                local ui = t.ui
                local rs = ui.RectSize
                local bl = _UILogic:LocalUIToWorldPosition(Vector2(-rs.x * 0.5, -rs.y * 0.5), ui)
                local tr = _UILogic:LocalUIToWorldPosition(Vector2(rs.x * 0.5, rs.y * 0.5), ui)
                local w = tr.x - bl.x
                local h = tr.y - bl.y
                if w ~= 0 and h ~= 0 then
                    local u = (worldPt.x - bl.x) / w
                    local v = (worldPt.y - bl.y) / h
                    if u >= 0 and u <= 1 and v >= 0 and v <= 1 then return true end
                end
            end
        end
        return false
    end

    @ExecSpace("ClientOnly")
    method void UpdateCursor(number delta)
        -- 은박 커서 상태머신: 은박 밖=기본 / 은박 위 hover=금색 코인 / 누르고 긁는 중=동색 코인.
        --   hover 판정은 커서 위치 폴링(IsCursorOverFoil) — 은박이 레이캐스트 대상이 아니라 이벤트가 안 오기 때문.
        --   긁는 중 판정은 scratchTimer(>0)로 추론(은박은 release 이벤트가 없어 OnTouchHold가 매 프레임 갱신).
        --   scratchReady일 때만(낙하 완료·긁기 가능 상태) 코인 커서를 노출한다.
        if self.scratchTimer > 0 then self.scratchTimer = self.scratchTimer - delta end
        -- 긁는 중(scratchReady + timer>0)이면 루프음, 아니면 정지. 손 뗌·완료·판매모달·재굴림·대기복귀 전부 여기 falling edge가 커버.
        self:SetScratchLoop(self.scratchReady and self.scratchTimer > 0)
        local target = ""
        if self.scratchReady and self:IsCursorOverFoil() then
            if self.scratchTimer > 0 then target = "copper" else target = "gold" end
        end
        self:ApplyCursor(target)
    end

    @ExecSpace("ClientOnly")
    method void SetScratchLoop(boolean on)
        -- 스크래치 루프음 시작/정지(플래그 디듀프 — PlayLoopSound 중첩 방지). 정지는 StopSound로 전 인스턴스 소거.
        if on == self.scratchLoopOn then return end
        self.scratchLoopOn = on
        if on then
            _SoundService:PlayLoopSound(self.SfxScratchLoop, self.SfxScratchLoopVolume)
        else
            _SoundService:StopSound(self.SfxScratchLoop)
        end
    end

    @ExecSpace("ClientOnly")
    method void ApplyCursor(string kind)
        -- 커서 적용(디듀프 — 상태 변화 시에만 호출). RUID가 비어 있으면 기본 커서로 폴백(사용자 미입력 대비).
        if kind == self.cursorNow then return end
        self.cursorNow = kind
        local ruid = ""
        if kind == "gold" then
            ruid = self.CursorGoldRUID
        elseif kind == "copper" then
            ruid = self.CursorCopperRUID
        end
        if ruid ~= "" then
            _InputService:SetCursor(ruid, self.CursorHotspot)
        else
            _InputService:ResetCursor()
        end
        log("[ScratchTicket] cursor -> " .. (kind == "" and "default" or kind) .. " ruid=" .. tostring(ruid))
    end

    method string FormatOption(any o)
        -- 옵션 한 줄 표시 문자열. (이탈 여부는 글자 대신 보라색·무지개 연출로만 표현)
        if o.isDestroy then return "파괴" end
        return o.label .. " +" .. tostring(o.value) .. o.unit
    end

    method any Split(string s, string sep)
        -- 구분자로 문자열 분할(빈 토큰 보존). 직렬화 파싱용.
        local out = {}
        local start = 1
        local sepLen = #sep
        while true do
            local i = string.find(s, sep, start, true)
            if i == nil then
                table.insert(out, string.sub(s, start))
                break
            end
            table.insert(out, string.sub(s, start, i - 1))
            start = i + sepLen
        end
        return out
    end

    method string Comma(integer n)
        -- 천 단위 콤마.
        local sg = ""
        if n < 0 then sg = "-" n = -n end
        local s = tostring(n)
        local out = ""
        local cnt = 0
        for i = #s, 1, -1 do
            out = string.sub(s, i, i) .. out
            cnt = cnt + 1
            if cnt % 3 == 0 and i > 1 then out = "," .. out end
        end
        return sg .. out
    end

    @ExecSpace("ClientOnly")
    method void OnEndPlay()
        -- 입력/버튼/호버 구독 해제(필수).
        if self.touchHandler then _InputService:DisconnectEvent(ScreenTouchEvent, self.touchHandler) end
        if self.holdHandler then _InputService:DisconnectEvent(ScreenTouchHoldEvent, self.holdHandler) end
        _SoundService:StopSound(self.SfxScratchLoop)   -- 스크래치 루프음 안전망 정지(플래그 무시).
        _InputService:ResetCursor()   -- 커서가 코인 상태로 남지 않도록 기본 복원.
        if self.clickRecords ~= nil then
            for _, rec in ipairs(self.clickRecords) do
                if isvalid(rec.entity) then rec.entity:DisconnectEvent(ButtonClickEvent, rec.eventHandler) end
            end
        end
        if self.enterRecords ~= nil then
            for _, rec in ipairs(self.enterRecords) do
                if isvalid(rec.entity) then
                    rec.entity:DisconnectEvent(UITouchEnterEvent, rec.enterH)
                    rec.entity:DisconnectEvent(UITouchExitEvent, rec.exitH)
                end
            end
        end
        if self.crumbs ~= nil then
            for i = 1, #self.crumbs do
                local rec = self.crumbs[i]
                rec.active = false
                if isvalid(rec.entity) then rec.entity.Enable = false end
            end
        end
        if self.coins ~= nil then
            for i = 1, #self.coins do
                local rec = self.coins[i]
                rec.active = false
                if isvalid(rec.entity) then rec.entity.Enable = false end
            end
        end
    end
end
